      <Id>OT-S13</Id>
      <ShortTitle>Dormant, orphaned or unrevoked accounts on {target.Name}</ShortTitle>
      <Category>S</Category>
      <Description>Accounts of former staff, contractors, commissioning engineers or test users may remain active on {target.Name} and can be used by an attacker who obtains their credentials.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Accounts of former staff, contractors, commissioning engineers or test users may remain active on {target.Name} and can be used by an attacker who obtains their credentials.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
