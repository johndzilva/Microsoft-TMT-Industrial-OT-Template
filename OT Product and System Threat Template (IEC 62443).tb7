      <Id>OT-S02</Id>
      <ShortTitle>Rogue master or rogue device on the fieldbus to {target.Name}</ShortTitle>
      <Category>S</Category>
      <Description>A device connected to the fieldbus or serial link could act as a rogue master or slave, sending commands to or impersonating devices that {target.Name} trusts.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
