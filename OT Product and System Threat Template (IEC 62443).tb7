      <Id>OT-S12</Id>
      <ShortTitle>Code-signing key for software delivered via {target.Name} stolen or misused</ShortTitle>
      <Category>S</Category>
      <Description>If the supplier's firmware or software signing key is stolen, or the signing service can be used by an unauthorised person, malicious images would pass every signature check on the devices that {target.Name} serves.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>If the supplier's firmware or software signing key is stolen, or the signing service can be used by an unauthorised person, malicious images would pass every signature check on the devices that {target.Name} serves.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Keep signing keys in an HSM with dual control and logging (4-1 SM-8). Use separate keys for test and production. Plan key revocation and rotation, and let devices accept a new trust anchor securely (CR 1.9, EDR 3.10). Monitor signing activity.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>IEC 62443-4-1 Practice</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SM - Security management and supply chain</Value>
          </Values>
          <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T0862 Supply Chain Compromise; T1693.001 Modify Firmware: System Firmware</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>IEC62443Req</Name>
          <Label>IEC 62443 Requirement(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>4-2 CR 1.9; 4-2 CR 3.4; 4-2 EDR 3.10; 4-1 SM-8</Value>
          </Values>
          <Description>IEC 62443-4-2 CR / 3-3 SR / 4-1 practice references. The first one belongs to the stated FR.</Description>
          <Id>IEC62443Req</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
