      <Id>OT-I15</Id>
      <ShortTitle>Process state and I/O image read from {target.Name} by an unauthorised client</ShortTitle>
      <Category>I</Category>
      <Description>{target.Name} answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>{target.Name} answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Medium</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Require authentication and authorisation for read services as well as writes where the protocol allows (CR 2.1). Allow-list client addresses. Expose only required tags. Detect unexpected polling clients at the conduit or with network monitoring (CR 6.2).</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>IEC 62443-4-1 Practice</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SD - Secure by design</Value>
          </Values>
          <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
