  </StandardElements>
  <ThreatCategories>
    <ThreatCategory>
      <Name>Spoofing</Name>
      <Id>S</Id>
      <ShortDescription>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Tampering</Name>
      <Id>T</Id>
      <ShortDescription>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Repudiation</Name>
      <Id>R</Id>
      <ShortDescription>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Information Disclosure</Name>
      <Id>I</Id>
      <ShortDescription>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Denial Of Service</Name>
      <Id>D</Id>
      <ShortDescription>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Elevation Of Privilege</Name>
      <Id>E</Id>
      <ShortDescription>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Abuse</Name>
      <Id>A</Id>
      <ShortDescription>Abuse is when a legitimate user violates the terms of use for the system without violating a system security policy.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
  </ThreatCategories>
  <ThreatTypes>
    <ThreatType>
      <GenerationFilters>
        <Include>(flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B')</Include>
        <Exclude>flow.GenerateThreats is 'No'</Exclude>
      </GenerationFilters>
      <Id>OT-S01</Id>
      <ShortTitle>Spoofing of {source.Name} across a zone / trust boundary</ShortTitle>
      <Category>S</Category>
      <Description>An attacker on the network path could impersonate {source.Name} and send traffic that {target.Name} accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>An attacker on the network path could impersonate {source.Name} and send traffic that {target.Name} accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>IEC 62443-4-1 Practice</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SD - Secure by design</Value>
          </Values>
          <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T0849 Masquerading; T0848 Rogue Master</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>IEC62443Req</Name>
          <Label>IEC 62443 Requirement(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</Value>
          </Values>
          <Description>IEC 62443-4-2 CR / 3-3 SR / 4-1 practice references. The first one belongs to the stated FR.</Description>
          <Id>IEC62443Req</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>FoundationalReq</Name>
          <Label>IEC 62443 Foundational Requirement</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>FR1 Identification and authentication control</Value>
          </Values>
          <Description>IEC 62443 foundational requirement (FR1-FR7).</Description>
          <Id>FoundationalReq</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
