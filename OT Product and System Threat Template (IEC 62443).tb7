      <Id>OT-I05</Id>
      <ShortTitle>Extraction of keys or credentials from {target.Name}</ShortTitle>
      <Category>I</Category>
      <Description>Keys, certificates or passwords stored on {target.Name} could be read from flash or memory, letting an attacker impersonate the device or decrypt traffic from many devices.</Description>
      <PropertiesMetaData>
