      <Id>OT-T03</Id>
      <ShortTitle>Unauthorized program / logic download to {target.Name}</ShortTitle>
      <Category>T</Category>
      <Description>An attacker with network access could download modified control logic or tasking to {target.Name}, changing how it controls the process (e.g. Stuxnet, TRITON).</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>An attacker with network access could download modified control logic or tasking to {target.Name}, changing how it controls the process (e.g. Stuxnet, TRITON).</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Require authentication and authorisation for program download, online edits and forcing (CR 2.1). Support a physical or logical write-protect / run-lock. Sign or integrity-check project files (CR 3.4). Log and alarm on every logic change.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
