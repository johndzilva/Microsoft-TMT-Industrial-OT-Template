          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Treat the safety channel as needing security: isolate it in the safety zone, block access from other zones, and add cryptographic protection where the protocol supports it. Include deliberate attacks in the safety/security co-engineering analysis.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
