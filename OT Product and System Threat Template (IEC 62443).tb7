          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Firmware for {target.Name} could be replaced with a modified image that hides malicious behaviour or bricks the device.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
