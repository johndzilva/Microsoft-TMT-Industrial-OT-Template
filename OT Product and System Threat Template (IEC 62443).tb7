      <Id>OT-R01</Id>
      <ShortTitle>Security-relevant actions on {target.Name} not audited</ShortTitle>
      <Category>R</Category>
      <Description>Requests that reach {target.Name} from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
