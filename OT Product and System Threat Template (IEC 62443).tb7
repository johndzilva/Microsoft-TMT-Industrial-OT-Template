      <Id>OT-D01</Id>
      <ShortTitle>Network flooding of {target.Name} from another zone</ShortTitle>
      <Category>D</Category>
      <Description>{target.Name} receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>{target.Name} receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Medium</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>IEC 62443-4-1 Practice</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SVV - Security verification and validation</Value>
          </Values>
          <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T0814 Denial of Service; T0826 Loss of Availability</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
