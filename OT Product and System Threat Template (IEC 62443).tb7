        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
