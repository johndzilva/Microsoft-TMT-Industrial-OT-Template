      <Id>OT-R07</Id>
      <ShortTitle>Operator actions by {source.Name} on {target.Name} not journaled</ShortTitle>
      <Category>R</Category>
      <Description>Commands, setpoint changes, alarm acknowledgements and shelving done by {source.Name} on {target.Name} may not be recorded with user, old and new value and time, so a disputed or harmful operation cannot be reconstructed.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Commands, setpoint changes, alarm acknowledgements and shelving done by {source.Name} on {target.Name} may not be recorded with user, old and new value and time, so a disputed or harmful operation cannot be reconstructed.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Medium</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Keep an operator action journal with user identity, old/new value, source station and synchronised time (CR 2.8, CR 2.11). Protect the journal from modification (CR 3.9). Make it available to incident response and the historian.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
