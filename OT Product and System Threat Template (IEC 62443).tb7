      <Id>OT-T10</Id>
      <ShortTitle>Unauthorized modification of safety logic or configuration on {target.Name}</ShortTitle>
      <Category>T</Category>
      <Description>An attacker could change safety logic, trip points or configuration on {target.Name}, so a hazardous event is not prevented (e.g. TRITON/TRISIS).</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>An attacker could change safety logic, trip points or configuration on {target.Name}, so a hazardous event is not prevented (e.g. TRITON/TRISIS).</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Require authorisation plus a physical key / local confirmation for safety program changes. Verify logic signatures. Keep the SIS engineering workstation in the safety zone and offline when not in use. Perform the SIS security risk assessment required by IEC 61511-1 clause 8.2.4.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>IEC 62443-4-1 Practice</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SD - Secure by design</Value>
          </Values>
          <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
