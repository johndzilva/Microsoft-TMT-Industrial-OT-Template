      <Id>OT-T01</Id>
      <ShortTitle>Adversary-in-the-middle tampering of {source.Name} to {target.Name} traffic</ShortTitle>
      <Category>T</Category>
      <Description>Traffic between {source.Name} and {target.Name} crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
