          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Commands, setpoints or logic sent to {target.Name} are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
