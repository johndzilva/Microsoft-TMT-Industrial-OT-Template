      <Id>OT-T28</Id>
      <ShortTitle>Malicious code inserted into {target.Name} during development or build</ShortTitle>
      <Category>T</Category>
      <Description>A compromised developer account, source repository, build server or dependency could insert a backdoor into {target.Name} before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into {target.Name} before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>IEC 62443-4-1 Practice</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SM - Security management and supply chain</Value>
          </Values>
          <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T0862 Supply Chain Compromise</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>IEC62443Req</Name>
          <Label>IEC 62443 Requirement(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</Value>
          </Values>
          <Description>IEC 62443-4-2 CR / 3-3 SR / 4-1 practice references. The first one belongs to the stated FR.</Description>
