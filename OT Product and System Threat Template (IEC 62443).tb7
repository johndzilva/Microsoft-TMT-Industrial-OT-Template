          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
          <AttributeType>0</AttributeType>
