        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Place safety functions in a separate zone. Allow only read-only or tightly controlled write flows from the BPCS. Use a dedicated conduit device with protocol filtering. Keep safety and non-safety functions independent (IEC 61511 layers of protection).</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
