      <Id>OT-I01</Id>
      <ShortTitle>Sniffing of operational data between {source.Name} and {target.Name}</ShortTitle>
      <Category>I</Category>
      <Description>Traffic between {source.Name} and {target.Name} is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
