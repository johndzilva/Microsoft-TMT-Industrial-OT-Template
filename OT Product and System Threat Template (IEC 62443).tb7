          </Values>
          <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T0869.002 Standard Application Layer Protocol: Publish/Subscribe Protocols; T1692.001 Unauthorized Message: Command Message; T1692.002 Unauthorized Message: Reporting Message</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
