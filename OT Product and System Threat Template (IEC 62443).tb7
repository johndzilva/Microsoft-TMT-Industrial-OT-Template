        <Name>SDLPhase</Name>
        <Label>IEC 62443-4-1 Practice</Label>
        <HideFromUI>false</HideFromUI>
        <Values>
          <Value>SR - Security requirements</Value>
          <Value>SD - Secure by design</Value>
          <Value>SI - Secure implementation</Value>
          <Value>SVV - Security verification and validation</Value>
          <Value>DM - Security defect management</Value>
          <Value>SUM - Security update management</Value>
          <Value>SG - Security guidelines</Value>
          <Value>SM - Security management and supply chain</Value>
        </Values>
        <Description>IEC 62443-4-1 secure development practice that addresses this threat.</Description>
        <Id>SDLPhase</Id>
