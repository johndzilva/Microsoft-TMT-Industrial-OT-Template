      <Id>OT-R02</Id>
      <ShortTitle>Actions by {source.Name} on {target.Name} cannot be attributed</ShortTitle>
      <Category>R</Category>
      <Description>If {source.Name} uses shared or generic accounts on {target.Name}, actions cannot be traced to an individual.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
