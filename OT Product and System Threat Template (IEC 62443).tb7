      <Id>OT-T02</Id>
      <ShortTitle>Replay or injection of control commands to {target.Name}</ShortTitle>
      <Category>T</Category>
      <Description>Commands, setpoints or logic sent to {target.Name} are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
