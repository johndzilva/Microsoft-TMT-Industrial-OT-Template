        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Accept only firmware signed by the product supplier and verify the signature on the device before install (CR 3.4, EDR 3.10). Prevent rollback to vulnerable versions. Require authorisation to start firmware update mode.</Value>
          </Values>
          <Description>Recommended controls for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
