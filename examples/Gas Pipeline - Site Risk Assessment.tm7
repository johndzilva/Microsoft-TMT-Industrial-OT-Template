i:type="b:HeaderDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Internet or Untrusted Network Boundary</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType><a:anyType i:type="b:StringDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Name</b:DisplayName><b:Name/><b:Value i:type="c:string" xmlns:c="http://www.w3.org/2001/XMLSchema">Internet - vendor access</b:Value></a:anyType><a:anyType i:type="b:HeaderDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Configurable Attributes</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType><a:anyType i:type="b:HeaderDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>As Generic Trust Line Boundary</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType></Properties><TypeId xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">SE.TB.L.OT.Internet</TypeId><HandleX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">243</HandleX><HandleY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">533</HandleY><PortSource xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">None</PortSource><PortTarget xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">None</PortTarget><SourceGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">00000000-0000-0000-0000-000000000000</SourceGuid><SourceX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">113</SourceX><SourceY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">342</SourceY><TargetGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">00000000-0000-0000-0000-000000000000</TargetGuid><TargetX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">280</TargetX><TargetY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">770</TargetY></a:Value></a:KeyValueOfguidanyType><a:KeyValueOfguidanyType><a:Key>2e36a722-a020-58c9-9231-68735c965aed</a:Key><a:Value z:Id="i47" i:type="LineBoundary"><GenericTypeId xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">GE.TB.L</GenericTypeId><Guid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">2e36a722-a020-58c9-9231-68735c965aed</Guid><Properties xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts"><a:anyType i:type="b:HeaderDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Internet or Untrusted Network Boundary</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType><a:anyType i:type="b:StringDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Name</b:DisplayName><b:Name/><b:Value i:type="c:string" xmlns:c="http://www.w3.org/2001/XMLSchema">Carrier network to remote sites</b:Value></a:anyType><a:anyType i:type="b:HeaderDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Configurable Attributes</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType><a:anyType i:type="b:HeaderDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>As Generic Trust Line Boundary</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType></Properties><TypeId xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">SE.TB.L.OT.Internet</TypeId><HandleX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1102</HandleX><HandleY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">435</HandleY><PortSource xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">None</PortSource><PortTarget xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">None</PortTarget><SourceGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">00000000-0000-0000-0000-000000000000</SourceGuid><SourceX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1103</SourceX><SourceY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">10</SourceY><TargetGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">00000000-0000-0000-0000-000000000000</TargetGuid><TargetX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1094</TargetX><TargetY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1023</TargetY></a:Value></a:KeyValueOfguidanyType></Lines><Zoom>0.75</Zoom></DrawingSurfaceModel></DrawingSurfaceList><MetaInformation><Assumptions>Example site risk assessment (IEC 62443-3-2). Remote sites are unattended. Station telemetry uses a public cellular network without a private APN; the block valve site uses licensed radio. The compressor OEM keeps an always-on VPN for remote support.</Assumptions><Contributors>John Desilva</Contributors><ExternalDependencies>Cellular carrier; licensed radio network; compressor OEM remote support; corporate gas scheduling system.</ExternalDependencies><HighLevelSystemDescription>Natural gas transmission pipeline: a control centre SCADA server supervises an unattended compressor station (RTU, compressor unit control PLC, emergency shutdown system) and a mainline block valve site. The leak detection system reads SCADA data. Gas nominations come from the corporate scheduling system; flow data is replicated to a DMZ historian for business reporting.</HighLevelSystemDescription><Owner>John Desilva</Owner><Reviewer/><ThreatModelName>Gas Pipeline - Site Risk Assessment (example)</ThreatModelName></MetaInformation><Notes/><ThreatInstances xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I02adf0c1a4-d28b-58d2-8365-1fb9ca1f862933d35f66-0fc9-569b-bbd0-d8985a2ae8859c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>33d35f66-0fc9-569b-bbd0-d8985a2ae885</b:FlowGuid><b:Id>1</b:Id><b:InteractionKey>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629:33d35f66-0fc9-569b-bbd0-d8985a2ae885:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Remote Access Gateway discoverable from the Internet or a carrier network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Remote Access Gateway is reached over the Internet or a cellular or WAN carrier network. Exposed industrial services are routinely found by Internet-wide scanning and attacked within days.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Vendor VPN</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use a private APN or VPN for cellular links. Block inbound connections from the Internet. Check your public address ranges regularly for exposed OT services.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0883 Internet Accessible Device; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-3 SR 1.13; 2-1 NET 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D01adf0c1a4-d28b-58d2-8365-1fb9ca1f862933d35f66-0fc9-569b-bbd0-d8985a2ae8859c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>33d35f66-0fc9-569b-bbd0-d8985a2ae885</b:FlowGuid><b:Id>2</b:Id><b:InteractionKey>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629:33d35f66-0fc9-569b-bbd0-d8985a2ae885:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Carrier or WAN outage cuts Compressor OEM Remote Support from Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The link between Compressor OEM Remote Support and Remote Access Gateway depends on an external carrier or WAN. An outage, a jamming attack or an attack on the provider stops remote control and monitoring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Vendor VPN</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Define how the remote site behaves on loss of communication (local autonomous control, safe state). Provide a backup path for essential sites. Include the carrier in incident and continuity plans.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1695.002 Block Communications: Ethernet; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.1; 2-1 AVAIL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S02adf0c1a4-d28b-58d2-8365-1fb9ca1f862933d35f66-0fc9-569b-bbd0-d8985a2ae8859c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>33d35f66-0fc9-569b-bbd0-d8985a2ae885</b:FlowGuid><b:Id>3</b:Id><b:InteractionKey>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629:33d35f66-0fc9-569b-bbd0-d8985a2ae885:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Stolen or reused credentials used for remote access by Compressor OEM Remote Support</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Remote access accounts are a favourite target. Phished, reused or leaked credentials let an attacker log in as Compressor OEM Remote Support from anywhere.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Vendor VPN</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require multi-factor authentication for all remote access. Use individual named accounts, never shared vendor accounts. Restrict access by source address and time window. Review remote access logs.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0822 External Remote Services; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.13; 2-1 NET 3; 2-4 SP.07</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E05adf0c1a4-d28b-58d2-8365-1fb9ca1f862933d35f66-0fc9-569b-bbd0-d8985a2ae8859c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>33d35f66-0fc9-569b-bbd0-d8985a2ae885</b:FlowGuid><b:Id>4</b:Id><b:InteractionKey>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629:33d35f66-0fc9-569b-bbd0-d8985a2ae885:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Always-on or unsupervised access by Compressor OEM Remote Support</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Compressor OEM Remote Support can connect whenever it wants, without approval or supervision. A compromise of the vendor or integrator becomes a compromise of the plant.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Vendor VPN</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Enable third-party access only on request, approved by operations and time-limited. Record or supervise sessions. Limit each third party to the assets it supports. Include security requirements in service contracts (2-4).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0822 External Remote Services; T0886 Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.6; 2-1 NET 3; 2-4 SP.07</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T03adf0c1a4-d28b-58d2-8365-1fb9ca1f862933d35f66-0fc9-569b-bbd0-d8985a2ae8859c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>33d35f66-0fc9-569b-bbd0-d8985a2ae885</b:FlowGuid><b:Id>5</b:Id><b:InteractionKey>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629:33d35f66-0fc9-569b-bbd0-d8985a2ae885:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Changes by Compressor OEM Remote Support to Remote Access Gateway not covered by security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Work done by Compressor OEM Remote Support (new equipment, upgrades, maintenance) may reintroduce default passwords, open ports or unpatched software if security requirements are not part of the contract and acceptance tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Vendor VPN</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Specify IEC 62443-2-4 capabilities in contracts. Check security settings at factory and site acceptance tests. Require hand-over documentation of accounts, ports and software versions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>2-4 SP.02; 2-4 SP.03; 2-1 ORG 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S04adf0c1a4-d28b-58d2-8365-1fb9ca1f862933d35f66-0fc9-569b-bbd0-d8985a2ae8859c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>33d35f66-0fc9-569b-bbd0-d8985a2ae885</b:FlowGuid><b:Id>6</b:Id><b:InteractionKey>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629:33d35f66-0fc9-569b-bbd0-d8985a2ae885:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Leavers' and contractors' accounts still active on Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Accounts of staff who left, former contractors or commissioning engineers often stay active on Remote Access Gateway for years and can be misused.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Vendor VPN</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a joiner-mover-leaver process that covers OT systems. Review OT accounts at least yearly. Set expiry dates on contractor accounts. Remove commissioning accounts at hand-over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.3; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S05adf0c1a4-d28b-58d2-8365-1fb9ca1f862933d35f66-0fc9-569b-bbd0-d8985a2ae8859c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>33d35f66-0fc9-569b-bbd0-d8985a2ae885</b:FlowGuid><b:Id>7</b:Id><b:InteractionKey>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629:33d35f66-0fc9-569b-bbd0-d8985a2ae885:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Compressor OEM Remote Support tricked into giving access to Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Compressor OEM Remote Support may not recognise phishing, social engineering or pretext phone calls. A single successful lure can give an attacker valid access to Remote Access Gateway.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Vendor VPN</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Give OT-specific security awareness training to operators, engineers and contractors (ORG 1). Teach staff to verify unexpected remote support requests. Report suspicious events without blame.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0865 Spearphishing Attachment; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>2-1 ORG 1; 2-4 SP.01</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>adf0c1a4-d28b-58d2-8365-1fb9ca1f8629</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T029c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>8</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Remote takeover of the operator or engineering session on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker with remote desktop or remote access to Engineering Workstation can operate the process exactly as an operator or engineer would, for example changing chemical dosing setpoints.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Do not allow remote control of operator stations without on-site approval. Prefer view-only remote access. Alarm on remote sessions. Keep engineering limits and interlocks in the controller, not only in the HMI.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0822 External Remote Services; T0823 Graphical User Interface; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 3-3 SR 1.13; 2-1 NET 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E069c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>9</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on Engineering Workstation not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for Engineering Workstation are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E089c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>10</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Engineering Workstation runs with default or unhardened configuration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation was installed with vendor defaults: unused services and ports open, default settings and no security baseline applied.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply the site hardening baseline (vendor security guide, CIS-type benchmark). Disable unused ports, services and accounts. Check configuration against the baseline after every change (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.7; 3-3 SR 7.6; 2-1 COMP 1; 2-4 SP.03</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S039c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>11</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or generic accounts in use on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Logins on Engineering Workstation use default, shared or generic accounts. Passwords are widely known, rarely changed and cannot be tied to a person.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Change all default passwords at commissioning. Use individual accounts where the system supports them. Where shared accounts cannot be avoided, control the password in a vault and log who checked it out.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.1; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R019c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>12</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Engineering Workstation would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Engineering Workstation are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D029c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>13</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Engineering Workstation cannot be restored quickly after ransomware or failure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>No tested backup exists for Engineering Workstation, or the restore has never been tried. After ransomware, a wiper or a hardware failure the plant may run without it for days or weeks.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Back up programs, configurations and system images (AVAIL 2). Keep an offline copy. Test restores on a schedule and record the restore time. Store installation media and licences.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.3; 2-1 AVAIL 2; 2-4 SP.12</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Production loss; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E099c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>14</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security capability of Engineering Workstation is below the zone target</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The capability security level (SL-C) of Engineering Workstation is lower than the target security level (SL-T) of its zone, or has not been checked. The zone cannot reach its target without extra measures.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Compare SL-C with SL-T for every asset (3-2 ZCR 5). Where SL-C is lower, add compensating countermeasures (filtering, monitoring, physical protection) and document them, or replace the asset.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-2 ZCR 5; 3-2 ZCR 6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Residual risk above tolerable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D039c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>15</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware spreads to Engineering Workstation and stops operations</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware entering the plant can spread across Windows hosts through shared accounts, file shares and remote services, encrypting Engineering Workstation and forcing a shutdown.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit lateral movement: host firewalls, no shared admin accounts, separate OT domain. Keep offline backups. Prepare and exercise a plan to run the process without the affected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 2-1 AVAIL 2; 2-1 EVENT 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Production loss; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I039c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>16</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant drawings, programs or process history stolen from Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering projects, network drawings, backups and process history on Engineering Workstation tell an attacker how the plant works and where it is weak.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Classify plant documentation and restrict access (DATA 1). Encrypt backups and laptops. Control what is replicated to the business network and to vendors.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E06e22ad9c4-04da-5827-abce-f8e3113ad41a9fccda88-7a1a-5db3-bdc2-ff1e91716192d32b8577-f0b6-5958-becc-c72d21506749</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9fccda88-7a1a-5db3-bdc2-ff1e91716192</b:FlowGuid><b:Id>17</b:Id><b:InteractionKey>e22ad9c4-04da-5827-abce-f8e3113ad41a:9fccda88-7a1a-5db3-bdc2-ff1e91716192:d32b8577-f0b6-5958-becc-c72d21506749</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on DMZ Historian not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for DMZ Historian are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22ad9c4-04da-5827-abce-f8e3113ad41a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>d32b8577-f0b6-5958-becc-c72d21506749</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D03e22ad9c4-04da-5827-abce-f8e3113ad41a9fccda88-7a1a-5db3-bdc2-ff1e91716192d32b8577-f0b6-5958-becc-c72d21506749</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9fccda88-7a1a-5db3-bdc2-ff1e91716192</b:FlowGuid><b:Id>18</b:Id><b:InteractionKey>e22ad9c4-04da-5827-abce-f8e3113ad41a:9fccda88-7a1a-5db3-bdc2-ff1e91716192:d32b8577-f0b6-5958-becc-c72d21506749</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware spreads to DMZ Historian and stops operations</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware entering the plant can spread across Windows hosts through shared accounts, file shares and remote services, encrypting DMZ Historian and forcing a shutdown.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit lateral movement: host firewalls, no shared admin accounts, separate OT domain. Keep offline backups. Prepare and exercise a plan to run the process without the affected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 2-1 AVAIL 2; 2-1 EVENT 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Production loss; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22ad9c4-04da-5827-abce-f8e3113ad41a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>d32b8577-f0b6-5958-becc-c72d21506749</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I03e22ad9c4-04da-5827-abce-f8e3113ad41a9fccda88-7a1a-5db3-bdc2-ff1e91716192d32b8577-f0b6-5958-becc-c72d21506749</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9fccda88-7a1a-5db3-bdc2-ff1e91716192</b:FlowGuid><b:Id>19</b:Id><b:InteractionKey>e22ad9c4-04da-5827-abce-f8e3113ad41a:9fccda88-7a1a-5db3-bdc2-ff1e91716192:d32b8577-f0b6-5958-becc-c72d21506749</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant drawings, programs or process history stolen from DMZ Historian</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering projects, network drawings, backups and process history on DMZ Historian tell an attacker how the plant works and where it is weak.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Classify plant documentation and restrict access (DATA 1). Encrypt backups and laptops. Control what is replicated to the business network and to vendors.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e22ad9c4-04da-5827-abce-f8e3113ad41a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>d32b8577-f0b6-5958-becc-c72d21506749</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E01f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>20</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Corporate IT and Gas Scheduling to Pipeline SCADA Server crosses a zone boundary without a conduit device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from Corporate IT and Gas Scheduling to Pipeline SCADA Server crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Route every inter-zone flow through a conduit device (firewall, data diode, DPI gateway) with deny-by-default rules that allow only this documented flow. Record the conduit in the zone and conduit drawing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0886 Remote Services; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation; Attack spread</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T01f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>21</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthenticated control traffic from Corporate IT and Gas Scheduling to Pipeline SCADA Server crosses zones</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands or setpoints sent to Pipeline SCADA Server use a protocol without authentication across a zone boundary. Anyone who gets a foothold on the path or in the source zone can send valid-looking commands.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Allow only the specific function codes or services needed at the conduit (protocol-aware firewall). Restrict which hosts may send writes. Use secure protocol variants where the installed equipment supports them. Monitor for writes from unexpected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.1; 3-3 SR 5.2; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety; Production loss</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I01f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>22</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant data between Corporate IT and Gas Scheduling and Pipeline SCADA Server readable in transit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Corporate IT and Gas Scheduling and Pipeline SCADA Server is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows leaving the zone where confidentiality matters (TLS, IPsec tunnel between sites). Never send passwords in cleartext. Classify plant data to decide where encryption is needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E02f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>23</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attack path from the business network via Corporate IT and Gas Scheduling to Pipeline SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Corporate IT and Gas Scheduling is on the business network, which is far more exposed to phishing and ransomware. This flow is a path from a compromised office PC or server into the plant.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Terminate business-to-plant flows in the industrial DMZ. Do not allow business hosts to connect to Level 1 and 2 directly. Use separate accounts and domains for IT and OT. Review this flow in the conduit rule set.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0886 Remote Services; T0884 Connection Proxy; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Production loss; Ransomware spread</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E06f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>24</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on Pipeline SCADA Server not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for Pipeline SCADA Server are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D03f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>25</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware spreads to Pipeline SCADA Server and stops operations</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware entering the plant can spread across Windows hosts through shared accounts, file shares and remote services, encrypting Pipeline SCADA Server and forcing a shutdown.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit lateral movement: host firewalls, no shared admin accounts, separate OT domain. Keep offline backups. Prepare and exercise a plan to run the process without the affected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 2-1 AVAIL 2; 2-1 EVENT 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Production loss; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D04f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>26</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Loss of view or control on Pipeline SCADA Server without a manual fallback</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Pipeline SCADA Server is lost to an attack or failure, operators may not be able to run or safely shut down the process if no manual operating procedures exist or they are not practised.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Write and exercise procedures for running or shutting down the process without the control system. Provide local panels or hard-wired indications for critical values. Include the scenario in incident response exercises.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0829 Loss of View; T0815 Denial of View; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.1; 2-1 AVAIL 1; 2-1 EVENT 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Safety; Production loss</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T08f3b31181-fdd7-5c40-af7d-91a77d4e26eef95fdb28-7f5e-5eab-88e5-ff32e6391a4d89c315e5-9df9-5ccc-a562-5e6797395f9c</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>f95fdb28-7f5e-5eab-88e5-ff32e6391a4d</b:FlowGuid><b:Id>27</b:Id><b:InteractionKey>f3b31181-fdd7-5c40-af7d-91a77d4e26ee:f95fdb28-7f5e-5eab-88e5-ff32e6391a4d:89c315e5-9df9-5ccc-a562-5e6797395f9c</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarms on Pipeline SCADA Server suppressed or not acted on</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker who suppresses or floods alarms on Pipeline SCADA Server can hide an attack or an abnormal process condition from operators.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Nominations from gas scheduling</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Control alarm configuration and shelving through management of change. Monitor alarm settings for changes. Make critical alarms independent of the SCADA system where the consequence is high.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 2-1 CM 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f3b31181-fdd7-5c40-af7d-91a77d4e26ee</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E067fe3459d-e4b2-57fb-b2d3-e34ad09420be808679cd-ae40-5bdc-b7e5-a260bdb78ea59e1e81f8-b508-54f3-95c5-654e4902a183</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>808679cd-ae40-5bdc-b7e5-a260bdb78ea5</b:FlowGuid><b:Id>28</b:Id><b:InteractionKey>7fe3459d-e4b2-57fb-b2d3-e34ad09420be:808679cd-ae40-5bdc-b7e5-a260bdb78ea5:9e1e81f8-b508-54f3-95c5-654e4902a183</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on Pipeline Controller HMI not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for Pipeline Controller HMI are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Controller console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7fe3459d-e4b2-57fb-b2d3-e34ad09420be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e1e81f8-b508-54f3-95c5-654e4902a183</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S047fe3459d-e4b2-57fb-b2d3-e34ad09420be808679cd-ae40-5bdc-b7e5-a260bdb78ea59e1e81f8-b508-54f3-95c5-654e4902a183</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>808679cd-ae40-5bdc-b7e5-a260bdb78ea5</b:FlowGuid><b:Id>29</b:Id><b:InteractionKey>7fe3459d-e4b2-57fb-b2d3-e34ad09420be:808679cd-ae40-5bdc-b7e5-a260bdb78ea5:9e1e81f8-b508-54f3-95c5-654e4902a183</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Leavers' and contractors' accounts still active on Pipeline Controller HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Accounts of staff who left, former contractors or commissioning engineers often stay active on Pipeline Controller HMI for years and can be misused.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Controller console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a joiner-mover-leaver process that covers OT systems. Review OT accounts at least yearly. Set expiry dates on contractor accounts. Remove commissioning accounts at hand-over.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.3; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7fe3459d-e4b2-57fb-b2d3-e34ad09420be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e1e81f8-b508-54f3-95c5-654e4902a183</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R017fe3459d-e4b2-57fb-b2d3-e34ad09420be808679cd-ae40-5bdc-b7e5-a260bdb78ea59e1e81f8-b508-54f3-95c5-654e4902a183</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>808679cd-ae40-5bdc-b7e5-a260bdb78ea5</b:FlowGuid><b:Id>30</b:Id><b:InteractionKey>7fe3459d-e4b2-57fb-b2d3-e34ad09420be:808679cd-ae40-5bdc-b7e5-a260bdb78ea5:9e1e81f8-b508-54f3-95c5-654e4902a183</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Pipeline Controller HMI would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Pipeline Controller HMI are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Controller console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7fe3459d-e4b2-57fb-b2d3-e34ad09420be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e1e81f8-b508-54f3-95c5-654e4902a183</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D037fe3459d-e4b2-57fb-b2d3-e34ad09420be808679cd-ae40-5bdc-b7e5-a260bdb78ea59e1e81f8-b508-54f3-95c5-654e4902a183</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>808679cd-ae40-5bdc-b7e5-a260bdb78ea5</b:FlowGuid><b:Id>31</b:Id><b:InteractionKey>7fe3459d-e4b2-57fb-b2d3-e34ad09420be:808679cd-ae40-5bdc-b7e5-a260bdb78ea5:9e1e81f8-b508-54f3-95c5-654e4902a183</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware spreads to Pipeline Controller HMI and stops operations</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware entering the plant can spread across Windows hosts through shared accounts, file shares and remote services, encrypting Pipeline Controller HMI and forcing a shutdown.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Controller console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit lateral movement: host firewalls, no shared admin accounts, separate OT domain. Keep offline backups. Prepare and exercise a plan to run the process without the affected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 2-1 AVAIL 2; 2-1 EVENT 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Production loss; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7fe3459d-e4b2-57fb-b2d3-e34ad09420be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e1e81f8-b508-54f3-95c5-654e4902a183</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D047fe3459d-e4b2-57fb-b2d3-e34ad09420be808679cd-ae40-5bdc-b7e5-a260bdb78ea59e1e81f8-b508-54f3-95c5-654e4902a183</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>808679cd-ae40-5bdc-b7e5-a260bdb78ea5</b:FlowGuid><b:Id>32</b:Id><b:InteractionKey>7fe3459d-e4b2-57fb-b2d3-e34ad09420be:808679cd-ae40-5bdc-b7e5-a260bdb78ea5:9e1e81f8-b508-54f3-95c5-654e4902a183</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Loss of view or control on Pipeline Controller HMI without a manual fallback</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Pipeline Controller HMI is lost to an attack or failure, operators may not be able to run or safely shut down the process if no manual operating procedures exist or they are not practised.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Controller console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Write and exercise procedures for running or shutting down the process without the control system. Provide local panels or hard-wired indications for critical values. Include the scenario in incident response exercises.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0829 Loss of View; T0815 Denial of View; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.1; 2-1 AVAIL 1; 2-1 EVENT 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Safety; Production loss</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7fe3459d-e4b2-57fb-b2d3-e34ad09420be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e1e81f8-b508-54f3-95c5-654e4902a183</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T087fe3459d-e4b2-57fb-b2d3-e34ad09420be808679cd-ae40-5bdc-b7e5-a260bdb78ea59e1e81f8-b508-54f3-95c5-654e4902a183</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>808679cd-ae40-5bdc-b7e5-a260bdb78ea5</b:FlowGuid><b:Id>33</b:Id><b:InteractionKey>7fe3459d-e4b2-57fb-b2d3-e34ad09420be:808679cd-ae40-5bdc-b7e5-a260bdb78ea5:9e1e81f8-b508-54f3-95c5-654e4902a183</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarms on Pipeline Controller HMI suppressed or not acted on</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker who suppresses or floods alarms on Pipeline Controller HMI can hide an attack or an abnormal process condition from operators.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Controller console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Control alarm configuration and shelving through management of change. Monitor alarm settings for changes. Make critical alarms independent of the SCADA system where the consequence is high.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 2-1 CM 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7fe3459d-e4b2-57fb-b2d3-e34ad09420be</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e1e81f8-b508-54f3-95c5-654e4902a183</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I0389c315e5-9df9-5ccc-a562-5e6797395f9c444a611c-13a6-54e2-9853-50f4b6a661c0e22ad9c4-04da-5827-abce-f8e3113ad41a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>444a611c-13a6-54e2-9853-50f4b6a661c0</b:FlowGuid><b:Id>34</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:444a611c-13a6-54e2-9853-50f4b6a661c0:e22ad9c4-04da-5827-abce-f8e3113ad41a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant drawings, programs or process history stolen from Pipeline Historian Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering projects, network drawings, backups and process history on Pipeline Historian Database tell an attacker how the plant works and where it is weak.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian writes</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Classify plant documentation and restrict access (DATA 1). Encrypt backups and laptops. Control what is replicated to the business network and to vendors.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e22ad9c4-04da-5827-abce-f8e3113ad41a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I0389c315e5-9df9-5ccc-a562-5e6797395f9c8ed75881-9793-5baa-a43c-46293cb12c10ff26f865-0690-5003-9fb3-7834fc74a7e8</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8ed75881-9793-5baa-a43c-46293cb12c10</b:FlowGuid><b:Id>35</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:8ed75881-9793-5baa-a43c-46293cb12c10:ff26f865-0690-5003-9fb3-7834fc74a7e8</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant drawings, programs or process history stolen from Leak Detection System</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering projects, network drawings, backups and process history on Leak Detection System tell an attacker how the plant works and where it is weak.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Leak detection data</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Classify plant documentation and restrict access (DATA 1). Encrypt backups and laptops. Control what is replicated to the business network and to vendors.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ff26f865-0690-5003-9fb3-7834fc74a7e8</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0189c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>36</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Pipeline SCADA Server to Station Cellular Router crosses a zone boundary without a conduit device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from Pipeline SCADA Server to Station Cellular Router crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Route every inter-zone flow through a conduit device (firewall, data diode, DPI gateway) with deny-by-default rules that allow only this documented flow. Record the conduit in the zone and conduit drawing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0886 Remote Services; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation; Attack spread</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T0189c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>37</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthenticated control traffic from Pipeline SCADA Server to Station Cellular Router crosses zones</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands or setpoints sent to Station Cellular Router use a protocol without authentication across a zone boundary. Anyone who gets a foothold on the path or in the source zone can send valid-looking commands.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Allow only the specific function codes or services needed at the conduit (protocol-aware firewall). Restrict which hosts may send writes. Use secure protocol variants where the installed equipment supports them. Monitor for writes from unexpected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.1; 3-3 SR 5.2; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety; Production loss</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I0189c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>38</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant data between Pipeline SCADA Server and Station Cellular Router readable in transit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Pipeline SCADA Server and Station Cellular Router is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows leaving the zone where confidentiality matters (TLS, IPsec tunnel between sites). Never send passwords in cleartext. Classify plant data to decide where encryption is needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I0289c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>39</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Station Cellular Router discoverable from the Internet or a carrier network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Station Cellular Router is reached over the Internet or a cellular or WAN carrier network. Exposed industrial services are routinely found by Internet-wide scanning and attacked within days.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use a private APN or VPN for cellular links. Block inbound connections from the Internet. Check your public address ranges regularly for exposed OT services.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0883 Internet Accessible Device; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-3 SR 1.13; 2-1 NET 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D0189c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>40</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Carrier or WAN outage cuts Pipeline SCADA Server from Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The link between Pipeline SCADA Server and Station Cellular Router depends on an external carrier or WAN. An outage, a jamming attack or an attack on the provider stops remote control and monitoring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Define how the remote site behaves on loss of communication (local autonomous control, safe state). Provide a backup path for essential sites. Include the carrier in incident and continuity plans.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1695.002 Block Communications: Ethernet; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.1; 2-1 AVAIL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0489c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>41</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unmanaged or undocumented WAN or cellular connection at Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cellular routers and WAN links are often installed by vendors or contractors and not managed by the site. They can bypass the firewall and give a direct way into the zone.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep an inventory of all external connections (CM 1). Manage routers centrally: change default passwords, disable unused services, restrict management access. Search regularly for unauthorised modems and routers.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0822 External Remote Services; T0883 Internet Accessible Device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 2-1 CM 1; 2-1 NET 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S0189c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>42</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Rogue device on the wireless network used by Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Plant wireless networks can be reached from outside the fence. A rogue access point or a device with a stolen key can join the network used by Station Cellular Router.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use strong wireless authentication and manage join keys. Separate wireless into its own zone behind a firewall. Monitor for rogue access points (NET 2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0860 Wireless Compromise; T0887 Wireless Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.6; 2-1 NET 2; 2-4 SP.04</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0689c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>43</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on Station Cellular Router not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for Station Cellular Router are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0889c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>44</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Station Cellular Router runs with default or unhardened configuration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Station Cellular Router was installed with vendor defaults: unused services and ports open, default settings and no security baseline applied.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply the site hardening baseline (vendor security guide, CIS-type benchmark). Disable unused ports, services and accounts. Check configuration against the baseline after every change (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.7; 3-3 SR 7.6; 2-1 COMP 1; 2-4 SP.03</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S0389c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>45</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or generic accounts in use on Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Logins on Station Cellular Router use default, shared or generic accounts. Passwords are widely known, rarely changed and cannot be tied to a person.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Change all default passwords at commissioning. Use individual accounts where the system supports them. Where shared accounts cannot be avoided, control the password in a vault and log who checked it out.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.1; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R0189c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>46</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Station Cellular Router would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Station Cellular Router are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D0289c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>47</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Station Cellular Router cannot be restored quickly after ransomware or failure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>No tested backup exists for Station Cellular Router, or the restore has never been tried. After ransomware, a wiper or a hardware failure the plant may run without it for days or weeks.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Back up programs, configurations and system images (AVAIL 2). Keep an offline copy. Test restores on a schedule and record the restore time. Store installation media and licences.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.3; 2-1 AVAIL 2; 2-4 SP.12</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Production loss; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0989c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>48</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security capability of Station Cellular Router is below the zone target</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The capability security level (SL-C) of Station Cellular Router is lower than the target security level (SL-T) of its zone, or has not been checked. The zone cannot reach its target without extra measures.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Compare SL-C with SL-T for every asset (3-2 ZCR 5). Where SL-C is lower, add compensating countermeasures (filtering, monitoring, physical protection) and document them, or replace the asset.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-2 ZCR 5; 3-2 ZCR 6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Residual risk above tolerable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-D0589c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>49</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failure of Station Cellular Router cuts essential communication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Station Cellular Router may be a single point of failure. An attack, a misconfiguration or a failed update could cut communication for a whole zone.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provide redundancy for network devices that carry essential traffic. Back up device configurations. Test changes before applying them and keep spare units.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.1; 2-1 AVAIL 1; 2-1 AVAIL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-D05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E1189c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>50</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Conduit rules on Station Cellular Router too permissive or not reviewed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Firewall rules on Station Cellular Router tend to grow over time: any-any rules, temporary vendor rules that stay, unused rules. Each one weakens the zone separation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Review conduit rules at least yearly and after projects. Require a documented reason and owner for every rule. Remove temporary rules on an expiry date. Alert on rule changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0884 Connection Proxy; T0885 Commonly Used Port</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 2-1 NET 1; 2-4 SP.03</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T1089c315e5-9df9-5ccc-a562-5e6797395f9c46baa24c-9575-5d43-a9e6-fc4c3cbeb665b2c7dc07-2435-573d-8304-7eee439a38b9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>46baa24c-9575-5d43-a9e6-fc4c3cbeb665</b:FlowGuid><b:Id>51</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:46baa24c-9575-5d43-a9e6-fc4c3cbeb665:b2c7dc07-2435-573d-8304-7eee439a38b9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical access to Station Cellular Router at an unattended or open location</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone with physical access to Station Cellular Router (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Lock cabinets and buildings, use door and cabinet intrusion alarms, and monitor remote sites (ORG 3). Disable unused ports. Alarm on device restarts and link changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0864 Transient Cyber Asset; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 ORG 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T05b2c7dc07-2435-573d-8304-7eee439a38b95a3d9254-a025-52eb-893c-27cfc07711eda0e69a9a-33e6-5082-9468-528ff61fab66</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>5a3d9254-a025-52eb-893c-27cfc07711ed</b:FlowGuid><b:Id>52</b:Id><b:InteractionKey>b2c7dc07-2435-573d-8304-7eee439a38b9:5a3d9254-a025-52eb-893c-27cfc07711ed:a0e69a9a-33e6-5082-9468-528ff61fab66</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cyber attack on Station RTU could drive the process to a hazardous state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Station RTU is manipulated, the process could exceed safe limits (overdosing, overpressure, overflow). The question is whether non-programmable safeguards still prevent the hazard.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a cyber-HAZOP or consequence analysis for this controller. Confirm that the worst cases are covered by safeguards an attacker cannot change remotely (mechanical relief, hard-wired trips, independent SIS). Record the scenario reference.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0831 Manipulation of Control; T0836 Modify Parameter; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.6; 3-2 ZCR 5; IEC 61511-1 8.2.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a0e69a9a-33e6-5082-9468-528ff61fab66</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T06b2c7dc07-2435-573d-8304-7eee439a38b95a3d9254-a025-52eb-893c-27cfc07711eda0e69a9a-33e6-5082-9468-528ff61fab66</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>5a3d9254-a025-52eb-893c-27cfc07711ed</b:FlowGuid><b:Id>53</b:Id><b:InteractionKey>b2c7dc07-2435-573d-8304-7eee439a38b9:5a3d9254-a025-52eb-893c-27cfc07711ed:a0e69a9a-33e6-5082-9468-528ff61fab66</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorised or unmanaged change to logic or configuration of Station RTU</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Changes to logic, setpoints or configuration of Station RTU are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Station control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply management of change to OT changes. Compare running logic with the approved version regularly. Use controller key switches or write-protection. Keep a change log with who, what and why (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0889 Modify Program; T0843 Program Download; T0836 Modify Parameter</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 2-1 CM 1; 2-4 SP.06</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2c7dc07-2435-573d-8304-7eee439a38b9</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a0e69a9a-33e6-5082-9468-528ff61fab66</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T05a0e69a9a-33e6-5082-9468-528ff61fab668235602f-476b-5540-a10f-a44a416d4320c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8235602f-476b-5540-a10f-a44a416d4320</b:FlowGuid><b:Id>54</b:Id><b:InteractionKey>a0e69a9a-33e6-5082-9468-528ff61fab66:8235602f-476b-5540-a10f-a44a416d4320:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cyber attack on Compressor Unit Control PLC could drive the process to a hazardous state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Compressor Unit Control PLC is manipulated, the process could exceed safe limits (overdosing, overpressure, overflow). The question is whether non-programmable safeguards still prevent the hazard.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Unit start stop and setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a cyber-HAZOP or consequence analysis for this controller. Confirm that the worst cases are covered by safeguards an attacker cannot change remotely (mechanical relief, hard-wired trips, independent SIS). Record the scenario reference.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0831 Manipulation of Control; T0836 Modify Parameter; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.6; 3-2 ZCR 5; IEC 61511-1 8.2.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a0e69a9a-33e6-5082-9468-528ff61fab66</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T06a0e69a9a-33e6-5082-9468-528ff61fab668235602f-476b-5540-a10f-a44a416d4320c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8235602f-476b-5540-a10f-a44a416d4320</b:FlowGuid><b:Id>55</b:Id><b:InteractionKey>a0e69a9a-33e6-5082-9468-528ff61fab66:8235602f-476b-5540-a10f-a44a416d4320:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorised or unmanaged change to logic or configuration of Compressor Unit Control PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Changes to logic, setpoints or configuration of Compressor Unit Control PLC are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Unit start stop and setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply management of change to OT changes. Compare running logic with the approved version regularly. Use controller key switches or write-protection. Keep a change log with who, what and why (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0889 Modify Program; T0843 Program Download; T0836 Modify Parameter</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 2-1 CM 1; 2-4 SP.06</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a0e69a9a-33e6-5082-9468-528ff61fab66</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E066ec065a9-c802-5695-87ed-0ad3e320ef1b933eb48d-6ba8-5fff-93c1-c948ab4c1a68c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>933eb48d-6ba8-5fff-93c1-c948ab4c1a68</b:FlowGuid><b:Id>56</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:933eb48d-6ba8-5fff-93c1-c948ab4c1a68:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on Compressor Unit Control PLC not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for Compressor Unit Control PLC are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pressure and temperature</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E086ec065a9-c802-5695-87ed-0ad3e320ef1b933eb48d-6ba8-5fff-93c1-c948ab4c1a68c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>933eb48d-6ba8-5fff-93c1-c948ab4c1a68</b:FlowGuid><b:Id>57</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:933eb48d-6ba8-5fff-93c1-c948ab4c1a68:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Compressor Unit Control PLC runs with default or unhardened configuration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Compressor Unit Control PLC was installed with vendor defaults: unused services and ports open, default settings and no security baseline applied.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pressure and temperature</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply the site hardening baseline (vendor security guide, CIS-type benchmark). Disable unused ports, services and accounts. Check configuration against the baseline after every change (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.7; 3-3 SR 7.6; 2-1 COMP 1; 2-4 SP.03</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S036ec065a9-c802-5695-87ed-0ad3e320ef1b933eb48d-6ba8-5fff-93c1-c948ab4c1a68c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>933eb48d-6ba8-5fff-93c1-c948ab4c1a68</b:FlowGuid><b:Id>58</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:933eb48d-6ba8-5fff-93c1-c948ab4c1a68:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or generic accounts in use on Compressor Unit Control PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Logins on Compressor Unit Control PLC use default, shared or generic accounts. Passwords are widely known, rarely changed and cannot be tied to a person.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pressure and temperature</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Change all default passwords at commissioning. Use individual accounts where the system supports them. Where shared accounts cannot be avoided, control the password in a vault and log who checked it out.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.1; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R016ec065a9-c802-5695-87ed-0ad3e320ef1b933eb48d-6ba8-5fff-93c1-c948ab4c1a68c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>933eb48d-6ba8-5fff-93c1-c948ab4c1a68</b:FlowGuid><b:Id>59</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:933eb48d-6ba8-5fff-93c1-c948ab4c1a68:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Compressor Unit Control PLC would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Compressor Unit Control PLC are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pressure and temperature</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E096ec065a9-c802-5695-87ed-0ad3e320ef1b933eb48d-6ba8-5fff-93c1-c948ab4c1a68c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>933eb48d-6ba8-5fff-93c1-c948ab4c1a68</b:FlowGuid><b:Id>60</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:933eb48d-6ba8-5fff-93c1-c948ab4c1a68:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security capability of Compressor Unit Control PLC is below the zone target</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The capability security level (SL-C) of Compressor Unit Control PLC is lower than the target security level (SL-T) of its zone, or has not been checked. The zone cannot reach its target without extra measures.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pressure and temperature</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Compare SL-C with SL-T for every asset (3-2 ZCR 5). Where SL-C is lower, add compensating countermeasures (filtering, monitoring, physical protection) and document them, or replace the asset.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-2 ZCR 5; 3-2 ZCR 6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Residual risk above tolerable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T106ec065a9-c802-5695-87ed-0ad3e320ef1b933eb48d-6ba8-5fff-93c1-c948ab4c1a68c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>933eb48d-6ba8-5fff-93c1-c948ab4c1a68</b:FlowGuid><b:Id>61</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:933eb48d-6ba8-5fff-93c1-c948ab4c1a68:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical access to Compressor Unit Control PLC at an unattended or open location</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone with physical access to Compressor Unit Control PLC (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pressure and temperature</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Lock cabinets and buildings, use door and cabinet intrusion alarms, and monitor remote sites (ORG 3). Disable unused ports. Alarm on device restarts and link changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0864 Transient Cyber Asset; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 ORG 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E01b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>62</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Station ESD System to Compressor Unit Control PLC crosses a zone boundary without a conduit device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from Station ESD System to Compressor Unit Control PLC crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Route every inter-zone flow through a conduit device (firewall, data diode, DPI gateway) with deny-by-default rules that allow only this documented flow. Record the conduit in the zone and conduit drawing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0886 Remote Services; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation; Attack spread</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I01b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>63</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant data between Station ESD System and Compressor Unit Control PLC readable in transit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Station ESD System and Compressor Unit Control PLC is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows leaving the zone where confidentiality matters (TLS, IPsec tunnel between sites). Never send passwords in cleartext. Classify plant data to decide where encryption is needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E06b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>64</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on Compressor Unit Control PLC not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for Compressor Unit Control PLC are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E08b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>65</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Compressor Unit Control PLC runs with default or unhardened configuration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Compressor Unit Control PLC was installed with vendor defaults: unused services and ports open, default settings and no security baseline applied.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply the site hardening baseline (vendor security guide, CIS-type benchmark). Disable unused ports, services and accounts. Check configuration against the baseline after every change (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.7; 3-3 SR 7.6; 2-1 COMP 1; 2-4 SP.03</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S03b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>66</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or generic accounts in use on Compressor Unit Control PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Logins on Compressor Unit Control PLC use default, shared or generic accounts. Passwords are widely known, rarely changed and cannot be tied to a person.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Change all default passwords at commissioning. Use individual accounts where the system supports them. Where shared accounts cannot be avoided, control the password in a vault and log who checked it out.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.1; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R01b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>67</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Compressor Unit Control PLC would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Compressor Unit Control PLC are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E09b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>68</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security capability of Compressor Unit Control PLC is below the zone target</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The capability security level (SL-C) of Compressor Unit Control PLC is lower than the target security level (SL-T) of its zone, or has not been checked. The zone cannot reach its target without extra measures.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Compare SL-C with SL-T for every asset (3-2 ZCR 5). Where SL-C is lower, add compensating countermeasures (filtering, monitoring, physical protection) and document them, or replace the asset.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-2 ZCR 5; 3-2 ZCR 6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Residual risk above tolerable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T10b92e2bbd-0e34-5379-ba02-028d299731111af0b320-bfbd-5d89-abe7-303cc8095bebc287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>1af0b320-bfbd-5d89-abe7-303cc8095beb</b:FlowGuid><b:Id>69</b:Id><b:InteractionKey>b92e2bbd-0e34-5379-ba02-028d29973111:1af0b320-bfbd-5d89-abe7-303cc8095beb:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical access to Compressor Unit Control PLC at an unattended or open location</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone with physical access to Compressor Unit Control PLC (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD status and start permissive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Lock cabinets and buildings, use door and cabinet intrusion alarms, and monitor remote sites (ORG 3). Disable unused ports. Alarm on device restarts and link changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0864 Transient Cyber Asset; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 ORG 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R016ec065a9-c802-5695-87ed-0ad3e320ef1b6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9b92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9</b:FlowGuid><b:Id>70</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Station ESD System would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Station ESD System are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD trip inputs</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T076ec065a9-c802-5695-87ed-0ad3e320ef1b6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9b92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9</b:FlowGuid><b:Id>71</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Safety function Station ESD System disabled or altered by a cyber attack</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A cyber attack on the safety system Station ESD System could disable trips or change trip points, so a hazardous event is no longer prevented (TRITON).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD trip inputs</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Carry out the SIS security risk assessment required by IEC 61511-1 8.2.4. Keep the SIS in its own zone. Use the key switch in Run, and control bypasses and maintenance overrides with procedures and alarms.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0880 Loss of Safety; T0837 Loss of Protection; T0889 Modify Program</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>IEC 61511-1 8.2.4; 2-4 SP.05; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T106ec065a9-c802-5695-87ed-0ad3e320ef1b6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9b92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9</b:FlowGuid><b:Id>72</b:Id><b:InteractionKey>6ec065a9-c802-5695-87ed-0ad3e320ef1b:6cd55e93-bd4c-5de9-b6b4-a78f51fa58f9:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical access to Station ESD System at an unattended or open location</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone with physical access to Station ESD System (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>ESD trip inputs</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Lock cabinets and buildings, use door and cabinet intrusion alarms, and monitor remote sites (ORG 3). Disable unused ports. Alarm on device restarts and link changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0864 Transient Cyber Asset; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 ORG 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6ec065a9-c802-5695-87ed-0ad3e320ef1b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E01c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>73</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Compressor Unit Control PLC to Station ESD System crosses a zone boundary without a conduit device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from Compressor Unit Control PLC to Station ESD System crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Route every inter-zone flow through a conduit device (firewall, data diode, DPI gateway) with deny-by-default rules that allow only this documented flow. Record the conduit in the zone and conduit drawing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0886 Remote Services; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation; Attack spread</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T01c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>74</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthenticated control traffic from Compressor Unit Control PLC to Station ESD System crosses zones</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands or setpoints sent to Station ESD System use a protocol without authentication across a zone boundary. Anyone who gets a foothold on the path or in the source zone can send valid-looking commands.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Allow only the specific function codes or services needed at the conduit (protocol-aware firewall). Restrict which hosts may send writes. Use secure protocol variants where the installed equipment supports them. Monitor for writes from unexpected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.1; 3-3 SR 5.2; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety; Production loss</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I01c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>75</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant data between Compressor Unit Control PLC and Station ESD System readable in transit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Compressor Unit Control PLC and Station ESD System is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows leaving the zone where confidentiality matters (TLS, IPsec tunnel between sites). Never send passwords in cleartext. Classify plant data to decide where encryption is needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R01c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>76</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Station ESD System would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Station ESD System are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T05c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>77</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cyber attack on Station ESD System could drive the process to a hazardous state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Station ESD System is manipulated, the process could exceed safe limits (overdosing, overpressure, overflow). The question is whether non-programmable safeguards still prevent the hazard.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a cyber-HAZOP or consequence analysis for this controller. Confirm that the worst cases are covered by safeguards an attacker cannot change remotely (mechanical relief, hard-wired trips, independent SIS). Record the scenario reference.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0831 Manipulation of Control; T0836 Modify Parameter; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.6; 3-2 ZCR 5; IEC 61511-1 8.2.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T06c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>78</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorised or unmanaged change to logic or configuration of Station ESD System</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Changes to logic, setpoints or configuration of Station ESD System are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply management of change to OT changes. Compare running logic with the approved version regularly. Use controller key switches or write-protection. Keep a change log with who, what and why (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0889 Modify Program; T0843 Program Download; T0836 Modify Parameter</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 2-1 CM 1; 2-4 SP.06</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T07c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>79</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Safety function Station ESD System disabled or altered by a cyber attack</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A cyber attack on the safety system Station ESD System could disable trips or change trip points, so a hazardous event is no longer prevented (TRITON).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Carry out the SIS security risk assessment required by IEC 61511-1 8.2.4. Keep the SIS in its own zone. Use the key switch in Run, and control bypasses and maintenance overrides with procedures and alarms.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0880 Loss of Safety; T0837 Loss of Protection; T0889 Modify Program</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>IEC 61511-1 8.2.4; 2-4 SP.05; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E10c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>80</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Safety system Station ESD System reachable from the control zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Station ESD System accepts traffic from outside the safety zone. A compromise of the control system could reach the safety function, so the two layers are no longer independent.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Separate the SIS in its own zone with a dedicated conduit. Allow read-only traffic from the BPCS where possible. Keep the SIS engineering station inside the safety zone and disconnected when not in use.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0880 Loss of Safety; T0886 Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; IEC 61511-1 8.2.4; 2-4 SP.05</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T10c287ee75-0f4a-5678-96b3-59444a9cedf59130ab3a-7397-5d61-b8a4-a0daef2f9f2fb92e2bbd-0e34-5379-ba02-028d29973111</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9130ab3a-7397-5d61-b8a4-a0daef2f9f2f</b:FlowGuid><b:Id>81</b:Id><b:InteractionKey>c287ee75-0f4a-5678-96b3-59444a9cedf5:9130ab3a-7397-5d61-b8a4-a0daef2f9f2f:b92e2bbd-0e34-5379-ba02-028d29973111</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical access to Station ESD System at an unattended or open location</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone with physical access to Station ESD System (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote ESD reset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Lock cabinets and buildings, use door and cabinet intrusion alarms, and monitor remote sites (ORG 3). Disable unused ports. Alarm on device restarts and link changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0864 Transient Cyber Asset; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 ORG 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b92e2bbd-0e34-5379-ba02-028d29973111</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E01689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>82</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Field Technician Laptop to Compressor Unit Control PLC crosses a zone boundary without a conduit device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from Field Technician Laptop to Compressor Unit Control PLC crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Route every inter-zone flow through a conduit device (firewall, data diode, DPI gateway) with deny-by-default rules that allow only this documented flow. Record the conduit in the zone and conduit drawing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0886 Remote Services; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation; Attack spread</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T01689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>83</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthenticated control traffic from Field Technician Laptop to Compressor Unit Control PLC crosses zones</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands or setpoints sent to Compressor Unit Control PLC use a protocol without authentication across a zone boundary. Anyone who gets a foothold on the path or in the source zone can send valid-looking commands.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Allow only the specific function codes or services needed at the conduit (protocol-aware firewall). Restrict which hosts may send writes. Use secure protocol variants where the installed equipment supports them. Monitor for writes from unexpected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.1; 3-3 SR 5.2; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety; Production loss</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I01689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>84</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant data between Field Technician Laptop and Compressor Unit Control PLC readable in transit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Field Technician Laptop and Compressor Unit Control PLC is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows leaving the zone where confidentiality matters (TLS, IPsec tunnel between sites). Never send passwords in cleartext. Classify plant data to decide where encryption is needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E06689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>85</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Known vulnerabilities on Compressor Unit Control PLC not patched</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security patches for Compressor Unit Control PLC are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.2; 2-1 COMP 3; 2-4 SP.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E08689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>86</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Compressor Unit Control PLC runs with default or unhardened configuration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Compressor Unit Control PLC was installed with vendor defaults: unused services and ports open, default settings and no security baseline applied.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply the site hardening baseline (vendor security guide, CIS-type benchmark). Disable unused ports, services and accounts. Check configuration against the baseline after every change (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.7; 3-3 SR 7.6; 2-1 COMP 1; 2-4 SP.03</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S03689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>87</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or generic accounts in use on Compressor Unit Control PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Logins on Compressor Unit Control PLC use default, shared or generic accounts. Passwords are widely known, rarely changed and cannot be tied to a person.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Change all default passwords at commissioning. Use individual accounts where the system supports them. Where shared accounts cannot be avoided, control the password in a vault and log who checked it out.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.1; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R01689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>88</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Compressor Unit Control PLC would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Compressor Unit Control PLC are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E09689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>89</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security capability of Compressor Unit Control PLC is below the zone target</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The capability security level (SL-C) of Compressor Unit Control PLC is lower than the target security level (SL-T) of its zone, or has not been checked. The zone cannot reach its target without extra measures.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Compare SL-C with SL-T for every asset (3-2 ZCR 5). Where SL-C is lower, add compensating countermeasures (filtering, monitoring, physical protection) and document them, or replace the asset.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-2 ZCR 5; 3-2 ZCR 6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Residual risk above tolerable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T05689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>90</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cyber attack on Compressor Unit Control PLC could drive the process to a hazardous state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Compressor Unit Control PLC is manipulated, the process could exceed safe limits (overdosing, overpressure, overflow). The question is whether non-programmable safeguards still prevent the hazard.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a cyber-HAZOP or consequence analysis for this controller. Confirm that the worst cases are covered by safeguards an attacker cannot change remotely (mechanical relief, hard-wired trips, independent SIS). Record the scenario reference.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0831 Manipulation of Control; T0836 Modify Parameter; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.6; 3-2 ZCR 5; IEC 61511-1 8.2.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T06689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>91</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorised or unmanaged change to logic or configuration of Compressor Unit Control PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Changes to logic, setpoints or configuration of Compressor Unit Control PLC are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply management of change to OT changes. Compare running logic with the approved version regularly. Use controller key switches or write-protection. Keep a change log with who, what and why (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0889 Modify Program; T0843 Program Download; T0836 Modify Parameter</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 2-1 CM 1; 2-4 SP.06</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T09689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>92</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware brought to Compressor Unit Control PLC on USB media or a visiting laptop</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>USB drives, contractor laptops and other transient devices connected to Compressor Unit Control PLC are a common way malware reaches air-gapped or isolated plant networks (Stuxnet).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Control portable media and transient devices (COMP 1): scan at a kiosk before use, use company-owned media only, block unknown USB devices, and keep a register of transient devices and their owners.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0847 Replication Through Removable Media; T0864 Transient Cyber Asset</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 COMP 1; 2-4 SP.10</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T10689bf646-0142-575f-b480-a520b6f5407d600aabfe-eb54-5013-82a0-9d6ce37e15f5c287ee75-0f4a-5678-96b3-59444a9cedf5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>600aabfe-eb54-5013-82a0-9d6ce37e15f5</b:FlowGuid><b:Id>93</b:Id><b:InteractionKey>689bf646-0142-575f-b480-a520b6f5407d:600aabfe-eb54-5013-82a0-9d6ce37e15f5:c287ee75-0f4a-5678-96b3-59444a9cedf5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical access to Compressor Unit Control PLC at an unattended or open location</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone with physical access to Compressor Unit Control PLC (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming at the station</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Lock cabinets and buildings, use door and cabinet intrusion alarms, and monitor remote sites (ORG 3). Disable unused ports. Alarm on device restarts and link changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0864 Transient Cyber Asset; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 ORG 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>689bf646-0142-575f-b480-a520b6f5407d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c287ee75-0f4a-5678-96b3-59444a9cedf5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0189c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>94</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Pipeline SCADA Server to Valve Site RTU crosses a zone boundary without a conduit device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from Pipeline SCADA Server to Valve Site RTU crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Route every inter-zone flow through a conduit device (firewall, data diode, DPI gateway) with deny-by-default rules that allow only this documented flow. Record the conduit in the zone and conduit drawing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0886 Remote Services; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation; Attack spread</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T0189c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>95</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthenticated control traffic from Pipeline SCADA Server to Valve Site RTU crosses zones</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands or setpoints sent to Valve Site RTU use a protocol without authentication across a zone boundary. Anyone who gets a foothold on the path or in the source zone can send valid-looking commands.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Allow only the specific function codes or services needed at the conduit (protocol-aware firewall). Restrict which hosts may send writes. Use secure protocol variants where the installed equipment supports them. Monitor for writes from unexpected hosts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.1; 3-3 SR 5.2; 2-1 NET 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety; Production loss</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I0189c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>96</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Plant data between Pipeline SCADA Server and Valve Site RTU readable in transit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Pipeline SCADA Server and Valve Site RTU is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows leaving the zone where confidentiality matters (TLS, IPsec tunnel between sites). Never send passwords in cleartext. Classify plant data to decide where encryption is needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 4.1; 2-1 DATA 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0389c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>97</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Controller Valve Site RTU reachable from outside the plant</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Valve Site RTU receives traffic directly from the business network, a cloud service or an untrusted network, bypassing the supervisory and DMZ layers.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Broker the connection through the DMZ or a remote access gateway. Make any access from higher levels read-only. Re-check the zone model and the SL-T for this zone.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0883 Internet Accessible Device; T0886 Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-I0289c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>98</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Valve Site RTU discoverable from the Internet or a carrier network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Valve Site RTU is reached over the Internet or a cellular or WAN carrier network. Exposed industrial services are routinely found by Internet-wide scanning and attacked within days.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use a private APN or VPN for cellular links. Block inbound connections from the Internet. Check your public address ranges regularly for exposed OT services.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0883 Internet Accessible Device; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-3 SR 1.13; 2-1 NET 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-I02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S0189c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>99</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Rogue device on the wireless network used by Valve Site RTU</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Plant wireless networks can be reached from outside the fence. A rogue access point or a device with a stolen key can join the network used by Valve Site RTU.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use strong wireless authentication and manage join keys. Separate wireless into its own zone behind a firewall. Monitor for rogue access points (NET 2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0860 Wireless Compromise; T0887 Wireless Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.6; 2-1 NET 2; 2-4 SP.04</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0889c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>100</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Valve Site RTU runs with default or unhardened configuration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Valve Site RTU was installed with vendor defaults: unused services and ports open, default settings and no security baseline applied.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply the site hardening baseline (vendor security guide, CIS-type benchmark). Disable unused ports, services and accounts. Check configuration against the baseline after every change (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 7.7; 3-3 SR 7.6; 2-1 COMP 1; 2-4 SP.03</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-S0389c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>101</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or generic accounts in use on Valve Site RTU</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Logins on Valve Site RTU use default, shared or generic accounts. Passwords are widely known, rarely changed and cannot be tied to a person.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Change all default passwords at commissioning. Use individual accounts where the system supports them. Where shared accounts cannot be avoided, control the password in a vault and log who checked it out.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.1; 2-1 USER 1; 2-4 SP.09</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-R0189c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>102</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacks on Valve Site RTU would not be detected</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Security events from Valve Site RTU are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Forward security events to a central log server or SIEM. Deploy passive OT network monitoring on the zone. Define who reviews alerts and how fast (EVENT 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 6.2; 2-1 EVENT 1; 2-4 SP.08</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR6 Timely response to events</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Detection; Recovery time</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-E0989c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>103</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security capability of Valve Site RTU is below the zone target</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The capability security level (SL-C) of Valve Site RTU is lower than the target security level (SL-T) of its zone, or has not been checked. The zone cannot reach its target without extra measures.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Compare SL-C with SL-T for every asset (3-2 ZCR 5). Where SL-C is lower, add compensating countermeasures (filtering, monitoring, physical protection) and document them, or replace the asset.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-2 ZCR 5; 3-2 ZCR 6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Residual risk above tolerable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T0589c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>104</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cyber attack on Valve Site RTU could drive the process to a hazardous state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Valve Site RTU is manipulated, the process could exceed safe limits (overdosing, overpressure, overflow). The question is whether non-programmable safeguards still prevent the hazard.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a cyber-HAZOP or consequence analysis for this controller. Confirm that the worst cases are covered by safeguards an attacker cannot change remotely (mechanical relief, hard-wired trips, independent SIS). Record the scenario reference.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0831 Manipulation of Control; T0836 Modify Parameter; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.6; 3-2 ZCR 5; IEC 61511-1 8.2.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T0689c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>105</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorised or unmanaged change to logic or configuration of Valve Site RTU</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Changes to logic, setpoints or configuration of Valve Site RTU are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply management of change to OT changes. Compare running logic with the approved version regularly. Use controller key switches or write-protection. Keep a change log with who, what and why (CM 1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0889 Modify Program; T0843 Program Download; T0836 Modify Parameter</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.1; 2-1 CM 1; 2-4 SP.06</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T1089c315e5-9df9-5ccc-a562-5e6797395f9c2eb6feb7-b84a-5060-a343-1de34c681adaf16871a8-237c-54a1-9407-e6246cf1728e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>2eb6feb7-b84a-5060-a343-1de34c681ada</b:FlowGuid><b:Id>106</b:Id><b:InteractionKey>89c315e5-9df9-5ccc-a562-5e6797395f9c:2eb6feb7-b84a-5060-a343-1de34c681ada:f16871a8-237c-54a1-9407-e6246cf1728e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical access to Valve Site RTU at an unattended or open location</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone with physical access to Valve Site RTU (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve site telemetry over radio</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Lock cabinets and buildings, use door and cabinet intrusion alarms, and monitor remote sites (ORG 3). Disable unused ports. Alarm on device restarts and link changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0864 Transient Cyber Asset; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 2.3; 2-1 ORG 3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>89c315e5-9df9-5ccc-a562-5e6797395f9c</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T05f16871a8-237c-54a1-9407-e6246cf1728e987a15df-2eff-55cf-b854-0d6bfe9447c79ddc1ad5-2732-55ef-bafe-ecbf020517c3</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>987a15df-2eff-55cf-b854-0d6bfe9447c7</b:FlowGuid><b:Id>107</b:Id><b:InteractionKey>f16871a8-237c-54a1-9407-e6246cf1728e:987a15df-2eff-55cf-b854-0d6bfe9447c7:9ddc1ad5-2732-55ef-bafe-ecbf020517c3</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cyber attack on Mainline Valve Actuator could drive the process to a hazardous state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Mainline Valve Actuator is manipulated, the process could exceed safe limits (overdosing, overpressure, overflow). The question is whether non-programmable safeguards still prevent the hazard.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Valve open close command</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Run a cyber-HAZOP or consequence analysis for this controller. Confirm that the worst cases are covered by safeguards an attacker cannot change remotely (mechanical relief, hard-wired trips, independent SIS). Record the scenario reference.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0831 Manipulation of Control; T0836 Modify Parameter; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 3.6; 3-2 ZCR 5; IEC 61511-1 8.2.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Environmental; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ConsequenceCategory</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Severity</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Tolerable</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ResidualRisk</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f16871a8-237c-54a1-9407-e6246cf1728e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9ddc1ad5-2732-55ef-bafe-ecbf020517c3</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>PL-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>PL-T06f16871a8-237c-54a1-9407-e6246cf1728e987a15df-2eff-55cf-b854-0d6bfe9447c79ddc1ad5-2732-55ef-bafe-ecbf020517c3</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>987a15df-2eff-55cf-b854-0d6bfe9447c7</b:FlowGuid><b:Id>108</b:Id><b:InteractionKey>f16871a8-237c-54a1-9407-e6246cf1728e:987a15df-2eff-55cf-b854-0d6bfe9447c7:9ddc1ad5-2732-55ef-bafe-ecbf020517c3</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorised or unmanaged change to logic or configuration of Mainline Valve Actuator</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Changes to logic, setpoints or configuration of Mainline Valve Actuator are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstri