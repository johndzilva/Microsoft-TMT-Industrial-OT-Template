act.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Configurable Attributes</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType><a:anyType i:type="b:HeaderDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>As Generic Trust Line Boundary</b:DisplayName><b:Name/><b:Value i:nil="true"/></a:anyType></Properties><TypeId xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">SE.TB.L.OT.Internet</TypeId><HandleX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1300</HandleX><HandleY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">795</HandleY><PortSource xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">None</PortSource><PortTarget xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">None</PortTarget><SourceGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">00000000-0000-0000-0000-000000000000</SourceGuid><SourceX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1039</SourceX><SourceY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">970</SourceY><TargetGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">00000000-0000-0000-0000-000000000000</TargetGuid><TargetX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1649</TargetX><TargetY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">753</TargetY></a:Value></a:KeyValueOfguidanyType></Lines><Zoom>0.75</Zoom></DrawingSurfaceModel></DrawingSurfaceList><MetaInformation><Assumptions>Example model. Field devices (Level 0) are shown only where they carry digital data. The plant network is wired Ethernet; remote lift stations use a public cellular network.</Assumptions><Contributors>John Desilva</Contributors><ExternalDependencies>Cellular carrier; vendor remote support; corporate IT network.</ExternalDependencies><HighLevelSystemDescription>Municipal water treatment plant: SCADA server and control-room HMI supervise a chemical dosing PLC (chlorine analyzer, dosing pump drive) and a filtration PLC. An engineering workstation programs the PLCs. Process data is stored in a historian and replicated to a DMZ historian for corporate reporting. The vendor connects through a remote access gateway. Remote lift stations are controlled over DNP3 via cellular routers.</HighLevelSystemDescription><Owner>John Desilva</Owner><Reviewer/><ThreatModelName>Water Treatment Plant - OT Threat Model (example)</ThreatModelName></MetaInformation><Notes/><ThreatInstances xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S016458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>1</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Vendor Remote Support across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate Vendor Remote Support and send traffic that Remote Access Gateway accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D016458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>2</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Remote Access Gateway from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Remote Access Gateway receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R016458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>3</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Remote Access Gateway not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Remote Access Gateway from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E016458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>4</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Remote Access Gateway reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Remote Access Gateway that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I036458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>5</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Remote Access Gateway (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Remote Access Gateway across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E096458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>6</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Web application vulnerabilities in Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web interface of Remote Access Gateway could be vulnerable to injection, XSS, CSRF, path traversal or authentication bypass, leading to device takeover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply secure coding (OWASP ASVS) and input validation (CR 3.5). Use CSRF tokens, secure headers and HTTPS only. Perform web penetration testing and static analysis (4-1 SVV).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0819 Exploit Public-Facing Application; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S036458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>7</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Session hijacking on the Remote Access Gateway web interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session tokens for Remote Access Gateway could be stolen or fixed, allowing an attacker to act as a logged-in user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity (CR 3.8): random session IDs, secure/HttpOnly cookies, invalidate on logout. Session lock after inactivity (CR 2.5) and remote session termination (CR 2.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.8; 4-2 CR 2.5; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I076458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>8</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Verbose errors or diagnostics disclose internals of Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Error messages, stack traces or diagnostic pages from Remote Access Gateway could reveal versions, paths or configuration useful to an attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Return error information that supports operation without exposing internals (CR 3.7). Restrict diagnostic data to authenticated users.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S046458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>9</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Remote Access Gateway could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S056458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>10</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Remote Access Gateway if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E116458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>11</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Remote Access Gateway, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E126458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>12</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Remote Access Gateway could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T176458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>13</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Remote Access Gateway may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T186458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>14</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Counterfeit device or tampering of Remote Access Gateway before delivery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Remote Access Gateway could be counterfeited or tampered with during manufacturing, shipping or provisioning, including injection of attacker-controlled keys.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provision product-supplier roots of trust in a controlled environment (EDR/NDR 3.12) and let the asset owner provision their own (3.13). Provide device identity certificates and genuineness checks. Use tamper-evident packaging.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.12; 4-2 EDR 3.13; 4-1 SM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T196458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>15</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Remote Access Gateway disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Remote Access Gateway without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D076458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>16</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Remote Access Gateway unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Remote Access Gateway could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I086458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>17</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Remote Access Gateway could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D086458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>18</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Denial of service of network device Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broadcast storms, CAM table overflow, routing / redundancy protocol attacks (MRP, RSTP) or management-plane floods could stop Remote Access Gateway from forwarding OT traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Storm control and rate limiting. Protect the management plane. Authenticate redundancy and routing protocols where supported. Keep forwarding of control traffic independent of management load (CR 7.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I096458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>19</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Management credentials or configuration of Remote Access Gateway disclosed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SNMP community strings, Telnet/HTTP management or configuration backups of Remote Access Gateway could disclose credentials and network topology.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use SNMPv3, SSH and HTTPS for management. Disable Telnet, HTTP and SNMPv1/v2c by default. Encrypt stored configuration backups.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 1.5; 4-2 CR 7.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S066458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>20</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Stolen credentials used for remote access to Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Phished or reused VPN / remote access credentials could give an attacker interactive access to Remote Access Gateway from the Internet.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require multi-factor authentication for access from untrusted networks (CR 1.1 RE / SR 1.13). Use individual accounts. Restrict source addresses and time windows.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0822 External Remote Services; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.13; 4-2 CR 1.1; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E146458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>21</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unsupervised or persistent third-party access to Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Vendor or integrator access to Remote Access Gateway could be always-on, unsupervised or overly broad, giving a path for attackers who compromise the third party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Enable remote access on request only, with approval and session recording. Support remote session termination (CR 2.6) and concurrent session limits (CR 2.7). Restrict third parties to the assets they support.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0822 External Remote Services; T0886 Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.6; 3-3 SR 1.13; 4-2 CR 2.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E156458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>22</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Remote Access Gateway exposed to the Internet or an untrusted network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from Vendor Remote Support reaches Remote Access Gateway over the Internet, cellular or another untrusted network, so it can be found and attacked directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Never expose OT services directly to the Internet. Terminate untrusted connections in a DMZ / remote access gateway with MFA (SR 1.13). Monitor for exposure (e.g. Shodan-type scans of own address space).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0883 Internet Accessible Device; T0822 External Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-3 SR 1.13; 4-2 NDR 1.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S086458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>23</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Impersonation of Vendor Remote Support at Remote Access Gateway</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could impersonate Vendor Remote Support at Remote Access Gateway using stolen, guessed or shared credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate all human users (CR 1.1). Strong password policy (CR 1.7). MFA for privileged and remote users. Integrate with central account management (CR 1.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.3; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R066458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>24</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Local audit trail on Remote Access Gateway lost, overwritten or cleared</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot Remote Access Gateway so evidence held in volatile memory is lost.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect audit records against deletion (CR 3.9) and keep them across restarts. Forward events in near real time to a central collector (CR 6.1, syslog over TLS). Warn when audit capacity is nearly used (CR 2.9). Record clearing of the log as an audit event itself.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.9; 4-2 CR 2.9; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Detection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T296458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>25</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Rogue publisher or subscriber on the Vendor Remote Support to Remote Access Gateway messaging channel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>On publish/subscribe channels (MQTT, cloud messaging) any client the broker accepts may publish to or subscribe to topics. A rogue client could inject false values or commands for Remote Access Gateway, or read all telemetry.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require client authentication (certificates) on the broker and per-topic access control lists (CR 1.2, CR 2.1). Use TLS. Sign or validate payloads that carry commands. Disable wildcard subscriptions for untrusted clients.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0869.002 Standard Application Layer Protocol: Publish/Subscribe Protocols; T1692.001 Unauthorized Message: Command Message; T1692.002 Unauthorized Message: Reporting Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 4-2 CR 2.1; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T29</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T286458df02-6d9b-5f05-8ae6-dfd2546d0b7e82477007-fdfc-519d-bee4-a340f2f3e0df9c8ead96-6773-51e9-a763-eb7a03bd6985</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>82477007-fdfc-519d-bee4-a340f2f3e0df</b:FlowGuid><b:Id>26</b:Id><b:InteractionKey>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e:82477007-fdfc-519d-bee4-a340f2f3e0df:9c8ead96-6773-51e9-a763-eb7a03bd6985</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Remote Access Gateway during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Remote Access Gateway before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>VPN session</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6458df02-6d9b-5f05-8ae6-dfd2546d0b7e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S019c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>27</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Remote Access Gateway across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate Remote Access Gateway and send traffic that Engineering Workstation accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D019c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>28</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Engineering Workstation from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R019c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>29</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Engineering Workstation not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Engineering Workstation from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E019c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>30</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Engineering Workstation reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Engineering Workstation that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I039c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>31</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Engineering Workstation (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Engineering Workstation across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E039c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>32</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Debug or service interface on Engineering Workstation gives privileged access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>JTAG, UART consoles, USB service ports or test modes on Engineering Workstation could give root access, bypass authentication or dump firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable or lock debug interfaces in production (EDR/HDR/NDR 2.13). Protect service ports with authentication. Document any remaining interfaces in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 2.13; 4-2 HDR 2.13; 4-2 NDR 2.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E069c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>33</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Missing or weak role-based access control on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Users of Engineering Workstation could perform actions beyond their role (e.g. operators changing engineering parameters) if authorisation is not enforced per role.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Enforce role-based authorisation for all human users (CR 2.1), with least privilege and separation between operator, engineer and administrator roles. Support supervisor override for essential operations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 1.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T149c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>34</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware execution on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could be infected with malware via network, removable media, phishing or vendor tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support malware protection appropriate to the platform: application allow-listing, OS hardening or validated anti-malware (HDR/SAR 3.2). Only run signed code. Document compatible security software in the guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0863 User Execution; T1701 Command and Scripting Interpreter; T0865 Spearphishing Attachment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 3.2; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D069c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>35</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware or destructive malware disables Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware or wiper malware could encrypt or destroy Engineering Workstation and its data, stopping production (e.g. NotPetya, Colonial Pipeline effects).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support backup of configuration and data (CR 7.3) and documented, tested recovery to a known secure state (CR 7.4). Limit lateral movement through segmentation and least privilege. Keep offline backups.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.3; 4-2 CR 7.4; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T159c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>36</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Project file infection via Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering projects handled by Engineering Workstation could be infected or modified so malicious logic is downloaded to controllers.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Integrity-protect project files (signatures / hashes, CR 3.4). Show differences before download. Validate project files on open. Keep engineering tools patched and isolated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0873 Project File Infection; T0889 Modify Program</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-2 SAR 3.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I069c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>37</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Theft of engineering / operational information from Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Projects, network diagrams, tag lists or historical data on Engineering Workstation could be exfiltrated and used to plan an attack or steal IP.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt sensitive data at rest (CR 4.1). Restrict read access by role. Monitor large exports. Classify engineering data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories; T0893 Data from Local System</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S049c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>38</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S059c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>39</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Engineering Workstation if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E119c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>40</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Engineering Workstation, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E129c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>41</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T179c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>42</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Engineering Workstation may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T199c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>43</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Engineering Workstation disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Engineering Workstation without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D079c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>44</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Engineering Workstation unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Engineering Workstation could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I089c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>45</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T229c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>46</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware introduced into Engineering Workstation via removable media or transient device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>USB drives, SD cards or maintenance laptops connected to Engineering Workstation could carry malware (e.g. Stuxnet).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable autorun. Restrict or disable USB ports (CR 7.7). Scan media at a kiosk before use. Accept only signed files. Control portable and mobile devices (SR 2.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0847 Replication Through Removable Media; T0864 Transient Cyber Asset; T0895 Autorun Image</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.2; 4-2 HDR 3.2; 4-2 CR 7.7; 3-3 SR 2.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T22</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D149c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>47</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between Remote Access Gateway and Engineering Workstation blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between Remote Access Gateway and Engineering Workstation while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E229c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>48</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacker tools staged on Engineering Workstation to reach the control network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation has network access to controllers. An attacker who gets code onto it (drive-by download, script, phishing, lateral transfer from another host) could use built-in tools, scripts or API hooking to scan, move laterally and send commands as a trusted host.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use application allow-listing and block script interpreters that are not needed (HDR 3.2, SAR 2.4). Do not allow web browsing or e-mail on OT hosts (CR 5.3 person-to-person communication). Restrict outbound and lateral connections from the host. Monitor for new executables and tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0867 Lateral Tool Transfer; T0817 Drive-by Compromise; T0874 Hooking; T1701.001 Command and Scripting Interpreter: PowerShell; T0852 Screen Capture; T0840 Network Connection Enumeration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 2.4; 4-2 CR 7.7; 4-2 CR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E22</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T289c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>49</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Engineering Workstation during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Engineering Workstation before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S139c8ead96-6773-51e9-a763-eb7a03bd698573f45444-6516-5ac4-a6b9-c03e3de85607c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>73f45444-6516-5ac4-a6b9-c03e3de85607</b:FlowGuid><b:Id>50</b:Id><b:InteractionKey>9c8ead96-6773-51e9-a763-eb7a03bd6985:73f45444-6516-5ac4-a6b9-c03e3de85607:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Dormant, orphaned or unrevoked accounts on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Accounts of former staff, contractors, commissioning engineers or test users may remain active on Engineering Workstation and can be used by an attacker who obtains their credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Remote desktop to EWS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support account management functions: create, modify, disable and remove accounts, with expiry dates (CR 1.3, CR 1.4). Report inactive accounts. Integrate with central identity management so leavers are removed everywhere. Remove test and commissioning accounts before handover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.4; 4-2 CR 1.3; 4-2 CR 1.5</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9c8ead96-6773-51e9-a763-eb7a03bd6985</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>51</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Process Historian Database across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate Process Historian Database and send traffic that DMZ Historian Replica accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>52</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of DMZ Historian Replica from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>DMZ Historian Replica receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>53</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on DMZ Historian Replica not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach DMZ Historian Replica from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>54</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on DMZ Historian Replica reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on DMZ Historian Replica that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>55</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of DMZ Historian Replica (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query DMZ Historian Replica across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E06753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>56</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Missing or weak role-based access control on DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Users of DMZ Historian Replica could perform actions beyond their role (e.g. operators changing engineering parameters) if authorisation is not enforced per role.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Enforce role-based authorisation for all human users (CR 2.1), with least privilege and separation between operator, engineer and administrator roles. Support supervisor override for essential operations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 1.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T14753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>57</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware execution on DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>DMZ Historian Replica could be infected with malware via network, removable media, phishing or vendor tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support malware protection appropriate to the platform: application allow-listing, OS hardening or validated anti-malware (HDR/SAR 3.2). Only run signed code. Document compatible security software in the guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0863 User Execution; T1701 Command and Scripting Interpreter; T0865 Spearphishing Attachment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 3.2; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D06753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>58</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware or destructive malware disables DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware or wiper malware could encrypt or destroy DMZ Historian Replica and its data, stopping production (e.g. NotPetya, Colonial Pipeline effects).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support backup of configuration and data (CR 7.3) and documented, tested recovery to a known secure state (CR 7.4). Limit lateral movement through segmentation and least privilege. Keep offline backups.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.3; 4-2 CR 7.4; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I06753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>59</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Theft of engineering / operational information from DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Projects, network diagrams, tag lists or historical data on DMZ Historian Replica could be exfiltrated and used to plan an attack or steal IP.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt sensitive data at rest (CR 4.1). Restrict read access by role. Monitor large exports. Classify engineering data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories; T0893 Data from Local System</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E09753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>60</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Web application vulnerabilities in DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web interface of DMZ Historian Replica could be vulnerable to injection, XSS, CSRF, path traversal or authentication bypass, leading to device takeover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply secure coding (OWASP ASVS) and input validation (CR 3.5). Use CSRF tokens, secure headers and HTTPS only. Perform web penetration testing and static analysis (4-1 SVV).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0819 Exploit Public-Facing Application; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S03753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>61</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Session hijacking on the DMZ Historian Replica web interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session tokens for DMZ Historian Replica could be stolen or fixed, allowing an attacker to act as a logged-in user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity (CR 3.8): random session IDs, secure/HttpOnly cookies, invalidate on logout. Session lock after inactivity (CR 2.5) and remote session termination (CR 2.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.8; 4-2 CR 2.5; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I07753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>62</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Verbose errors or diagnostics disclose internals of DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Error messages, stack traces or diagnostic pages from DMZ Historian Replica could reveal versions, paths or configuration useful to an attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Return error information that supports operation without exposing internals (CR 3.7). Restrict diagnostic data to authenticated users.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>63</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>DMZ Historian Replica could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>64</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on DMZ Historian Replica if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>65</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in DMZ Historian Replica, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>66</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>DMZ Historian Replica could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>67</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in DMZ Historian Replica may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>68</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves DMZ Historian Replica unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to DMZ Historian Replica could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>69</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>DMZ Historian Replica could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>70</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into DMZ Historian Replica during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into DMZ Historian Replica before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S13753ecb3d-326c-50c8-b36f-db1ea463cf82603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0b12690d3-24fc-570e-b507-4ffcd78ca3fd</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0</b:FlowGuid><b:Id>71</b:Id><b:InteractionKey>753ecb3d-326c-50c8-b36f-db1ea463cf82:603ae7de-b4f5-5e06-94d6-fc7c8c9c52c0:b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Dormant, orphaned or unrevoked accounts on DMZ Historian Replica</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Accounts of former staff, contractors, commissioning engineers or test users may remain active on DMZ Historian Replica and can be used by an attacker who obtains their credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian replication</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support account management functions: create, modify, disable and remove accounts, with expiry dates (CR 1.3, CR 1.4). Report inactive accounts. Integrate with central identity management so leavers are removed everywhere. Remove test and commissioning accounts before handover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.4; 4-2 CR 1.3; 4-2 CR 1.5</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01b12690d3-24fc-570e-b507-4ffcd78ca3fd9ed410f8-b7bc-5d9d-b44c-f0670ba88efaaac6e9a7-ade6-51eb-984d-aa1c41ac1820</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>9ed410f8-b7bc-5d9d-b44c-f0670ba88efa</b:FlowGuid><b:Id>72</b:Id><b:InteractionKey>b12690d3-24fc-570e-b507-4ffcd78ca3fd:9ed410f8-b7bc-5d9d-b44c-f0670ba88efa:aac6e9a7-ade6-51eb-984d-aa1c41ac1820</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of DMZ Historian Replica across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate DMZ Historian Replica and send traffic that Corporate IT and Billing accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Water quality reports</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b12690d3-24fc-570e-b507-4ffcd78ca3fd</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>aac6e9a7-ade6-51eb-984d-aa1c41ac1820</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T123ad9e9d2-feec-5b3e-a76b-cceff92966b761d9d761-2c22-568e-a0e5-91153c2c595feaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>61d9d761-2c22-568e-a0e5-91153c2c595f</b:FlowGuid><b:Id>73</b:Id><b:InteractionKey>3ad9e9d2-feec-5b3e-a76b-cceff92966b7:61d9d761-2c22-568e-a0e5-91153c2c595f:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of view on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Process values, alarms or status shown by SCADA Server could be falsified, so operators do not see or misjudge the real process state.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HMI to SCADA</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect integrity of data from controllers (CR 3.1). Protect HMI graphics and tag databases against modification (CR 3.4). Provide independent indications for critical variables.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0832 Manipulation of View; T1692.002 Unauthorized Message: Reporting Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D053ad9e9d2-feec-5b3e-a76b-cceff92966b761d9d761-2c22-568e-a0e5-91153c2c595feaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>61d9d761-2c22-568e-a0e5-91153c2c595f</b:FlowGuid><b:Id>74</b:Id><b:InteractionKey>3ad9e9d2-feec-5b3e-a76b-cceff92966b7:61d9d761-2c22-568e-a0e5-91153c2c595f:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Loss of view on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server could be made unavailable or frozen so operators lose visibility of the process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HMI to SCADA</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provide redundancy for essential HMI/SCADA functions. Support fast recovery from known-good images (CR 7.4). Make frozen displays detectable (heartbeat / live indicator).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0815 Denial of View; T0829 Loss of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.3; 4-2 CR 7.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Loss of production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T133ad9e9d2-feec-5b3e-a76b-cceff92966b761d9d761-2c22-568e-a0e5-91153c2c595feaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>61d9d761-2c22-568e-a0e5-91153c2c595f</b:FlowGuid><b:Id>75</b:Id><b:InteractionKey>3ad9e9d2-feec-5b3e-a76b-cceff92966b7:61d9d761-2c22-568e-a0e5-91153c2c595f:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarm suppression or modification on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Alarm limits, priorities or notifications on SCADA Server could be changed or suppressed to hide an attack or abnormal process condition.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HMI to SCADA</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict alarm configuration to authorised roles. Log and report alarm configuration changes. Monitor for unexpected alarm shelving / suppression.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T163ad9e9d2-feec-5b3e-a76b-cceff92966b761d9d761-2c22-568e-a0e5-91153c2c595feaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>61d9d761-2c22-568e-a0e5-91153c2c595f</b:FlowGuid><b:Id>76</b:Id><b:InteractionKey>3ad9e9d2-feec-5b3e-a76b-cceff92966b7:61d9d761-2c22-568e-a0e5-91153c2c595f:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Mobile code or script injection in SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Scripts, macros or mobile code (JavaScript, VBA, HMI scripts) executed by SCADA Server could be injected or modified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HMI to SCADA</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Control mobile code (SAR 2.4): allow only authorised, integrity-checked scripts. Disable scripting features that are not needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1701 Command and Scripting Interpreter; T0871 Execution through API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 SAR 2.4; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T16</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D143ad9e9d2-feec-5b3e-a76b-cceff92966b761d9d761-2c22-568e-a0e5-91153c2c595feaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>61d9d761-2c22-568e-a0e5-91153c2c595f</b:FlowGuid><b:Id>77</b:Id><b:InteractionKey>3ad9e9d2-feec-5b3e-a76b-cceff92966b7:61d9d761-2c22-568e-a0e5-91153c2c595f:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between Control Room HMI and SCADA Server blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between Control Room HMI and SCADA Server while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HMI to SCADA</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>78</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Plant Operator across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate Plant Operator and send traffic that Control Room HMI accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T01c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>79</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Adversary-in-the-middle tampering of Plant Operator to Control Room HMI traffic</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Plant Operator and Control Room HMI crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use protocol security with message integrity (OPC UA Sign/SignAndEncrypt, CIP Security, DNP3-SA, IEC 62351, TLS). Where the protocol cannot be secured, tunnel it through an authenticated, integrity-protected conduit (IPsec/TLS) and restrict paths at the zone boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0830 Adversary-in-the-Middle; T0831 Manipulation of Control; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 3-3 SR 3.1; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I01c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>80</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Sniffing of operational data between Plant Operator and Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Plant Operator and Control Room HMI is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows that cross zone boundaries where confidentiality is required (TLS, OPC UA SignAndEncrypt, IPsec tunnels). Classify data to decide where encryption is needed. Do not send credentials over unencrypted channels.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0861 Point &amp; Tag Identification; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 4.3; 3-3 SR 4.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I02c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>81</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Credentials or keys exposed on the Plant Operator to Control Room HMI flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow may carry passwords, keys or sensitive IP without encryption. Captured credentials allow an attacker to log in as a legitimate user or device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Never transmit authenticators in cleartext. Use encrypted, mutually authenticated channels. Prefer challenge-response or certificate-based authentication. Rotate any credential that has been sent in cleartext.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 1.5; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>82</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Control Room HMI are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>83</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Control Room HMI from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>84</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Control Room HMI not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Control Room HMI from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>85</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Control Room HMI reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Control Room HMI that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>86</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Control Room HMI (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Control Room HMI across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T12c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>87</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of view on Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Process values, alarms or status shown by Control Room HMI could be falsified, so operators do not see or misjudge the real process state.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect integrity of data from controllers (CR 3.1). Protect HMI graphics and tag databases against modification (CR 3.4). Provide independent indications for critical variables.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0832 Manipulation of View; T1692.002 Unauthorized Message: Reporting Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D05c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>88</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Loss of view on Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI could be made unavailable or frozen so operators lose visibility of the process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provide redundancy for essential HMI/SCADA functions. Support fast recovery from known-good images (CR 7.4). Make frozen displays detectable (heartbeat / live indicator).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0815 Denial of View; T0829 Loss of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.3; 4-2 CR 7.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Loss of production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T13c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>89</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarm suppression or modification on Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Alarm limits, priorities or notifications on Control Room HMI could be changed or suppressed to hide an attack or abnormal process condition.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict alarm configuration to authorised roles. Log and report alarm configuration changes. Monitor for unexpected alarm shelving / suppression.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E06c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>90</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Missing or weak role-based access control on Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Users of Control Room HMI could perform actions beyond their role (e.g. operators changing engineering parameters) if authorisation is not enforced per role.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Enforce role-based authorisation for all human users (CR 2.1), with least privilege and separation between operator, engineer and administrator roles. Support supervisor override for essential operations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 1.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R02c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>91</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Actions by Plant Operator on Control Room HMI cannot be attributed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Plant Operator uses shared or generic accounts on Control Room HMI, actions cannot be traced to an individual.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Uniquely identify and authenticate all human users (CR 1.1). Record user identity in audit records (CR 2.8). Use non-repudiation for critical actions where required at SL 3+ (CR 2.12).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 1.1; 4-2 CR 2.12</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T14c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>92</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware execution on Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI could be infected with malware via network, removable media, phishing or vendor tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support malware protection appropriate to the platform: application allow-listing, OS hardening or validated anti-malware (HDR/SAR 3.2). Only run signed code. Document compatible security software in the guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0863 User Execution; T1701 Command and Scripting Interpreter; T0865 Spearphishing Attachment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 3.2; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D06c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>93</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware or destructive malware disables Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware or wiper malware could encrypt or destroy Control Room HMI and its data, stopping production (e.g. NotPetya, Colonial Pipeline effects).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support backup of configuration and data (CR 7.3) and documented, tested recovery to a known secure state (CR 7.4). Limit lateral movement through segmentation and least privilege. Keep offline backups.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.3; 4-2 CR 7.4; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E07c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>94</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Exploitation of unpatched / legacy platform of Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI may run on an OS or runtime that is out of support or rarely patched, exposing known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support the product on maintained platforms. Provide a patch qualification and delivery process (4-1 SUM) and timely security updates (HDR 3.10). Define compensating countermeasures for legacy deployments in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.10; 4-1 SUM; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T16c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>95</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Mobile code or script injection in Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Scripts, macros or mobile code (JavaScript, VBA, HMI scripts) executed by Control Room HMI could be injected or modified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Control mobile code (SAR 2.4): allow only authorised, integrity-checked scripts. Disable scripting features that are not needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1701 Command and Scripting Interpreter; T0871 Execution through API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 SAR 2.4; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T16</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E10c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>96</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Kiosk / HMI break-out to the underlying OS of Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A user at Control Room HMI could escape the HMI shell (dialogs, help files, keyboard shortcuts) to the desktop and gain OS-level access.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Harden kiosk mode: block shortcuts, file dialogs and shell access. Run HMI under a least-privilege account. Apply least functionality to the host (CR 7.7).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0823 Graphical User Interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 7.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I07c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>97</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Verbose errors or diagnostics disclose internals of Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Error messages, stack traces or diagnostic pages from Control Room HMI could reveal versions, paths or configuration useful to an attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Return error information that supports operation without exposing internals (CR 3.7). Restrict diagnostic data to authenticated users.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>98</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>99</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Control Room HMI if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>100</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Control Room HMI, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>101</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>102</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Control Room HMI may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>103</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Control Room HMI unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Control Room HMI could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>104</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S08c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>105</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Impersonation of Plant Operator at Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could impersonate Plant Operator at Control Room HMI using stolen, guessed or shared credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate all human users (CR 1.1). Strong password policy (CR 1.7). MFA for privileged and remote users. Integrate with central account management (CR 1.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.3; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R07c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>106</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Operator actions by Plant Operator on Control Room HMI not journaled</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoint changes, alarm acknowledgements and shelving done by Plant Operator on Control Room HMI may not be recorded with user, old and new value and time, so a disputed or harmful operation cannot be reconstructed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Keep an operator action journal with user identity, old/new value, source station and synchronised time (CR 2.8, CR 2.11). Protect the journal from modification (CR 3.9). Make it available to incident response and the historian.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T1692.001 Unauthorized Message: Command Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 2.12; 4-2 CR 3.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>107</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between Plant Operator and Control Room HMI blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between Plant Operator and Control Room HMI while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E22c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>108</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacker tools staged on Control Room HMI to reach the control network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Control Room HMI has network access to controllers. An attacker who gets code onto it (drive-by download, script, phishing, lateral transfer from another host) could use built-in tools, scripts or API hooking to scan, move laterally and send commands as a trusted host.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use application allow-listing and block script interpreters that are not needed (HDR 3.2, SAR 2.4). Do not allow web browsing or e-mail on OT hosts (CR 5.3 person-to-person communication). Restrict outbound and lateral connections from the host. Monitor for new executables and tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0867 Lateral Tool Transfer; T0817 Drive-by Compromise; T0874 Hooking; T1701.001 Command and Scripting Interpreter: PowerShell; T0852 Screen Capture; T0840 Network Connection Enumeration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 2.4; 4-2 CR 7.7; 4-2 CR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E22</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>109</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Control Room HMI during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Control Room HMI before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S13c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b93204e57-d490-500e-8ac7-982caabc61c33ad9e9d2-feec-5b3e-a76b-cceff92966b7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>93204e57-d490-500e-8ac7-982caabc61c3</b:FlowGuid><b:Id>110</b:Id><b:InteractionKey>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b:93204e57-d490-500e-8ac7-982caabc61c3:3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Dormant, orphaned or unrevoked accounts on Control Room HMI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Accounts of former staff, contractors, commissioning engineers or test users may remain active on Control Room HMI and can be used by an attacker who obtains their credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Operator console</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support account management functions: create, modify, disable and remove accounts, with expiry dates (CR 1.3, CR 1.4). Report inactive accounts. Integrate with central identity management so leavers are removed everywhere. Remove test and commissioning accounts before handover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.4; 4-2 CR 1.3; 4-2 CR 1.5</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c4fb8d5c-2b3d-5b90-9ba4-e2ee21bb803b</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>3ad9e9d2-feec-5b3e-a76b-cceff92966b7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I06eaf8e53a-1bec-5b36-a525-2ddb2c182f5eb7a71193-024d-5a7d-94e7-35bce43e36ad753ecb3d-326c-50c8-b36f-db1ea463cf82</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>b7a71193-024d-5a7d-94e7-35bce43e36ad</b:FlowGuid><b:Id>111</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:b7a71193-024d-5a7d-94e7-35bce43e36ad:753ecb3d-326c-50c8-b36f-db1ea463cf82</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Theft of engineering / operational information from Process Historian Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Projects, network diagrams, tag lists or historical data on Process Historian Database could be exfiltrated and used to plan an attack or steal IP.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian writes</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt sensitive data at rest (CR 4.1). Restrict read access by role. Monitor large exports. Classify engineering data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories; T0893 Data from Local System</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I13eaf8e53a-1bec-5b36-a525-2ddb2c182f5eb7a71193-024d-5a7d-94e7-35bce43e36ad753ecb3d-326c-50c8-b36f-db1ea463cf82</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>b7a71193-024d-5a7d-94e7-35bce43e36ad</b:FlowGuid><b:Id>112</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:b7a71193-024d-5a7d-94e7-35bce43e36ad:753ecb3d-326c-50c8-b36f-db1ea463cf82</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Bulk exfiltration of data from Process Historian Database</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Historical process data, backups or projects in Process Historian Database could be copied out in bulk to the enterprise or Internet.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Historian writes</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt at rest (CR 4.1). Restrict read access. Use one-way replication (e.g. data diode) to the enterprise. Monitor for unusual volumes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0811 Data from Information Repositories; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>753ecb3d-326c-50c8-b36f-db1ea463cf82</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>113</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of SCADA Server across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate SCADA Server and send traffic that Chemical Dosing PLC accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>114</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Adversary-in-the-middle tampering of SCADA Server to Chemical Dosing PLC traffic</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between SCADA Server and Chemical Dosing PLC crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use protocol security with message integrity (OPC UA Sign/SignAndEncrypt, CIP Security, DNP3-SA, IEC 62351, TLS). Where the protocol cannot be secured, tunnel it through an authenticated, integrity-protected conduit (IPsec/TLS) and restrict paths at the zone boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0830 Adversary-in-the-Middle; T0831 Manipulation of Control; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 3-3 SR 3.1; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>115</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Sniffing of operational data between SCADA Server and Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between SCADA Server and Chemical Dosing PLC is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows that cross zone boundaries where confidentiality is required (TLS, OPC UA SignAndEncrypt, IPsec tunnels). Classify data to decide where encryption is needed. Do not send credentials over unencrypted channels.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0861 Point &amp; Tag Identification; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 4.3; 3-3 SR 4.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>116</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Chemical Dosing PLC are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>117</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Chemical Dosing PLC from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>118</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Chemical Dosing PLC not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Chemical Dosing PLC from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>119</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Chemical Dosing PLC reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Chemical Dosing PLC that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>120</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Chemical Dosing PLC (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Chemical Dosing PLC across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>121</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized program / logic download to Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker with network access could download modified control logic or tasking to Chemical Dosing PLC, changing how it controls the process (e.g. Stuxnet, TRITON).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for program download, online edits and forcing (CR 2.1). Support a physical or logical write-protect / run-lock. Sign or integrity-check project files (CR 3.4). Log and alarm on every logic change.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0843 Program Download; T0821 Modify Controller Tasking; T0889 Modify Program; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 3.4; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E02eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>122</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized change of operating mode on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A remote command could switch Chemical Dosing PLC between Run, Program, Remote or Test modes without authorisation, enabling logic changes or stopping control.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for mode changes. Provide a physical key switch or local confirmation for Program mode. Report the current mode to the HMI and alarm on unexpected changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0858 Change Operating Mode; T0868 Detect Operating Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D02eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>123</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Remote restart, shutdown or stop of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Protocol commands (stop CPU, reset, reboot) could be sent to Chemical Dosing PLC to halt control of the process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for stop/reset services. Make these services configurable and disabled by default where possible. Ensure outputs go to a defined safe state on stop (CR 3.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0816 Device Restart/Shutdown; T0813 Denial of Control; T0881 Service Stop</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>124</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Program upload / theft of control logic from Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could upload the program and configuration from Chemical Dosing PLC to steal know-how or study the process before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for program upload. Support know-how protection (encrypted / protected blocks). Log upload events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0845 Program Upload; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>125</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Setpoint or parameter on Chemical Dosing PLC changed to unsafe values</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Parameters, setpoints or limits on Chemical Dosing PLC could be changed to values outside the safe operating envelope.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all inputs against engineering limits (CR 3.5). Separate permissions for operator setpoints and engineering parameters. Keep hard limits in logic or in an independent safety layer, not only in the HMI.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0836 Modify Parameter; T0831 Manipulation of Control; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T05eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>126</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of I/O image or forcing of points on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could force inputs or outputs, or overwrite the I/O image, so Chemical Dosing PLC acts on false values or drives outputs directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict force and I/O override functions to authorised engineering roles. Show active forces on the HMI. Log and alarm on force events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0835 Manipulate I/O Image; T0806 Brute Force I/O</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T06eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>345</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious or modified firmware loaded on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Firmware for Chemical Dosing PLC could be replaced with a modified image that hides malicious behaviour or bricks the device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Accept only firmware signed by the product supplier and verify the signature on the device before install (CR 3.4, EDR 3.10). Prevent rollback to vulnerable versions. Require authorisation to start firmware update mode.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware; T0800 Activate Firmware Update Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-2 EDR 3.10; 4-2 EDR 3.14</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T07eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>128</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Boot process or runtime integrity of Chemical Dosing PLC bypassed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Without a verified boot chain, an attacker who can write to flash could run persistent unsigned code on Chemical Dosing PLC.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Implement secure / measured boot from a hardware root of trust (EDR 3.14). Provision supplier and asset-owner roots of trust securely (EDR 3.12, 3.13). Verify security functions at start-up (CR 3.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.001 Modify Firmware: System Firmware; T0851 Rootkit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.14; 4-2 EDR 3.12; 4-2 EDR 3.13; 4-2 CR 3.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>129</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Chemical Dosing PLC outputs not driven to a safe state when attacked or failing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Chemical Dosing PLC is overloaded, crashes or loses communication, its outputs may hold an unsafe state or behave unpredictably.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Define deterministic fail-safe output behaviour (CR 3.6) and safe error handling (CR 3.7). Use communication watchdogs. Test behaviour under network storms and malformed traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0813 Denial of Control; T0826 Loss of Availability; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.6; 4-2 CR 3.7; 4-2 CR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>130</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network load disturbs the scan cycle of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Communication processing on Chemical Dosing PLC may share CPU with the control task, so heavy or malformed traffic could increase scan time and miss control deadlines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Prioritise the control task over communication (CR 7.2 resource management). Limit connections and request rates. Test with load and robustness testing at all supported SLs.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>131</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Debug or service interface on Chemical Dosing PLC gives privileged access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>JTAG, UART consoles, USB service ports or test modes on Chemical Dosing PLC could give root access, bypass authentication or dump firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable or lock debug interfaces in production (EDR/HDR/NDR 2.13). Protect service ports with authentication. Document any remaining interfaces in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 2.13; 4-2 HDR 2.13; 4-2 NDR 2.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I05eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>132</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Extraction of keys or credentials from Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keys, certificates or passwords stored on Chemical Dosing PLC could be read from flash or memory, letting an attacker impersonate the device or decrypt traffic from many devices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Store private keys in a secure element / TPM or protected memory. Use unique keys per device, never fleet-wide secrets. Erase secrets on decommissioning (CR 4.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.002 Insecure Credentials: Hardcoded Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 1.5; 4-2 CR 4.2; 4-2 EDR 3.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T13eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>133</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarm suppression or modification on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Alarm limits, priorities or notifications on Chemical Dosing PLC could be changed or suppressed to hide an attack or abnormal process condition.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict alarm configuration to authorised roles. Log and report alarm configuration changes. Monitor for unexpected alarm shelving / suppression.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E09eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>134</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Web application vulnerabilities in Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web interface of Chemical Dosing PLC could be vulnerable to injection, XSS, CSRF, path traversal or authentication bypass, leading to device takeover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply secure coding (OWASP ASVS) and input validation (CR 3.5). Use CSRF tokens, secure headers and HTTPS only. Perform web penetration testing and static analysis (4-1 SVV).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0819 Exploit Public-Facing Application; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>135</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Session hijacking on the Chemical Dosing PLC web interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session tokens for Chemical Dosing PLC could be stolen or fixed, allowing an attacker to act as a logged-in user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity (CR 3.8): random session IDs, secure/HttpOnly cookies, invalidate on logout. Session lock after inactivity (CR 2.5) and remote session termination (CR 2.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.8; 4-2 CR 2.5; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I07eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>136</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Verbose errors or diagnostics disclose internals of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Error messages, stack traces or diagnostic pages from Chemical Dosing PLC could reveal versions, paths or configuration useful to an attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Return error information that supports operation without exposing internals (CR 3.7). Restrict diagnostic data to authenticated users.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>137</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>138</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Chemical Dosing PLC if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>139</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Chemical Dosing PLC, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>140</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>141</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Chemical Dosing PLC may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T18eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>142</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Counterfeit device or tampering of Chemical Dosing PLC before delivery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could be counterfeited or tampered with during manufacturing, shipping or provisioning, including injection of attacker-controlled keys.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provision product-supplier roots of trust in a controlled environment (EDR/NDR 3.12) and let the asset owner provision their own (3.13). Provide device identity certificates and genuineness checks. Use tamper-evident packaging.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.12; 4-2 EDR 3.13; 4-1 SM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T19eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>143</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Chemical Dosing PLC disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Chemical Dosing PLC without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>144</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Chemical Dosing PLC unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Chemical Dosing PLC could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>145</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R06eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>146</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Local audit trail on Chemical Dosing PLC lost, overwritten or cleared</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot Chemical Dosing PLC so evidence held in volatile memory is lost.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect audit records against deletion (CR 3.9) and keep them across restarts. Forward events in near real time to a central collector (CR 6.1, syslog over TLS). Warn when audit capacity is nearly used (CR 2.9). Record clearing of the log as an audit event itself.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.9; 4-2 CR 2.9; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Detection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>147</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between SCADA Server and Chemical Dosing PLC blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between SCADA Server and Chemical Dosing PLC while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I15eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>148</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Process state and I/O image read from Chemical Dosing PLC by an unauthorised client</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for read services as well as writes where the protocol allows (CR 2.1). Allow-list client addresses. Expose only required tags. Detect unexpected polling clients at the conduit or with network monitoring (CR 6.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0801 Monitor Process State; T0877 I/O Image; T0861 Point &amp; Tag Identification; T0802 Automated Collection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 4.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement; Confidentiality / IP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28eaf8e53a-1bec-5b36-a525-2ddb2c182f5ed346cc03-97fc-59b6-9017-97d1415b7417c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d346cc03-97fc-59b6-9017-97d1415b7417</b:FlowGuid><b:Id>149</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:d346cc03-97fc-59b6-9017-97d1415b7417:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Chemical Dosing PLC during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Chemical Dosing PLC before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing setpoints</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>150</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Chemical Dosing PLC across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate Chemical Dosing PLC and send traffic that SCADA Server accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T01c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>151</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Adversary-in-the-middle tampering of Chemical Dosing PLC to SCADA Server traffic</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Chemical Dosing PLC and SCADA Server crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use protocol security with message integrity (OPC UA Sign/SignAndEncrypt, CIP Security, DNP3-SA, IEC 62351, TLS). Where the protocol cannot be secured, tunnel it through an authenticated, integrity-protected conduit (IPsec/TLS) and restrict paths at the zone boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0830 Adversary-in-the-Middle; T0831 Manipulation of Control; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 3-3 SR 3.1; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I01c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>152</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Sniffing of operational data between Chemical Dosing PLC and SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Chemical Dosing PLC and SCADA Server is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows that cross zone boundaries where confidentiality is required (TLS, OPC UA SignAndEncrypt, IPsec tunnels). Classify data to decide where encryption is needed. Do not send credentials over unencrypted channels.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0861 Point &amp; Tag Identification; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 4.3; 3-3 SR 4.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>153</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of SCADA Server from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>154</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on SCADA Server not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach SCADA Server from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>155</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on SCADA Server reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on SCADA Server that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>156</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of SCADA Server (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query SCADA Server across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T12c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>157</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of view on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Process values, alarms or status shown by SCADA Server could be falsified, so operators do not see or misjudge the real process state.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect integrity of data from controllers (CR 3.1). Protect HMI graphics and tag databases against modification (CR 3.4). Provide independent indications for critical variables.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0832 Manipulation of View; T1692.002 Unauthorized Message: Reporting Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D05c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>158</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Loss of view on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server could be made unavailable or frozen so operators lose visibility of the process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provide redundancy for essential HMI/SCADA functions. Support fast recovery from known-good images (CR 7.4). Make frozen displays detectable (heartbeat / live indicator).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0815 Denial of View; T0829 Loss of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.3; 4-2 CR 7.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of view; Loss of production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T13c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>159</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarm suppression or modification on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Alarm limits, priorities or notifications on SCADA Server could be changed or suppressed to hide an attack or abnormal process condition.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict alarm configuration to authorised roles. Log and report alarm configuration changes. Monitor for unexpected alarm shelving / suppression.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E06c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>160</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Missing or weak role-based access control on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Users of SCADA Server could perform actions beyond their role (e.g. operators changing engineering parameters) if authorisation is not enforced per role.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Enforce role-based authorisation for all human users (CR 2.1), with least privilege and separation between operator, engineer and administrator roles. Support supervisor override for essential operations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 1.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T14c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>161</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware execution on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server could be infected with malware via network, removable media, phishing or vendor tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support malware protection appropriate to the platform: application allow-listing, OS hardening or validated anti-malware (HDR/SAR 3.2). Only run signed code. Document compatible security software in the guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0863 User Execution; T1701 Command and Scripting Interpreter; T0865 Spearphishing Attachment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 3.2; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D06c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>162</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware or destructive malware disables SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware or wiper malware could encrypt or destroy SCADA Server and its data, stopping production (e.g. NotPetya, Colonial Pipeline effects).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support backup of configuration and data (CR 7.3) and documented, tested recovery to a known secure state (CR 7.4). Limit lateral movement through segmentation and least privilege. Keep offline backups.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.3; 4-2 CR 7.4; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T16c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>163</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Mobile code or script injection in SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Scripts, macros or mobile code (JavaScript, VBA, HMI scripts) executed by SCADA Server could be injected or modified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Control mobile code (SAR 2.4): allow only authorised, integrity-checked scripts. Disable scripting features that are not needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1701 Command and Scripting Interpreter; T0871 Execution through API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 SAR 2.4; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T16</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I07c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>164</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Verbose errors or diagnostics disclose internals of SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Error messages, stack traces or diagnostic pages from SCADA Server could reveal versions, paths or configuration useful to an attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Return error information that supports operation without exposing internals (CR 3.7). Restrict diagnostic data to authenticated users.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>165</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>166</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on SCADA Server if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>167</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in SCADA Server, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>168</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>169</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in SCADA Server may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>170</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves SCADA Server unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to SCADA Server could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>171</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E22c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>172</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacker tools staged on SCADA Server to reach the control network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SCADA Server has network access to controllers. An attacker who gets code onto it (drive-by download, script, phishing, lateral transfer from another host) could use built-in tools, scripts or API hooking to scan, move laterally and send commands as a trusted host.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use application allow-listing and block script interpreters that are not needed (HDR 3.2, SAR 2.4). Do not allow web browsing or e-mail on OT hosts (CR 5.3 person-to-person communication). Restrict outbound and lateral connections from the host. Monitor for new executables and tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0867 Lateral Tool Transfer; T0817 Drive-by Compromise; T0874 Hooking; T1701.001 Command and Scripting Interpreter: PowerShell; T0852 Screen Capture; T0840 Network Connection Enumeration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 2.4; 4-2 CR 7.7; 4-2 CR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E22</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>173</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into SCADA Server during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into SCADA Server before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S13c20135fd-8d83-5b79-8788-20d5eb886ff2d65b90bc-e141-5eb1-8941-52e3df57a957eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>d65b90bc-e141-5eb1-8941-52e3df57a957</b:FlowGuid><b:Id>174</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:d65b90bc-e141-5eb1-8941-52e3df57a957:eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Dormant, orphaned or unrevoked accounts on SCADA Server</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Accounts of former staff, contractors, commissioning engineers or test users may remain active on SCADA Server and can be used by an attacker who obtains their credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Dosing status</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support account management functions: create, modify, disable and remove accounts, with expiry dates (CR 1.3, CR 1.4). Report inactive accounts. Integrate with central identity management so leavers are removed everywhere. Remove test and commissioning accounts before handover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.4; 4-2 CR 1.3; 4-2 CR 1.5</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>175</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of SCADA Server across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate SCADA Server and send traffic that Filtration PLC accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>176</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Adversary-in-the-middle tampering of SCADA Server to Filtration PLC traffic</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between SCADA Server and Filtration PLC crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use protocol security with message integrity (OPC UA Sign/SignAndEncrypt, CIP Security, DNP3-SA, IEC 62351, TLS). Where the protocol cannot be secured, tunnel it through an authenticated, integrity-protected conduit (IPsec/TLS) and restrict paths at the zone boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0830 Adversary-in-the-Middle; T0831 Manipulation of Control; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 3-3 SR 3.1; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>177</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Sniffing of operational data between SCADA Server and Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between SCADA Server and Filtration PLC is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows that cross zone boundaries where confidentiality is required (TLS, OPC UA SignAndEncrypt, IPsec tunnels). Classify data to decide where encryption is needed. Do not send credentials over unencrypted channels.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0861 Point &amp; Tag Identification; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 4.3; 3-3 SR 4.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>178</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Filtration PLC are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>179</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Filtration PLC from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Filtration PLC receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>180</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Filtration PLC not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Filtration PLC from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>181</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Filtration PLC reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Filtration PLC that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>182</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Filtration PLC (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Filtration PLC across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>183</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized program / logic download to Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker with network access could download modified control logic or tasking to Filtration PLC, changing how it controls the process (e.g. Stuxnet, TRITON).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for program download, online edits and forcing (CR 2.1). Support a physical or logical write-protect / run-lock. Sign or integrity-check project files (CR 3.4). Log and alarm on every logic change.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0843 Program Download; T0821 Modify Controller Tasking; T0889 Modify Program; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 3.4; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E02eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>184</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized change of operating mode on Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A remote command could switch Filtration PLC between Run, Program, Remote or Test modes without authorisation, enabling logic changes or stopping control.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for mode changes. Provide a physical key switch or local confirmation for Program mode. Report the current mode to the HMI and alarm on unexpected changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0858 Change Operating Mode; T0868 Detect Operating Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D02eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>185</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Remote restart, shutdown or stop of Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Protocol commands (stop CPU, reset, reboot) could be sent to Filtration PLC to halt control of the process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for stop/reset services. Make these services configurable and disabled by default where possible. Ensure outputs go to a defined safe state on stop (CR 3.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0816 Device Restart/Shutdown; T0813 Denial of Control; T0881 Service Stop</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>186</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Program upload / theft of control logic from Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could upload the program and configuration from Filtration PLC to steal know-how or study the process before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for program upload. Support know-how protection (encrypted / protected blocks). Log upload events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0845 Program Upload; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>187</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Setpoint or parameter on Filtration PLC changed to unsafe values</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Parameters, setpoints or limits on Filtration PLC could be changed to values outside the safe operating envelope.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all inputs against engineering limits (CR 3.5). Separate permissions for operator setpoints and engineering parameters. Keep hard limits in logic or in an independent safety layer, not only in the HMI.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0836 Modify Parameter; T0831 Manipulation of Control; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T05eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>188</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of I/O image or forcing of points on Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could force inputs or outputs, or overwrite the I/O image, so Filtration PLC acts on false values or drives outputs directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict force and I/O override functions to authorised engineering roles. Show active forces on the HMI. Log and alarm on force events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0835 Manipulate I/O Image; T0806 Brute Force I/O</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T06eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>189</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious or modified firmware loaded on Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Firmware for Filtration PLC could be replaced with a modified image that hides malicious behaviour or bricks the device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Accept only firmware signed by the product supplier and verify the signature on the device before install (CR 3.4, EDR 3.10). Prevent rollback to vulnerable versions. Require authorisation to start firmware update mode.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware; T0800 Activate Firmware Update Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-2 EDR 3.10; 4-2 EDR 3.14</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T07eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>190</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Boot process or runtime integrity of Filtration PLC bypassed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Without a verified boot chain, an attacker who can write to flash could run persistent unsigned code on Filtration PLC.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Implement secure / measured boot from a hardware root of trust (EDR 3.14). Provision supplier and asset-owner roots of trust securely (EDR 3.12, 3.13). Verify security functions at start-up (CR 3.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.001 Modify Firmware: System Firmware; T0851 Rootkit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.14; 4-2 EDR 3.12; 4-2 EDR 3.13; 4-2 CR 3.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>191</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Filtration PLC outputs not driven to a safe state when attacked or failing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Filtration PLC is overloaded, crashes or loses communication, its outputs may hold an unsafe state or behave unpredictably.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Define deterministic fail-safe output behaviour (CR 3.6) and safe error handling (CR 3.7). Use communication watchdogs. Test behaviour under network storms and malformed traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0813 Denial of Control; T0826 Loss of Availability; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.6; 4-2 CR 3.7; 4-2 CR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>192</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network load disturbs the scan cycle of Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Communication processing on Filtration PLC may share CPU with the control task, so heavy or malformed traffic could increase scan time and miss control deadlines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Prioritise the control task over communication (CR 7.2 resource management). Limit connections and request rates. Test with load and robustness testing at all supported SLs.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E03eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>193</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Debug or service interface on Filtration PLC gives privileged access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>JTAG, UART consoles, USB service ports or test modes on Filtration PLC could give root access, bypass authentication or dump firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable or lock debug interfaces in production (EDR/HDR/NDR 2.13). Protect service ports with authentication. Document any remaining interfaces in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 2.13; 4-2 HDR 2.13; 4-2 NDR 2.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I05eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>194</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Extraction of keys or credentials from Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keys, certificates or passwords stored on Filtration PLC could be read from flash or memory, letting an attacker impersonate the device or decrypt traffic from many devices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Store private keys in a secure element / TPM or protected memory. Use unique keys per device, never fleet-wide secrets. Erase secrets on decommissioning (CR 4.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.002 Insecure Credentials: Hardcoded Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 1.5; 4-2 CR 4.2; 4-2 EDR 3.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T13eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>195</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarm suppression or modification on Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Alarm limits, priorities or notifications on Filtration PLC could be changed or suppressed to hide an attack or abnormal process condition.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict alarm configuration to authorised roles. Log and report alarm configuration changes. Monitor for unexpected alarm shelving / suppression.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>196</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Filtration PLC could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>197</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Filtration PLC if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>198</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Filtration PLC, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>199</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Filtration PLC could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>200</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Filtration PLC may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T18eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>201</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Counterfeit device or tampering of Filtration PLC before delivery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Filtration PLC could be counterfeited or tampered with during manufacturing, shipping or provisioning, including injection of attacker-controlled keys.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provision product-supplier roots of trust in a controlled environment (EDR/NDR 3.12) and let the asset owner provision their own (3.13). Provide device identity certificates and genuineness checks. Use tamper-evident packaging.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.12; 4-2 EDR 3.13; 4-1 SM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T19eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>202</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Filtration PLC disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Filtration PLC without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>203</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Filtration PLC unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Filtration PLC could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>204</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Filtration PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Filtration PLC could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R06eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>205</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Local audit trail on Filtration PLC lost, overwritten or cleared</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot Filtration PLC so evidence held in volatile memory is lost.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect audit records against deletion (CR 3.9) and keep them across restarts. Forward events in near real time to a central collector (CR 6.1, syslog over TLS). Warn when audit capacity is nearly used (CR 2.9). Record clearing of the log as an audit event itself.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.9; 4-2 CR 2.9; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Detection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>206</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between SCADA Server and Filtration PLC blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between SCADA Server and Filtration PLC while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I15eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>207</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Process state and I/O image read from Filtration PLC by an unauthorised client</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Filtration PLC answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for read services as well as writes where the protocol allows (CR 2.1). Allow-list client addresses. Expose only required tags. Detect unexpected polling clients at the conduit or with network monitoring (CR 6.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0801 Monitor Process State; T0877 I/O Image; T0861 Point &amp; Tag Identification; T0802 Automated Collection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 4.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement; Confidentiality / IP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28eaf8e53a-1bec-5b36-a525-2ddb2c182f5ee5438ec0-b184-5d08-b6df-aaf565c7a5b39438157a-5179-5cff-8ad8-ef234805e8df</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>e5438ec0-b184-5d08-b6df-aaf565c7a5b3</b:FlowGuid><b:Id>208</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:e5438ec0-b184-5d08-b6df-aaf565c7a5b3:9438157a-5179-5cff-8ad8-ef234805e8df</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Filtration PLC during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Filtration PLC before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Filtration control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9438157a-5179-5cff-8ad8-ef234805e8df</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>209</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Engineering Workstation across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate Engineering Workstation and send traffic that Chemical Dosing PLC accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T01c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>210</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Adversary-in-the-middle tampering of Engineering Workstation to Chemical Dosing PLC traffic</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Engineering Workstation and Chemical Dosing PLC crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use protocol security with message integrity (OPC UA Sign/SignAndEncrypt, CIP Security, DNP3-SA, IEC 62351, TLS). Where the protocol cannot be secured, tunnel it through an authenticated, integrity-protected conduit (IPsec/TLS) and restrict paths at the zone boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0830 Adversary-in-the-Middle; T0831 Manipulation of Control; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 3-3 SR 3.1; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I01c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>211</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Sniffing of operational data between Engineering Workstation and Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between Engineering Workstation and Chemical Dosing PLC is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows that cross zone boundaries where confidentiality is required (TLS, OPC UA SignAndEncrypt, IPsec tunnels). Classify data to decide where encryption is needed. Do not send credentials over unencrypted channels.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0861 Point &amp; Tag Identification; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 4.3; 3-3 SR 4.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I02c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>212</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Credentials or keys exposed on the Engineering Workstation to Chemical Dosing PLC flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow may carry passwords, keys or sensitive IP without encryption. Captured credentials allow an attacker to log in as a legitimate user or device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Never transmit authenticators in cleartext. Use encrypted, mutually authenticated channels. Prefer challenge-response or certificate-based authentication. Rotate any credential that has been sent in cleartext.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 1.5; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>213</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Chemical Dosing PLC are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>214</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Chemical Dosing PLC from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>215</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Chemical Dosing PLC not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Chemical Dosing PLC from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>216</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Chemical Dosing PLC reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Chemical Dosing PLC that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>217</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Chemical Dosing PLC (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Chemical Dosing PLC across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T03c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>218</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized program / logic download to Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker with network access could download modified control logic or tasking to Chemical Dosing PLC, changing how it controls the process (e.g. Stuxnet, TRITON).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for program download, online edits and forcing (CR 2.1). Support a physical or logical write-protect / run-lock. Sign or integrity-check project files (CR 3.4). Log and alarm on every logic change.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0843 Program Download; T0821 Modify Controller Tasking; T0889 Modify Program; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 3.4; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E02c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>219</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized change of operating mode on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A remote command could switch Chemical Dosing PLC between Run, Program, Remote or Test modes without authorisation, enabling logic changes or stopping control.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for mode changes. Provide a physical key switch or local confirmation for Program mode. Report the current mode to the HMI and alarm on unexpected changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0858 Change Operating Mode; T0868 Detect Operating Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D02c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>220</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Remote restart, shutdown or stop of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Protocol commands (stop CPU, reset, reboot) could be sent to Chemical Dosing PLC to halt control of the process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for stop/reset services. Make these services configurable and disabled by default where possible. Ensure outputs go to a defined safe state on stop (CR 3.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0816 Device Restart/Shutdown; T0813 Denial of Control; T0881 Service Stop</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I04c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>221</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Program upload / theft of control logic from Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could upload the program and configuration from Chemical Dosing PLC to steal know-how or study the process before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for program upload. Support know-how protection (encrypted / protected blocks). Log upload events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0845 Program Upload; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T04c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>222</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Setpoint or parameter on Chemical Dosing PLC changed to unsafe values</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Parameters, setpoints or limits on Chemical Dosing PLC could be changed to values outside the safe operating envelope.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all inputs against engineering limits (CR 3.5). Separate permissions for operator setpoints and engineering parameters. Keep hard limits in logic or in an independent safety layer, not only in the HMI.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0836 Modify Parameter; T0831 Manipulation of Control; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T05c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>223</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of I/O image or forcing of points on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could force inputs or outputs, or overwrite the I/O image, so Chemical Dosing PLC acts on false values or drives outputs directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict force and I/O override functions to authorised engineering roles. Show active forces on the HMI. Log and alarm on force events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0835 Manipulate I/O Image; T0806 Brute Force I/O</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T06c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>224</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious or modified firmware loaded on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Firmware for Chemical Dosing PLC could be replaced with a modified image that hides malicious behaviour or bricks the device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Accept only firmware signed by the product supplier and verify the signature on the device before install (CR 3.4, EDR 3.10). Prevent rollback to vulnerable versions. Require authorisation to start firmware update mode.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware; T0800 Activate Firmware Update Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-2 EDR 3.10; 4-2 EDR 3.14</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T07c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>225</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Boot process or runtime integrity of Chemical Dosing PLC bypassed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Without a verified boot chain, an attacker who can write to flash could run persistent unsigned code on Chemical Dosing PLC.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Implement secure / measured boot from a hardware root of trust (EDR 3.14). Provision supplier and asset-owner roots of trust securely (EDR 3.12, 3.13). Verify security functions at start-up (CR 3.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.001 Modify Firmware: System Firmware; T0851 Rootkit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.14; 4-2 EDR 3.12; 4-2 EDR 3.13; 4-2 CR 3.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D03c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>226</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Chemical Dosing PLC outputs not driven to a safe state when attacked or failing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Chemical Dosing PLC is overloaded, crashes or loses communication, its outputs may hold an unsafe state or behave unpredictably.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Define deterministic fail-safe output behaviour (CR 3.6) and safe error handling (CR 3.7). Use communication watchdogs. Test behaviour under network storms and malformed traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0813 Denial of Control; T0826 Loss of Availability; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.6; 4-2 CR 3.7; 4-2 CR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D04c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>227</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network load disturbs the scan cycle of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Communication processing on Chemical Dosing PLC may share CPU with the control task, so heavy or malformed traffic could increase scan time and miss control deadlines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Prioritise the control task over communication (CR 7.2 resource management). Limit connections and request rates. Test with load and robustness testing at all supported SLs.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E03c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>228</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Debug or service interface on Chemical Dosing PLC gives privileged access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>JTAG, UART consoles, USB service ports or test modes on Chemical Dosing PLC could give root access, bypass authentication or dump firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable or lock debug interfaces in production (EDR/HDR/NDR 2.13). Protect service ports with authentication. Document any remaining interfaces in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 2.13; 4-2 HDR 2.13; 4-2 NDR 2.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I05c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>229</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Extraction of keys or credentials from Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Keys, certificates or passwords stored on Chemical Dosing PLC could be read from flash or memory, letting an attacker impersonate the device or decrypt traffic from many devices.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Store private keys in a secure element / TPM or protected memory. Use unique keys per device, never fleet-wide secrets. Erase secrets on decommissioning (CR 4.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.002 Insecure Credentials: Hardcoded Credentials; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 1.5; 4-2 CR 4.2; 4-2 EDR 3.11</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T13c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>230</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarm suppression or modification on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Alarm limits, priorities or notifications on Chemical Dosing PLC could be changed or suppressed to hide an attack or abnormal process condition.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict alarm configuration to authorised roles. Log and report alarm configuration changes. Monitor for unexpected alarm shelving / suppression.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E08c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>231</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Compromised Engineering Workstation used to control Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation holds the privileges to program and configure Chemical Dosing PLC. If it is compromised, an attacker inherits full control over the controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Make Chemical Dosing PLC authenticate the engineering tool and user, not only the network address (CR 1.2, CR 1.1). Require re-authentication for critical operations. Harden and isolate engineering workstations; connect them only when needed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0843 Program Download; T0886 Remote Services; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.2; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E09c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>232</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Web application vulnerabilities in Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web interface of Chemical Dosing PLC could be vulnerable to injection, XSS, CSRF, path traversal or authentication bypass, leading to device takeover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply secure coding (OWASP ASVS) and input validation (CR 3.5). Use CSRF tokens, secure headers and HTTPS only. Perform web penetration testing and static analysis (4-1 SVV).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0819 Exploit Public-Facing Application; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S03c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>233</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Session hijacking on the Chemical Dosing PLC web interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session tokens for Chemical Dosing PLC could be stolen or fixed, allowing an attacker to act as a logged-in user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity (CR 3.8): random session IDs, secure/HttpOnly cookies, invalidate on logout. Session lock after inactivity (CR 2.5) and remote session termination (CR 2.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.8; 4-2 CR 2.5; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I07c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>234</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Verbose errors or diagnostics disclose internals of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Error messages, stack traces or diagnostic pages from Chemical Dosing PLC could reveal versions, paths or configuration useful to an attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Return error information that supports operation without exposing internals (CR 3.7). Restrict diagnostic data to authenticated users.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>235</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>236</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Chemical Dosing PLC if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>237</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Chemical Dosing PLC, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>238</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>239</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Chemical Dosing PLC may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T18c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>240</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Counterfeit device or tampering of Chemical Dosing PLC before delivery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could be counterfeited or tampered with during manufacturing, shipping or provisioning, including injection of attacker-controlled keys.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provision product-supplier roots of trust in a controlled environment (EDR/NDR 3.12) and let the asset owner provision their own (3.13). Provide device identity certificates and genuineness checks. Use tamper-evident packaging.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.12; 4-2 EDR 3.13; 4-1 SM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T19c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>241</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Chemical Dosing PLC disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Chemical Dosing PLC without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>242</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Chemical Dosing PLC unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Chemical Dosing PLC could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>243</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R05c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>244</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Logic or configuration changes on Chemical Dosing PLC cannot be proven or reconstructed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Program downloads, online edits and parameter changes made on Chemical Dosing PLC by Engineering Workstation may not be recorded with who made them, what changed and when. After an incident it cannot be shown whether a change was authorised, accidental or malicious.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Record every logic, configuration and firmware change with user identity, timestamp and a before/after hash or version (CR 2.8). Keep a change history on the device or engineering server. Support non-repudiation for critical changes at SL 3 and above (CR 2.12). Compare running logic with the approved baseline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0889 Modify Program; T0843 Program Download; T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.12; 4-2 CR 2.8; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance; Safety case</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R06c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>245</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Local audit trail on Chemical Dosing PLC lost, overwritten or cleared</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot Chemical Dosing PLC so evidence held in volatile memory is lost.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect audit records against deletion (CR 3.9) and keep them across restarts. Forward events in near real time to a central collector (CR 6.1, syslog over TLS). Warn when audit capacity is nearly used (CR 2.9). Record clearing of the log as an audit event itself.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.9; 4-2 CR 2.9; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Detection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>246</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between Engineering Workstation and Chemical Dosing PLC blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between Engineering Workstation and Chemical Dosing PLC while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I15c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>247</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Process state and I/O image read from Chemical Dosing PLC by an unauthorised client</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chemical Dosing PLC answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for read services as well as writes where the protocol allows (CR 2.1). Allow-list client addresses. Expose only required tags. Detect unexpected polling clients at the conduit or with network monitoring (CR 6.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0801 Monitor Process State; T0877 I/O Image; T0861 Point &amp; Tag Identification; T0802 Automated Collection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 4.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement; Confidentiality / IP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28c867056e-76ca-5c53-b608-d9f8bef3e0ef86e3b837-63e4-573f-a315-ab7a540b4a6fc20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>86e3b837-63e4-573f-a315-ab7a540b4a6f</b:FlowGuid><b:Id>248</b:Id><b:InteractionKey>c867056e-76ca-5c53-b608-d9f8bef3e0ef:86e3b837-63e4-573f-a315-ab7a540b4a6f:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Chemical Dosing PLC during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Chemical Dosing PLC before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>PLC programming</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>249</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of USB Media and Contractor Laptop across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate USB Media and Contractor Laptop and send traffic that Engineering Workstation accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T01554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>250</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Adversary-in-the-middle tampering of USB Media and Contractor Laptop to Engineering Workstation traffic</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between USB Media and Contractor Laptop and Engineering Workstation crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use protocol security with message integrity (OPC UA Sign/SignAndEncrypt, CIP Security, DNP3-SA, IEC 62351, TLS). Where the protocol cannot be secured, tunnel it through an authenticated, integrity-protected conduit (IPsec/TLS) and restrict paths at the zone boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0830 Adversary-in-the-Middle; T0831 Manipulation of Control; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 3-3 SR 3.1; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I01554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>251</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Sniffing of operational data between USB Media and Contractor Laptop and Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between USB Media and Contractor Laptop and Engineering Workstation is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows that cross zone boundaries where confidentiality is required (TLS, OPC UA SignAndEncrypt, IPsec tunnels). Classify data to decide where encryption is needed. Do not send credentials over unencrypted channels.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0861 Point &amp; Tag Identification; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 4.3; 3-3 SR 4.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>252</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Engineering Workstation are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>253</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Engineering Workstation from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>254</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Engineering Workstation not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Engineering Workstation from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>255</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Engineering Workstation reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Engineering Workstation that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>256</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Engineering Workstation (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Engineering Workstation across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E03554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>257</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Debug or service interface on Engineering Workstation gives privileged access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>JTAG, UART consoles, USB service ports or test modes on Engineering Workstation could give root access, bypass authentication or dump firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable or lock debug interfaces in production (EDR/HDR/NDR 2.13). Protect service ports with authentication. Document any remaining interfaces in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 2.13; 4-2 HDR 2.13; 4-2 NDR 2.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E06554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>258</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Missing or weak role-based access control on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Users of Engineering Workstation could perform actions beyond their role (e.g. operators changing engineering parameters) if authorisation is not enforced per role.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Enforce role-based authorisation for all human users (CR 2.1), with least privilege and separation between operator, engineer and administrator roles. Support supervisor override for essential operations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T0890 Exploitation for Privilege Escalation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 1.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T14554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>259</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware execution on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could be infected with malware via network, removable media, phishing or vendor tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support malware protection appropriate to the platform: application allow-listing, OS hardening or validated anti-malware (HDR/SAR 3.2). Only run signed code. Document compatible security software in the guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0863 User Execution; T1701 Command and Scripting Interpreter; T0865 Spearphishing Attachment</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 3.2; 4-2 CR 3.4</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D06554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>260</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Ransomware or destructive malware disables Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ransomware or wiper malware could encrypt or destroy Engineering Workstation and its data, stopping production (e.g. NotPetya, Colonial Pipeline effects).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support backup of configuration and data (CR 7.3) and documented, tested recovery to a known secure state (CR 7.4). Limit lateral movement through segmentation and least privilege. Keep offline backups.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0809 Data Destruction; T0828 Loss of Productivity and Revenue; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.3; 4-2 CR 7.4; 3-3 SR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Financial</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T15554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>261</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Project file infection via Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering projects handled by Engineering Workstation could be infected or modified so malicious logic is downloaded to controllers.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Integrity-protect project files (signatures / hashes, CR 3.4). Show differences before download. Validate project files on open. Keep engineering tools patched and isolated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0873 Project File Infection; T0889 Modify Program</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-2 SAR 3.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I06554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>262</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Theft of engineering / operational information from Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Projects, network diagrams, tag lists or historical data on Engineering Workstation could be exfiltrated and used to plan an attack or steal IP.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt sensitive data at rest (CR 4.1). Restrict read access by role. Monitor large exports. Classify engineering data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0882 Theft of Operational Information; T0811 Data from Information Repositories; T0893 Data from Local System</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>263</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>264</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Engineering Workstation if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>265</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Engineering Workstation, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>266</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>267</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Engineering Workstation may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T19554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>268</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Engineering Workstation disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Engineering Workstation without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>269</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Engineering Workstation unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Engineering Workstation could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>270</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T22554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>271</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malware introduced into Engineering Workstation via removable media or transient device</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>USB drives, SD cards or maintenance laptops connected to Engineering Workstation could carry malware (e.g. Stuxnet).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable autorun. Restrict or disable USB ports (CR 7.7). Scan media at a kiosk before use. Accept only signed files. Control portable and mobile devices (SR 2.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0847 Replication Through Removable Media; T0864 Transient Cyber Asset; T0895 Autorun Image</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.2; 4-2 HDR 3.2; 4-2 CR 7.7; 3-3 SR 2.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T22</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>272</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between USB Media and Contractor Laptop and Engineering Workstation blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between USB Media and Contractor Laptop and Engineering Workstation while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E22554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>273</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Attacker tools staged on Engineering Workstation to reach the control network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Engineering Workstation has network access to controllers. An attacker who gets code onto it (drive-by download, script, phishing, lateral transfer from another host) could use built-in tools, scripts or API hooking to scan, move laterally and send commands as a trusted host.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use application allow-listing and block script interpreters that are not needed (HDR 3.2, SAR 2.4). Do not allow web browsing or e-mail on OT hosts (CR 5.3 person-to-person communication). Restrict outbound and lateral connections from the host. Monitor for new executables and tools.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0867 Lateral Tool Transfer; T0817 Drive-by Compromise; T0874 Hooking; T1701.001 Command and Scripting Interpreter: PowerShell; T0852 Screen Capture; T0840 Network Connection Enumeration</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 HDR 3.2; 4-2 SAR 2.4; 4-2 CR 7.7; 4-2 CR 5.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E22</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>274</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Engineering Workstation during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Engineering Workstation before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S13554464ab-9005-5347-ba38-5e4fd048a9f43f71274b-527f-5c8e-b2de-b425b8aa4c92c867056e-76ca-5c53-b608-d9f8bef3e0ef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3f71274b-527f-5c8e-b2de-b425b8aa4c92</b:FlowGuid><b:Id>275</b:Id><b:InteractionKey>554464ab-9005-5347-ba38-5e4fd048a9f4:3f71274b-527f-5c8e-b2de-b425b8aa4c92:c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Dormant, orphaned or unrevoked accounts on Engineering Workstation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Accounts of former staff, contractors, commissioning engineers or test users may remain active on Engineering Workstation and can be used by an attacker who obtains their credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Files and project transfer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support account management functions: create, modify, disable and remove accounts, with expiry dates (CR 1.3, CR 1.4). Report inactive accounts. Integrate with central identity management so leavers are removed everywhere. Remove test and commissioning accounts before handover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts; T1694.001 Insecure Credentials: Default Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.4; 4-2 CR 1.3; 4-2 CR 1.5</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>554464ab-9005-5347-ba38-5e4fd048a9f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c867056e-76ca-5c53-b608-d9f8bef3e0ef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T05ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e59072f48-38db-54e5-b6cf-76aefde98757c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>59072f48-38db-54e5-b6cf-76aefde98757</b:FlowGuid><b:Id>276</b:Id><b:InteractionKey>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e:59072f48-38db-54e5-b6cf-76aefde98757:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of I/O image or forcing of points on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could force inputs or outputs, or overwrite the I/O image, so Chemical Dosing PLC acts on false values or drives outputs directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Chlorine residual</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict force and I/O override functions to authorised engineering roles. Show active forces on the HMI. Log and alarm on force events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0835 Manipulate I/O Image; T0806 Brute Force I/O</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S02ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e59072f48-38db-54e5-b6cf-76aefde98757c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>59072f48-38db-54e5-b6cf-76aefde98757</b:FlowGuid><b:Id>277</b:Id><b:InteractionKey>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e:59072f48-38db-54e5-b6cf-76aefde98757:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Rogue master or rogue device on the fieldbus to Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A device connected to the fieldbus or serial link could act as a rogue master or slave, sending commands to or impersonating devices that Chemical Dosing PLC trusts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Chlorine residual</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict physical access to fieldbus segments. Use protocols with device authentication where available. Monitor for unexpected masters or addresses. Allow-list device addresses.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0848 Rogue Master; T1692.002 Unauthorized Message: Reporting Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T09ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e59072f48-38db-54e5-b6cf-76aefde98757c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>59072f48-38db-54e5-b6cf-76aefde98757</b:FlowGuid><b:Id>278</b:Id><b:InteractionKey>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e:59072f48-38db-54e5-b6cf-76aefde98757:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofed measurement or status reported from Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Values reported from Chlorine Analyzer to Chemical Dosing PLC could be falsified, so the control system acts on wrong process data or operators see false conditions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Chlorine residual</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate devices and protect message integrity. Apply plausibility and cross-checks on critical measurements (redundant sensors, rate-of-change limits). Keep independent safety measurements for safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.002 Unauthorized Message: Reporting Message; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.5; 4-2 CR 1.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T13ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e59072f48-38db-54e5-b6cf-76aefde98757c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>59072f48-38db-54e5-b6cf-76aefde98757</b:FlowGuid><b:Id>279</b:Id><b:InteractionKey>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e:59072f48-38db-54e5-b6cf-76aefde98757:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Alarm suppression or modification on Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Alarm limits, priorities or notifications on Chemical Dosing PLC could be changed or suppressed to hide an attack or abnormal process condition.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Chlorine residual</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict alarm configuration to authorised roles. Log and report alarm configuration changes. Monitor for unexpected alarm shelving / suppression.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0878 Alarm Suppression; T0838 Modify Alarm Settings</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E09ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e59072f48-38db-54e5-b6cf-76aefde98757c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>59072f48-38db-54e5-b6cf-76aefde98757</b:FlowGuid><b:Id>280</b:Id><b:InteractionKey>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e:59072f48-38db-54e5-b6cf-76aefde98757:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Web application vulnerabilities in Chemical Dosing PLC</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web interface of Chemical Dosing PLC could be vulnerable to injection, XSS, CSRF, path traversal or authentication bypass, leading to device takeover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Chlorine residual</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply secure coding (OWASP ASVS) and input validation (CR 3.5). Use CSRF tokens, secure headers and HTTPS only. Perform web penetration testing and static analysis (4-1 SVV).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0819 Exploit Public-Facing Application; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S03ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e59072f48-38db-54e5-b6cf-76aefde98757c20135fd-8d83-5b79-8788-20d5eb886ff2</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>59072f48-38db-54e5-b6cf-76aefde98757</b:FlowGuid><b:Id>281</b:Id><b:InteractionKey>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e:59072f48-38db-54e5-b6cf-76aefde98757:c20135fd-8d83-5b79-8788-20d5eb886ff2</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Session hijacking on the Chemical Dosing PLC web interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session tokens for Chemical Dosing PLC could be stolen or fixed, allowing an attacker to act as a logged-in user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Chlorine residual</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity (CR 3.8): random session IDs, secure/HttpOnly cookies, invalidate on logout. Session lock after inactivity (CR 2.5) and remote session termination (CR 2.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.8; 4-2 CR 2.5; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02c20135fd-8d83-5b79-8788-20d5eb886ff28906fbf3-6c5e-5c3b-9a0f-f65975d3990deb3ad30a-1f78-584d-b314-b99adb1feb3f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8906fbf3-6c5e-5c3b-9a0f-f65975d3990d</b:FlowGuid><b:Id>282</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:8906fbf3-6c5e-5c3b-9a0f-f65975d3990d:eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Dosing Pump Drive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Dosing Pump Drive are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump speed command</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T03c20135fd-8d83-5b79-8788-20d5eb886ff28906fbf3-6c5e-5c3b-9a0f-f65975d3990deb3ad30a-1f78-584d-b314-b99adb1feb3f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8906fbf3-6c5e-5c3b-9a0f-f65975d3990d</b:FlowGuid><b:Id>283</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:8906fbf3-6c5e-5c3b-9a0f-f65975d3990d:eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized program / logic download to Dosing Pump Drive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker with network access could download modified control logic or tasking to Dosing Pump Drive, changing how it controls the process (e.g. Stuxnet, TRITON).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump speed command</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for program download, online edits and forcing (CR 2.1). Support a physical or logical write-protect / run-lock. Sign or integrity-check project files (CR 3.4). Log and alarm on every logic change.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0843 Program Download; T0821 Modify Controller Tasking; T0889 Modify Program; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 3.4; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T04c20135fd-8d83-5b79-8788-20d5eb886ff28906fbf3-6c5e-5c3b-9a0f-f65975d3990deb3ad30a-1f78-584d-b314-b99adb1feb3f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8906fbf3-6c5e-5c3b-9a0f-f65975d3990d</b:FlowGuid><b:Id>284</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:8906fbf3-6c5e-5c3b-9a0f-f65975d3990d:eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Setpoint or parameter on Dosing Pump Drive changed to unsafe values</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Parameters, setpoints or limits on Dosing Pump Drive could be changed to values outside the safe operating envelope.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump speed command</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all inputs against engineering limits (CR 3.5). Separate permissions for operator setpoints and engineering parameters. Keep hard limits in logic or in an independent safety layer, not only in the HMI.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0836 Modify Parameter; T0831 Manipulation of Control; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T05c20135fd-8d83-5b79-8788-20d5eb886ff28906fbf3-6c5e-5c3b-9a0f-f65975d3990deb3ad30a-1f78-584d-b314-b99adb1feb3f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8906fbf3-6c5e-5c3b-9a0f-f65975d3990d</b:FlowGuid><b:Id>285</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:8906fbf3-6c5e-5c3b-9a0f-f65975d3990d:eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of I/O image or forcing of points on Dosing Pump Drive</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could force inputs or outputs, or overwrite the I/O image, so Dosing Pump Drive acts on false values or drives outputs directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump speed command</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict force and I/O override functions to authorised engineering roles. Show active forces on the HMI. Log and alarm on force events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0835 Manipulate I/O Image; T0806 Brute Force I/O</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14c20135fd-8d83-5b79-8788-20d5eb886ff28906fbf3-6c5e-5c3b-9a0f-f65975d3990deb3ad30a-1f78-584d-b314-b99adb1feb3f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>8906fbf3-6c5e-5c3b-9a0f-f65975d3990d</b:FlowGuid><b:Id>286</b:Id><b:InteractionKey>c20135fd-8d83-5b79-8788-20d5eb886ff2:8906fbf3-6c5e-5c3b-9a0f-f65975d3990d:eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between Chemical Dosing PLC and Dosing Pump Drive blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between Chemical Dosing PLC and Dosing Pump Drive while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump speed command</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>c20135fd-8d83-5b79-8788-20d5eb886ff2</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>eb3ad30a-1f78-584d-b314-b99adb1feb3f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E02ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>287</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized change of operating mode on Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A remote command could switch Chlorine Analyzer between Run, Program, Remote or Test modes without authorisation, enabling logic changes or stopping control.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for mode changes. Provide a physical key switch or local confirmation for Program mode. Report the current mode to the HMI and alarm on unexpected changes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0858 Change Operating Mode; T0868 Detect Operating Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D02ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>288</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Remote restart, shutdown or stop of Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Protocol commands (stop CPU, reset, reboot) could be sent to Chlorine Analyzer to halt control of the process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for stop/reset services. Make these services configurable and disabled by default where possible. Ensure outputs go to a defined safe state on stop (CR 3.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0816 Device Restart/Shutdown; T0813 Denial of Control; T0881 Service Stop</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of production; Loss of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I04ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>289</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Program upload / theft of control logic from Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could upload the program and configuration from Chlorine Analyzer to steal know-how or study the process before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authorisation for program upload. Support know-how protection (encrypted / protected blocks). Log upload events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0845 Program Upload; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T05ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>290</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of I/O image or forcing of points on Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could force inputs or outputs, or overwrite the I/O image, so Chlorine Analyzer acts on false values or drives outputs directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict force and I/O override functions to authorised engineering roles. Show active forces on the HMI. Log and alarm on force events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0835 Manipulate I/O Image; T0806 Brute Force I/O</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T06ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>291</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious or modified firmware loaded on Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Firmware for Chlorine Analyzer could be replaced with a modified image that hides malicious behaviour or bricks the device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Accept only firmware signed by the product supplier and verify the signature on the device before install (CR 3.4, EDR 3.10). Prevent rollback to vulnerable versions. Require authorisation to start firmware update mode.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware; T0800 Activate Firmware Update Mode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-2 EDR 3.10; 4-2 EDR 3.14</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T07ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>292</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Boot process or runtime integrity of Chlorine Analyzer bypassed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Without a verified boot chain, an attacker who can write to flash could run persistent unsigned code on Chlorine Analyzer.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Implement secure / measured boot from a hardware root of trust (EDR 3.14). Provision supplier and asset-owner roots of trust securely (EDR 3.12, 3.13). Verify security functions at start-up (CR 3.3).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.001 Modify Firmware: System Firmware; T0851 Rootkit</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.14; 4-2 EDR 3.12; 4-2 EDR 3.13; 4-2 CR 3.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D03ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>293</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Chlorine Analyzer outputs not driven to a safe state when attacked or failing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If Chlorine Analyzer is overloaded, crashes or loses communication, its outputs may hold an unsafe state or behave unpredictably.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Define deterministic fail-safe output behaviour (CR 3.6) and safe error handling (CR 3.7). Use communication watchdogs. Test behaviour under network storms and malformed traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0813 Denial of Control; T0826 Loss of Availability; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.6; 4-2 CR 3.7; 4-2 CR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D04ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>294</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network load disturbs the scan cycle of Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Communication processing on Chlorine Analyzer may share CPU with the control task, so heavy or malformed traffic could increase scan time and miss control deadlines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Prioritise the control task over communication (CR 7.2 resource management). Limit connections and request rates. Test with load and robustness testing at all supported SLs.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E03ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>295</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Debug or service interface on Chlorine Analyzer gives privileged access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>JTAG, UART consoles, USB service ports or test modes on Chlorine Analyzer could give root access, bypass authentication or dump firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable or lock debug interfaces in production (EDR/HDR/NDR 2.13). Protect service ports with authentication. Document any remaining interfaces in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 2.13; 4-2 HDR 2.13; 4-2 NDR 2.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S02ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>296</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Rogue master or rogue device on the fieldbus to Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A device connected to the fieldbus or serial link could act as a rogue master or slave, sending commands to or impersonating devices that Chlorine Analyzer trusts.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict physical access to fieldbus segments. Use protocols with device authentication where available. Monitor for unexpected masters or addresses. Allow-list device addresses.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0848 Rogue Master; T1692.002 Unauthorized Message: Reporting Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>297</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Chlorine Analyzer, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>298</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chlorine Analyzer could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>299</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Chlorine Analyzer</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Chlorine Analyzer may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T18ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>300</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Counterfeit device or tampering of Chlorine Analyzer before delivery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chlorine Analyzer could be counterfeited or tampered with during manufacturing, shipping or provisioning, including injection of attacker-controlled keys.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provision product-supplier roots of trust in a controlled environment (EDR/NDR 3.12) and let the asset owner provision their own (3.13). Provide device identity certificates and genuineness checks. Use tamper-evident packaging.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.12; 4-2 EDR 3.13; 4-1 SM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T19ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>301</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Chlorine Analyzer disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Chlorine Analyzer without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>302</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Chlorine Analyzer unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Chlorine Analyzer could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T26ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>303</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Physical inputs to Chlorine Analyzer manipulated at the process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Someone could manipulate sensors or the process physically (bypass a sensor, inject a signal), so Chlorine Analyzer acts on false inputs.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply plausibility checks and redundancy for critical measurements (CR 3.5). Physically protect critical sensors. Use independent safety instrumentation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.002 Unauthorized Message: Reporting Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R06ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>304</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Local audit trail on Chlorine Analyzer lost, overwritten or cleared</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot Chlorine Analyzer so evidence held in volatile memory is lost.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect audit records against deletion (CR 3.9) and keep them across restarts. Forward events in near real time to a central collector (CR 6.1, syslog over TLS). Warn when audit capacity is nearly used (CR 2.9). Record clearing of the log as an audit event itself.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.9; 4-2 CR 2.9; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Detection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I15ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>305</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Process state and I/O image read from Chlorine Analyzer by an unauthorised client</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Chlorine Analyzer answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for read services as well as writes where the protocol allows (CR 2.1). Allow-list client addresses. Expose only required tags. Detect unexpected polling clients at the conduit or with network monitoring (CR 6.2).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0801 Monitor Process State; T0877 I/O Image; T0861 Point &amp; Tag Identification; T0802 Automated Collection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 4.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement; Confidentiality / IP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28ba7f75a9-6d7f-5f98-82d4-4b2c680fe0623a2e5ba7-12f8-5bea-84d7-9f1855629236ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>3a2e5ba7-12f8-5bea-84d7-9f1855629236</b:FlowGuid><b:Id>306</b:Id><b:InteractionKey>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062:3a2e5ba7-12f8-5bea-84d7-9f1855629236:ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Chlorine Analyzer during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Chlorine Analyzer before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Sample measurement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>ba7f75a9-6d7f-5f98-82d4-4b2c680fe062</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>ed9ce2d8-d571-5ea2-b1b8-35a5669bf39e</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S01eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>307</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of SCADA Server across a zone / trust boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the network path could impersonate SCADA Server and send traffic that Lift Station Cellular Router accepts as genuine, because the communication crosses a trust boundary and the peer identity may not be verified.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Authenticate software processes and devices at the boundary (certificates or keys per device, not shared secrets). Reject traffic from unauthenticated peers. Allow-list expected peers on the conduit device.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0849 Masquerading; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 3-3 SR 1.2; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T01eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>308</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Adversary-in-the-middle tampering of SCADA Server to Lift Station Cellular Router traffic</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between SCADA Server and Lift Station Cellular Router crosses a trust boundary without integrity protection, so an attacker in the path could modify values, commands or responses without detection.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use protocol security with message integrity (OPC UA Sign/SignAndEncrypt, CIP Security, DNP3-SA, IEC 62351, TLS). Where the protocol cannot be secured, tunnel it through an authenticated, integrity-protected conduit (IPsec/TLS) and restrict paths at the zone boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0830 Adversary-in-the-Middle; T0831 Manipulation of Control; T0832 Manipulation of View</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 3-3 SR 3.1; 4-2 CR 4.3</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I01eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>309</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Sniffing of operational data between SCADA Server and Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Traffic between SCADA Server and Lift Station Cellular Router is not encrypted across the trust boundary. An attacker could capture process values, tag names, program contents or credentials and use them to plan an attack.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Encrypt flows that cross zone boundaries where confidentiality is required (TLS, OPC UA SignAndEncrypt, IPsec tunnels). Classify data to decide where encryption is needed. Do not send credentials over unencrypted channels.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0861 Point &amp; Tag Identification; T0882 Theft of Operational Information</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 4.3; 3-3 SR 4.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality / IP; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>310</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Lift Station Cellular Router are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D01eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>311</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Network flooding of Lift Station Cellular Router from another zone</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Lift Station Cellular Router receives traffic from across a trust boundary. A flood, malformed-packet storm or resource-exhaustion attack could degrade or stop its essential functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Rate-limit and filter at the conduit. Design the component to keep essential functions running under load (CR 7.1) and test with network robustness tests (e.g. ISASecure CRT, Achilles-type storm tests). Separate control and management traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2; 3-3 SR 7.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R01eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>312</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security-relevant actions on Lift Station Cellular Router not audited</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Requests that reach Lift Station Cellular Router from another zone may not produce audit records, so changes, logins or failures could not be attributed or investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Generate audit records for access control, configuration changes, request errors and control-system events (CR 2.8) with accurate timestamps (CR 2.11). Make logs available to a central collector (CR 6.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SR - Security requirements</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Compliance</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E01eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>313</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Non-essential services on Lift Station Cellular Router reachable across the boundary</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Ports, services or debug functions on Lift Station Cellular Router that are not needed for its function may be reachable from another zone and give an attacker extra attack surface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply least functionality (CR 7.7): disable unused ports, services and protocols by default. Document required ports in the security guidelines. Allow only required flows at the conduit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 7.6; 4-2 NDR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E01</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I03eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>314</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Reconnaissance of Lift Station Cellular Router (device fingerprinting, enumeration)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could query Lift Station Cellular Router across the boundary to identify vendor, model, firmware version, I/O modules and tags and so pick known vulnerabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit information returned to unauthenticated requests. Require authentication for diagnostic and identification services where feasible. Detect scanning at the boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery; T0846 Remote System Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.7; 4-2 CR 2.1; 4-2 CR 6.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E03eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>315</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Debug or service interface on Lift Station Cellular Router gives privileged access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>JTAG, UART consoles, USB service ports or test modes on Lift Station Cellular Router could give root access, bypass authentication or dump firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Disable or lock debug interfaces in production (EDR/HDR/NDR 2.13). Protect service ports with authentication. Document any remaining interfaces in the security guidelines.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1693.002 Modify Firmware: Module Firmware; T1693.001 Modify Firmware: System Firmware</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 2.13; 4-2 HDR 2.13; 4-2 NDR 2.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E09eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>316</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Web application vulnerabilities in Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web interface of Lift Station Cellular Router could be vulnerable to injection, XSS, CSRF, path traversal or authentication bypass, leading to device takeover.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Apply secure coding (OWASP ASVS) and input validation (CR 3.5). Use CSRF tokens, secure headers and HTTPS only. Perform web penetration testing and static analysis (4-1 SVV).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0819 Exploit Public-Facing Application; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S03eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>317</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Session hijacking on the Lift Station Cellular Router web interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Session tokens for Lift Station Cellular Router could be stolen or fixed, allowing an attacker to act as a logged-in user.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity (CR 3.8): random session IDs, secure/HttpOnly cookies, invalidate on logout. Session lock after inactivity (CR 2.5) and remote session termination (CR 2.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.8; 4-2 CR 2.5; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I07eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>318</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Verbose errors or diagnostics disclose internals of Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Error messages, stack traces or diagnostic pages from Lift Station Cellular Router could reveal versions, paths or configuration useful to an attacker.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Return error information that supports operation without exposing internals (CR 3.7). Restrict diagnostic data to authenticated users.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S04eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>319</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Default, shared or hard-coded credentials on Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Lift Station Cellular Router could ship with default, shared or hard-coded passwords or keys that attackers can find in manuals or firmware.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>No hard-coded credentials. Force change of default credentials at commissioning (CR 1.5). Enforce password strength (CR 1.7). Support unique per-device credentials.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T1694.002 Insecure Credentials: Hardcoded Credentials</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.1; 4-2 CR 1.5; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S05eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>320</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Brute-force or password guessing against Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could repeatedly try passwords on Lift Station Cellular Router if failed attempts are not limited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Limit unsuccessful login attempts (CR 1.11) without blocking essential functions. Obscure authenticator feedback (CR 1.10). Log failed logins. Support MFA for remote / untrusted network access (CR 1.1 RE).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.11; 4-2 CR 1.10; 4-2 CR 1.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Unauthorized access</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E11eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>321</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Memory corruption or parser flaw in the communication stack of Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Malformed protocol messages could trigger buffer overflows or parser errors in Lift Station Cellular Router, causing crashes or remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all input (CR 3.5). Use memory-safe languages or compiler hardening. Fuzz-test every protocol interface (4-1 SVV-3) and run communication robustness tests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0866 Exploitation of Remote Services; T0890 Exploitation for Privilege Escalation; T0820 Exploitation for Evasion</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-1 SI; 4-1 SVV</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise; Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E11</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E12eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>322</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Insecure default configuration of Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Lift Station Cellular Router could be deployed with insecure defaults (services enabled, security features off, weak crypto) because secure configuration is not the default or is not documented.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Ship secure by default. Provide a machine-readable configuration report and the ability to check settings (CR 7.6). Publish hardening and secure integration guidelines (4-1 SG).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1694.001 Insecure Credentials: Default Credentials; T0866 Exploitation of Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.6; 4-2 CR 7.7; 4-1 SG</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T17eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>323</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Vulnerable or compromised third-party component in Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Open-source or commercial components (RTOS, protocol stacks, libraries) in Lift Station Cellular Router may contain known vulnerabilities or be compromised in the supply chain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Maintain an SBOM. Assess third-party components before use (4-1 SM-9, SM-10). Monitor vulnerability sources and handle issues through the defect management process (4-1 DM). Patch or mitigate promptly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.8; 4-1 SM-9; 4-1 SM-10; 4-1 DM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T17</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T18eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>324</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Counterfeit device or tampering of Lift Station Cellular Router before delivery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Lift Station Cellular Router could be counterfeited or tampered with during manufacturing, shipping or provisioning, including injection of attacker-controlled keys.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Provision product-supplier roots of trust in a controlled environment (EDR/NDR 3.12) and let the asset owner provision their own (3.13). Provide device identity certificates and genuineness checks. Use tamper-evident packaging.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 EDR 3.12; 4-2 EDR 3.13; 4-1 SM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Persistent compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T18</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T19eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>325</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Security configuration of Lift Station Cellular Router disabled or weakened</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker or careless user could turn off logging, authentication or filtering on Lift Station Cellular Router without being noticed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict security configuration to administrators. Audit configuration changes (CR 2.8). Support verification of security functions (CR 3.3) and configuration baselines (CR 7.6).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.3; 4-2 CR 7.6; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T19</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D07eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>326</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Failed or malicious update leaves Lift Station Cellular Router unavailable</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An update to Lift Station Cellular Router could fail, be interrupted or be incompatible, stopping operation with no way back.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Support atomic update with rollback to the last known-good image. Allow updates to be scheduled by the asset owner without affecting essential functions (EDR/HDR/NDR 3.10). Qualify patches before release (4-1 SUM).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SUM - Security update management</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.4; 4-2 EDR 3.10; 4-2 HDR 3.10; 4-2 NDR 3.10; 4-1 SUM</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I08eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>327</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak or obsolete cryptography in Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Lift Station Cellular Router could use weak algorithms, short keys, poor random numbers or unmanaged certificates, making protections easy to break.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use cryptography per recognised standards (CR 4.3). Support crypto agility and certificate lifecycle (CR 1.8, 1.9). Use a hardware RNG where possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0830 Adversary-in-the-Middle</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.3; 4-2 CR 1.8; 4-2 CR 1.9</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E13eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>328</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Zone boundary bypass or misconfiguration of Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Weak rules, any-any rules, protocol tunnelling or misconfiguration on Lift Station Cellular Router could let traffic pass between zones that should be separated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Deny by default and allow only documented conduits (NDR 5.2). Use protocol-aware / DPI filtering for industrial protocols. Review rules regularly and alert on changes. Support fail-close behaviour.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0884 Connection Proxy; T0886 Remote Services; T0885 Commonly Used Port</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 NDR 5.2; 3-3 SR 5.1; 3-3 SR 5.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of segmentation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E13</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D08eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>329</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Denial of service of network device Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Broadcast storms, CAM table overflow, routing / redundancy protocol attacks (MRP, RSTP) or management-plane floods could stop Lift Station Cellular Router from forwarding OT traffic.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Storm control and rate limiting. Protect the management plane. Authenticate redundancy and routing protocols where supported. Keep forwarding of control traffic independent of management load (CR 7.1).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SVV - Security verification and validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0826 Loss of Availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 7.2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of availability; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D08</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I09eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>330</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Management credentials or configuration of Lift Station Cellular Router disclosed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>SNMP community strings, Telnet/HTTP management or configuration backups of Lift Station Cellular Router could disclose credentials and network topology.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use SNMPv3, SSH and HTTPS for management. Disable Telnet, HTTP and SNMPv1/v2c by default. Encrypt stored configuration backups.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SG - Security guidelines</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0842 Network Sniffing; T0888 Remote System Information Discovery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 1.5; 4-2 CR 7.7</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S06eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>331</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Stolen credentials used for remote access to Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Phished or reused VPN / remote access credentials could give an attacker interactive access to Lift Station Cellular Router from the Internet.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require multi-factor authentication for access from untrusted networks (CR 1.1 RE / SR 1.13). Use individual accounts. Restrict source addresses and time windows.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0822 External Remote Services; T0859 Valid Accounts</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.13; 4-2 CR 1.1; 4-2 CR 2.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-E15eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>332</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Lift Station Cellular Router exposed to the Internet or an untrusted network</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The flow from SCADA Server reaches Lift Station Cellular Router over the Internet, cellular or another untrusted network, so it can be found and attacked directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Never expose OT services directly to the Internet. Terminate untrusted connections in a DMZ / remote access gateway with MFA (SR 1.13). Monitor for exposure (e.g. Shodan-type scans of own address space).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0883 Internet Accessible Device; T0822 External Remote Services</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 5.2; 3-3 SR 1.13; 4-2 NDR 1.13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR5 Restricted data flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Full compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-E15</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-I10eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>333</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Wireless sniffing of traffic to Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Radio traffic to Lift Station Cellular Router can be captured from outside the physical perimeter.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use strong wireless security (WPA3-Enterprise, WirelessHART/ISA100 join keys managed securely). Control wireless use (CR 2.2, SR 1.6). Add application-level encryption for sensitive data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0887 Wireless Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 4.1; 4-2 CR 2.2; 3-3 SR 1.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR4 Data confidentiality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Confidentiality; Attack enablement</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-I10</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-S07eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>334</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Rogue access point or rogue wireless device connecting to Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could set up a rogue AP or join a rogue device to the wireless network used by Lift Station Cellular Router.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Mutual authentication of wireless devices and networks (SR 1.6). Wireless intrusion detection. Disable unused radios (CR 7.7).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0860 Wireless Compromise; T0848 Rogue Master</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>3-3 SR 1.6; 4-2 CR 2.2; 4-2 CR 1.2; 4-2 CR 1.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-S07</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D09eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>335</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>RF jamming or de-authentication of Lift Station Cellular Router</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Radio jamming or de-authentication attacks could cut wireless communication to Lift Station Cellular Router.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Do not use wireless for safety-critical or time-critical control without a fail-safe on loss of communication. Use protected management frames (802.11w). Monitor link quality.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0814 Denial of Service; T0860 Wireless Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Loss of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D09</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-R06eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>336</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Local audit trail on Lift Station Cellular Router lost, overwritten or cleared</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot Lift Station Cellular Router so evidence held in volatile memory is lost.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect audit records against deletion (CR 3.9) and keep them across restarts. Forward events in near real time to a central collector (CR 6.1, syslog over TLS). Warn when audit capacity is nearly used (CR 2.9). Record clearing of the log as an audit event itself.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0872 Indicator Removal on Host; T0816 Device Restart/Shutdown</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.9; 4-2 CR 2.9; 4-2 CR 6.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Forensics; Detection</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-R06</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>337</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between SCADA Server and Lift Station Cellular Router blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between SCADA Server and Lift Station Cellular Router while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T29eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>338</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Rogue publisher or subscriber on the SCADA Server to Lift Station Cellular Router messaging channel</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>On publish/subscribe channels (MQTT, cloud messaging) any client the broker accepts may publish to or subscribe to topics. A rogue client could inject false values or commands for Lift Station Cellular Router, or read all telemetry.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require client authentication (certificates) on the broker and per-topic access control lists (CR 1.2, CR 2.1). Use TLS. Sign or validate payloads that carry commands. Disable wildcard subscriptions for untrusted clients.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0869.002 Standard Application Layer Protocol: Publish/Subscribe Protocols; T1692.001 Unauthorized Message: Command Message; T1692.002 Unauthorized Message: Reporting Message</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 1.2; 4-2 CR 2.1; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR1 Identification and authentication control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Manipulation of view</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T29</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T28eaf8e53a-1bec-5b36-a525-2ddb2c182f5eaaa6c3e0-2ae0-5eca-8660-bead3c0f7681b760d5eb-c98e-53db-a982-221f1f085704</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>aaa6c3e0-2ae0-5eca-8660-bead3c0f7681</b:FlowGuid><b:Id>339</b:Id><b:InteractionKey>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e:aaa6c3e0-2ae0-5eca-8660-bead3c0f7681:b760d5eb-c98e-53db-a982-221f1f085704</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Malicious code inserted into Lift Station Cellular Router during development or build</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>A compromised developer account, source repository, build server or dependency could insert a backdoor into Lift Station Cellular Router before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Telemetry over cellular</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SM - Security management and supply chain</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0862 Supply Chain Compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Fleet-wide compromise</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>eaf8e53a-1bec-5b36-a525-2ddb2c182f5e</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T28</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T02b760d5eb-c98e-53db-a982-221f1f085704989473a9-3466-5228-a148-092c0c94d220044b21aa-32e3-52bc-8555-a07fc242be51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>989473a9-3466-5228-a148-092c0c94d220</b:FlowGuid><b:Id>340</b:Id><b:InteractionKey>b760d5eb-c98e-53db-a982-221f1f085704:989473a9-3466-5228-a148-092c0c94d220:044b21aa-32e3-52bc-8555-a07fc242be51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay or injection of control commands to Lift Station RTU</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Commands, setpoints or logic sent to Lift Station RTU are not authenticated, so recorded or crafted messages could be replayed or injected to operate equipment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump station control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Protect session integrity with authenticated sessions, sequence numbers / nonces and timestamps (CR 3.8). Use protocol security with anti-replay (DNP3-SA, CIP Security, OPC UA). Validate that commands come from authorised masters only.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.1; 4-2 CR 3.8; 4-2 CR 2.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Equipment damage; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>044b21aa-32e3-52bc-8555-a07fc242be51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T02</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T03b760d5eb-c98e-53db-a982-221f1f085704989473a9-3466-5228-a148-092c0c94d220044b21aa-32e3-52bc-8555-a07fc242be51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>989473a9-3466-5228-a148-092c0c94d220</b:FlowGuid><b:Id>341</b:Id><b:InteractionKey>b760d5eb-c98e-53db-a982-221f1f085704:989473a9-3466-5228-a148-092c0c94d220:044b21aa-32e3-52bc-8555-a07fc242be51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Unauthorized program / logic download to Lift Station RTU</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker with network access could download modified control logic or tasking to Lift Station RTU, changing how it controls the process (e.g. Stuxnet, TRITON).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump station control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Require authentication and authorisation for program download, online edits and forcing (CR 2.1). Support a physical or logical write-protect / run-lock. Sign or integrity-check project files (CR 3.4). Log and alarm on every logic change.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0843 Program Download; T0821 Modify Controller Tasking; T0889 Modify Program; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 3.4; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Equipment damage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>044b21aa-32e3-52bc-8555-a07fc242be51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T03</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T04b760d5eb-c98e-53db-a982-221f1f085704989473a9-3466-5228-a148-092c0c94d220044b21aa-32e3-52bc-8555-a07fc242be51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>989473a9-3466-5228-a148-092c0c94d220</b:FlowGuid><b:Id>342</b:Id><b:InteractionKey>b760d5eb-c98e-53db-a982-221f1f085704:989473a9-3466-5228-a148-092c0c94d220:044b21aa-32e3-52bc-8555-a07fc242be51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Setpoint or parameter on Lift Station RTU changed to unsafe values</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Parameters, setpoints or limits on Lift Station RTU could be changed to values outside the safe operating envelope.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump station control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Validate all inputs against engineering limits (CR 3.5). Separate permissions for operator setpoints and engineering parameters. Keep hard limits in logic or in an independent safety layer, not only in the HMI.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SI - Secure implementation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0836 Modify Parameter; T0831 Manipulation of Control; T0827 Loss of Control; T0879 Damage to Property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 3.5; 4-2 CR 2.1; 4-2 CR 3.6</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR3 System integrity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Safety; Equipment damage; Product quality</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>044b21aa-32e3-52bc-8555-a07fc242be51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T04</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-T05b760d5eb-c98e-53db-a982-221f1f085704989473a9-3466-5228-a148-092c0c94d220044b21aa-32e3-52bc-8555-a07fc242be51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>989473a9-3466-5228-a148-092c0c94d220</b:FlowGuid><b:Id>343</b:Id><b:InteractionKey>b760d5eb-c98e-53db-a982-221f1f085704:989473a9-3466-5228-a148-092c0c94d220:044b21aa-32e3-52bc-8555-a07fc242be51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Manipulation of I/O image or forcing of points on Lift Station RTU</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker could force inputs or outputs, or overwrite the I/O image, so Lift Station RTU acts on false values or drives outputs directly.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump station control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Restrict force and I/O override functions to authorised engineering roles. Show active forces on the HMI. Log and alarm on force events.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T0835 Manipulate I/O Image; T0806 Brute Force I/O</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 2.1; 4-2 CR 2.8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR2 Use control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Manipulation of control; Safety</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>044b21aa-32e3-52bc-8555-a07fc242be51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-T05</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>OT-D14b760d5eb-c98e-53db-a982-221f1f085704989473a9-3466-5228-a148-092c0c94d220044b21aa-32e3-52bc-8555-a07fc242be51</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>9ec003ea-bb9d-46ec-a30a-163f552a7a0b</b:DrawingSurfaceGuid><b:FlowGuid>989473a9-3466-5228-a148-092c0c94d220</b:FlowGuid><b:Id>344</b:Id><b:InteractionKey>b760d5eb-c98e-53db-a982-221f1f085704:989473a9-3466-5228-a148-092c0c94d220:044b21aa-32e3-52bc-8555-a07fc242be51</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Command, trip or alarm messages between Lift Station Cellular Router and Lift Station RTU blocked</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between Lift Station Cellular Router and Lift Station RTU while the link still looks healthy, so a response to a process upset never arrives.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Pump station control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>PossibleMitigations</a:Key><a:Value>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>SDLPhase</a:Key><a:Value>SD - Secure by design</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ATTACKICS</a:Key><a:Value>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>IEC62443Req</a:Key><a:Value>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>FoundationalReq</a:Key><a:Value>FR7 Resource availability</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>MinSL</a:Key><a:Value>SL 2</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>OTImpact</a:Key><a:Value>Loss of control; Safety; Damage to property</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Likelihood</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>ImpactScore</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>RiskRating</a:Key><a:Value>Not assessed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Treatment</a:Key><a:Value>Not decided</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b760d5eb-c98e-53db-a982-221f1f085704</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>044b21aa-32e3-52bc-8555-a07fc242be51</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>OT-D14</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB></ThreatInstances><ThreatGenerationEnabled>true</ThreatGenerationEnabled><Validations xmlns:a="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"/><Version>4.3</Version><KnowledgeBase z:Id="i43" xmlns:a="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase" xmlns:z="http://schemas.microsoft.com/2003/10/Serialization/"><a:GenericElements><a:ElementType><a:IsExtension>false</a:IsExtension><a:Attributes><a:Attribute><a:IsExtension>false</a:IsExtension><a:AttributeValues xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.Interfaces"><b:Value>Not Selected</b:Value><b:Value>EDR - Embedded device</b:Value><b:Value>HDR - Host device</b:Value><b:Value>NDR - Network device</b:Value><b:Value>SAR - Software application</b:Value></a:AttributeValues><a:DisplayName>IEC 62443-4-2 Component Type</a:DisplayName><a:Inheritance>Virtual</a:Inheritance><a:Mode>Dynamic</a:Mode><a:Name>ComponentType</a:Name><a:Type>List</a:Type></a:Attribute><a:Attribute><a:IsExtension>false</a:IsExtension><a:AttributeValues xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.Interfaces"><b:Value>Not Selected</b:Value><b:Value>SL 1</b:Value><b:Value>SL 2</b:Value><b:Value>SL 3</b:Value><b:Value>SL 4</b:Value></a:AttributeValues><a:DisplayName>Security Level Target (SL-T IEC 62443)</a:DisplayName><a:Inheritance>Virtual</a:Inheritance><a:Mode>Dynamic</a:Mode><a:Name>SLT</a:Name><a:Type>List</a:Type></a:Attribute><a:Attribute><a:IsExtension>false</a:IsExtension><a:AttributeValues xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.Interfaces"><b:Value>Unknown</b:Value><b:Value>Yes</b:Value><b:Value>No</b:Value></a:AttributeValues><a:DisplayName>Performs Safety-Related Function (SIS or SIL)</a:DisplayName><a:Inheritance>Virtual</a:Inheritance><a:Mode>Dynamic</a:Mode><a:Name>SafetyRelated</a:Name><a:Type>List</a:Type></a:Attribute><a:Attribute><a:IsExtension>false</a:IsExtension><a:AttributeValues xmlns:b="http://schemas.