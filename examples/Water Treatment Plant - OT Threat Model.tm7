scription</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Data in {target.Name} could remain readable after the component is replaced, repaired or scrapped.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Low</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Support secure erase of all sensitive information (CR 4.2) and document decommissioning in the security guidelines.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SG - Security guidelines</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0893 Data from Local System</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 4.2; 4-1 SG</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR4 Data confidentiality</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Confidentiality / IP</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Sensitive data in {target.Name} recoverable after decommissioning</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>R</a:Category><a:Description>An attacker could delete or alter audit records in {target.Name} to hide their actions.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.DS.OT.AuditLog')</a:Include></a:GenerationFilters><a:Id>OT-R03</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>An attacker could delete or alter audit records in {target.Name} to hide their actions.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Protect audit information against unauthorised access, modification and deletion (CR 3.9). Forward logs in near real time to a central collector (CR 6.1).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0872 Indicator Removal on Host</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 3.9; 4-2 CR 6.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR3 System integrity</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Forensics</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Audit records in {target.Name} modified or deleted</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>D</a:Category><a:Description>An attacker could flood {target.Name} with events to fill storage, overwriting evidence or stopping logging.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.DS.OT.AuditLog')</a:Include></a:GenerationFilters><a:Id>OT-D10</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>An attacker could flood {target.Name} with events to fill storage, overwriting evidence or stopping logging.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Allocate sufficient audit storage and warn before it is full (CR 2.9). Define behaviour on audit failure without losing essential functions (CR 2.10).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0872 Indicator Removal on Host</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 2.9; 4-2 CR 2.10</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR2 Use control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Forensics</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Audit storage of {target.Name} exhausted</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>D</a:Category><a:Description>Backups could be encrypted by ransomware, deleted or silently corrupted, preventing recovery of the control system.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.DS.OT.Backup' or target is 'SE.P.OT.BackupService')</a:Include></a:GenerationFilters><a:Id>OT-D11</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Backups could be encrypted by ransomware, deleted or silently corrupted, preventing recovery of the control system.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Support backup without affecting operations (CR 7.3) with integrity verification. Keep offline / immutable copies. Test restore regularly (CR 7.4).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SG - Security guidelines</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0809 Data Destruction</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 7.3; 4-2 CR 7.4</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR7 Resource availability</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Loss of production; Recovery time</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Backups in {target.Name} unavailable, encrypted or corrupted</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>I</a:Category><a:Description>Historical process data, backups or projects in {target.Name} could be copied out in bulk to the enterprise or Internet.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.DS.OT.HistorianDB' or target is 'SE.DS.OT.Backup' or target is 'SE.DS.OT.ProjectFiles')</a:Include></a:GenerationFilters><a:Id>OT-I13</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Historical process data, backups or projects in {target.Name} could be copied out in bulk to the enterprise or Internet.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Encrypt at rest (CR 4.1). Restrict read access. Use one-way replication (e.g. data diode) to the enterprise. Monitor for unusual volumes.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0811 Data from Information Repositories; T0882 Theft of Operational Information</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 4.1; 3-3 SR 5.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR4 Data confidentiality</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Confidentiality / IP</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Bulk exfiltration of data from {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>S</a:Category><a:Description>An attacker could impersonate {source.Name} at {target.Name} using stolen, guessed or shared credentials.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.Operator' or source is 'SE.EI.OT.Engineer' or source is 'SE.EI.OT.Admin' or source is 'SE.EI.OT.Vendor' or source is 'SE.EI.OT.Integrator') and (target is 'GE.P')</a:Include></a:GenerationFilters><a:Id>OT-S08</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>An attacker could impersonate {source.Name} at {target.Name} using stolen, guessed or shared credentials.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Authenticate all human users (CR 1.1). Strong password policy (CR 1.7). MFA for privileged and remote users. Integrate with central account management (CR 1.3).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0859 Valid Accounts</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 1.1; 4-2 CR 1.3; 4-2 CR 1.7</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR1 Identification and authentication control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Unauthorized access</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Impersonation of {source.Name} at {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>E</a:Category><a:Description>A malicious or coerced {source.Name} could misuse legitimate privileges on {target.Name}.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.Engineer' or source is 'SE.EI.OT.Admin' or source is 'SE.EI.OT.Integrator')</a:Include></a:GenerationFilters><a:Id>OT-E16</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>A malicious or coerced {source.Name} could misuse legitimate privileges on {target.Name}.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Least privilege and separation of duties (CR 2.1). Dual control for critical changes. Audit privileged actions and review them (CR 2.8).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SR - Security requirements</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0859 Valid Accounts</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 2.1; 4-2 CR 2.8; 4-2 CR 1.3</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR2 Use control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Loss of control; Safety</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Insider misuse of privileged access by {source.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>E</a:Category><a:Description>An attacker who compromised {source.Name} could use this flow to move laterally into the OT environment.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.EnterpriseIT') and (flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B')</a:Include></a:GenerationFilters><a:Id>OT-E17</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>An attacker who compromised {source.Name} could use this flow to move laterally into the OT environment.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Terminate IT-to-OT flows in an industrial DMZ. No direct connections from IT to Level 1/2. Use separate identities for IT and OT. Allow only specific, documented services through the conduit.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0866 Exploitation of Remote Services; T0886 Remote Services; T0884 Connection Proxy</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>3-3 SR 5.1; 3-3 SR 5.2; 4-2 NDR 5.2</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR5 Restricted data flow</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Full compromise</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Pivot from enterprise IT ({source.Name}) into {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>E</a:Category><a:Description>{target.Name} receives traffic directly from the enterprise or cloud, bypassing the zone model.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.EnterpriseIT' or source is 'SE.EI.OT.Cloud') and (target is 'SE.P.OT.PLC' or target is 'SE.P.OT.SIS' or target is 'SE.P.OT.RTU' or target is 'SE.P.OT.IED' or target is 'SE.P.OT.SmartField' or target is 'SE.P.OT.IIoT' or target is 'SE.P.OT.SafetyIO')</a:Include></a:GenerationFilters><a:Id>OT-E18</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>{target.Name} receives traffic directly from the enterprise or cloud, bypassing the zone model.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Route through an edge gateway / DMZ that terminates the connection. Make controller access from higher levels read-only or brokered. Re-assess the zone and conduit design.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0883 Internet Accessible Device; T0886 Remote Services</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR5 Restricted data flow</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Loss of control</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Direct connection from {source.Name} to controller {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>T</a:Category><a:Description>If the cloud platform is compromised, it could push malicious commands, configuration or apps to {target.Name}.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.Cloud') and (target is 'GE.P')</a:Include></a:GenerationFilters><a:Id>OT-T25</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>If the cloud platform is compromised, it could push malicious commands, configuration or apps to {target.Name}.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Keep cloud-to-OT flows read-only where possible. Require local approval for write operations. Authenticate the cloud endpoint and sign commands. Apply allow-lists for permitted operations.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T1692.001 Unauthorized Message: Command Message; T0869 Standard Application Layer Protocol</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>3-3 SR 5.2; 4-2 CR 2.1; 4-2 CR 3.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR5 Restricted data flow</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Loss of control</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Cloud-originated commands or configuration to {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>I</a:Category><a:Description>Telemetry and operational data sent to {target.Name} could be exposed through cloud misconfiguration or vendor compromise.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.EI.OT.Cloud')</a:Include></a:GenerationFilters><a:Id>OT-I14</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Telemetry and operational data sent to {target.Name} could be exposed through cloud misconfiguration or vendor compromise.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Encrypt in transit and at rest. Minimise data sent. Define data ownership, retention and access in contracts. Assess the cloud provider (4-1 SM).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SR - Security requirements</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0882 Theft of Operational Information</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 4.1; 4-1 SM</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR4 Data confidentiality</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Confidentiality / IP</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Operational data exposed in vendor / cloud service {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>S</a:Category><a:Description>Spoofed NTP, PTP or GNSS time could corrupt timestamps on {target.Name}, break certificate validation or disturb sequence-of-events and protection functions.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>((source is 'SE.EI.OT.TimeSource') or flow is 'SE.DF.OT.TimeSync') and (target is 'GE.P')</a:Include></a:GenerationFilters><a:Id>OT-S09</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Spoofed NTP, PTP or GNSS time could corrupt timestamps on {target.Name}, break certificate validation or disturb sequence-of-events and protection functions.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Authenticate time sources (NTS, PTP security, multiple sources). Detect time jumps. Protect timestamp integrity (CR 2.11).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0849 Masquerading; T0830 Adversary-in-the-Middle</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 2.11; 3-3 SR 2.11</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR2 Use control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Forensics; Protection mis-operation</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Time source spoofing affecting {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>S</a:Category><a:Description>Mis-issued, unrevoked or self-signed certificates could let an attacker impersonate components; an unavailable PKI could stop authentication.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.PKI') and (target is 'GE.P')</a:Include></a:GenerationFilters><a:Id>OT-S10</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Mis-issued, unrevoked or self-signed certificates could let an attacker impersonate components; an unavailable PKI could stop authentication.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Validate certificate chains, revocation and validity (CR 1.8). Support asset-owner PKI and offline operation. Define certificate lifecycle in the security guidelines.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0849 Masquerading</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 1.8; 4-2 CR 1.9; 4-2 EDR 3.13</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR1 Identification and authentication control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Unauthorized access</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Certificate or PKI misuse affecting {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>T</a:Category><a:Description>Someone could manipulate sensors or the process physically (bypass a sensor, inject a signal), so {target.Name} acts on false inputs.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.PhysicalProcess')</a:Include></a:GenerationFilters><a:Id>OT-T26</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Someone could manipulate sensors or the process physically (bypass a sensor, inject a signal), so {target.Name} acts on false inputs.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Apply plausibility checks and redundancy for critical measurements (CR 3.5). Physically protect critical sensors. Use independent safety instrumentation.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T1692.002 Unauthorized Message: Reporting Message; T0831 Manipulation of Control</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 3.5; 4-2 CR 3.6</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR3 System integrity</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Safety; Product quality</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Physical inputs to {target.Name} manipulated at the process</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>E</a:Category><a:Description>A malicious or vulnerable app on {target.Name} could break out of its container or access other apps' data and OT interfaces.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.P.OT.EdgeApp')</a:Include></a:GenerationFilters><a:Id>OT-E19</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>A malicious or vulnerable app on {target.Name} could break out of its container or access other apps' data and OT interfaces.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Run apps with least privilege, no privileged containers, read-only filesystems and resource limits. Sign and vet apps. Partition applications (SR 5.4).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0890 Exploitation for Privilege Escalation</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>3-3 SR 5.4; 4-2 CR 2.1; 4-2 CR 7.2</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR5 Restricted data flow</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Full compromise</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Container escape or app isolation failure on {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>E</a:Category><a:Description>{target.Name} may translate unauthenticated legacy protocols (Modbus, OPC DA) into OPC UA or other networks, so attacks on the legacy side are passed through.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.P.OT.OPCServer')</a:Include></a:GenerationFilters><a:Id>OT-E20</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>{target.Name} may translate unauthenticated legacy protocols (Modbus, OPC DA) into OPC UA or other networks, so attacks on the legacy side are passed through.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Place the gateway at a zone boundary. Expose only required tags with read-only access by default. Validate values before forwarding. Authenticate clients on the secure side.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0884 Connection Proxy; T1692.001 Unauthorized Message: Command Message</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>3-3 SR 5.2; 4-2 CR 3.5; 4-2 CR 2.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR5 Restricted data flow</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Manipulation of control</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>{target.Name} bridges insecure legacy traffic into a secured network</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>S</a:Category><a:Description>Auto-accepting client certificates, security mode None or anonymous access on {target.Name} would let any client connect and read or write.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.P.OT.OPCServer')</a:Include></a:GenerationFilters><a:Id>OT-S11</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Auto-accepting client certificates, security mode None or anonymous access on {target.Name} would let any client connect and read or write.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Disable security mode None and anonymous access by default. Require explicit trust of client certificates. Map users to roles.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SG - Security guidelines</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0849 Masquerading; T0859 Valid Accounts</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 1.2; 4-2 CR 1.8; 4-2 CR 2.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR1 Identification and authentication control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Unauthorized access</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>OPC UA trust misconfiguration on {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>E</a:Category><a:Description>If the directory / identity service is compromised (or shared with IT), the attacker can create or use accounts on every connected OT component.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>((target is 'SE.P.OT.AuthService') or (source is 'SE.P.OT.AuthService'))</a:Include></a:GenerationFilters><a:Id>OT-E21</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>If the directory / identity service is compromised (or shared with IT), the attacker can create or use accounts on every connected OT component.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Use a dedicated OT identity domain separate from IT. Tier administrative accounts. Monitor privileged account changes.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0859 Valid Accounts; T0892 Change Credential</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 1.3; 4-2 CR 1.1; 3-3 SR 1.3</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR1 Identification and authentication control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Full compromise</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Compromise of identity service {target.Name} gives access to all OT assets</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>D</a:Category><a:Description>If the identity service is unreachable, operators may be locked out of {target.Name} during an incident or emergency.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.P.OT.AuthService')</a:Include></a:GenerationFilters><a:Id>OT-D12</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>If the identity service is unreachable, operators may be locked out of {target.Name} during an incident or emergency.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Support local fallback / emergency accounts with strong controls. Do not let security functions block essential functions (IEC 62443-4-2 essential functions).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0826 Loss of Availability; T0815 Denial of View</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 7.1 (essential functions); 4-2 CR 1.11</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR7 Resource availability</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Loss of view; Loss of control</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Identity service unavailable blocks operators on {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>R</a:Category><a:Description>Events may be dropped, delayed or blocked, so attacks against {source.Name} go undetected.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.P.OT.SecurityMonitor')</a:Include></a:GenerationFilters><a:Id>OT-R04</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Events may be dropped, delayed or blocked, so attacks against {source.Name} go undetected.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Support continuous monitoring (CR 6.2) and standard log export (syslog/CEF) (CR 6.1). Use reliable transport and alert on missing heartbeats.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SR - Security requirements</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0872 Indicator Removal on Host</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 6.1; 4-2 CR 6.2</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR6 Timely response to events</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Detection</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Security events from {source.Name} do not reach {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>D</a:Category><a:Description>Active discovery or vulnerability scanning of {target.Name} could crash or slow fragile embedded devices.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.P.OT.SecurityMonitor' or source is 'SE.P.OT.AssetMgmt') and (target is 'SE.P.OT.PLC' or target is 'SE.P.OT.SIS' or target is 'SE.P.OT.RTU' or target is 'SE.P.OT.IED' or target is 'SE.P.OT.SmartField' or target is 'SE.P.OT.IIoT' or target is 'SE.P.OT.SafetyIO')</a:Include></a:GenerationFilters><a:Id>OT-D13</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Active discovery or vulnerability scanning of {target.Name} could crash or slow fragile embedded devices.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Prefer passive monitoring for Level 0-2. Test and document safe active queries. Make {target.Name} robust to scanning traffic (CR 7.1).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SVV - Security verification and validation</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0814 Denial of Service</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 7.1; 4-2 CR 6.2</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR7 Resource availability</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Loss of availability</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Active scanning by {source.Name} disrupts {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>T</a:Category><a:Description>Device management platform {target.Name} can push configuration, firmware or certificates to many devices; if compromised, the whole fleet is affected.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(target is 'SE.P.OT.AssetMgmt')</a:Include></a:GenerationFilters><a:Id>OT-T27</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Device management platform {target.Name} can push configuration, firmware or certificates to many devices; if compromised, the whole fleet is affected.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Strong authentication and role separation for fleet operations. Staged roll-out with approval. Signed configuration packages. Audit all bulk operations.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T1693.002 Modify Firmware: Module Firmware; T0836 Modify Parameter</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 2.1; 4-2 CR 3.4; 4-2 CR 2.8</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR2 Use control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Fleet-wide compromise</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Mass configuration change through {target.Name}</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>R</a:Category><a:Description>Program downloads, online edits and parameter changes made on {target.Name} by {source.Name} may not be recorded with who made them, what changed and when. After an incident it cannot be shown whether a change was authorised, accidental or malicious.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.P.OT.EngTool' or source is 'SE.P.OT.EWSHost' or source is 'SE.EI.OT.Engineer' or source is 'SE.EI.OT.Integrator') and (target is 'SE.P.OT.PLC' or target is 'SE.P.OT.SIS' or target is 'SE.P.OT.RTU' or target is 'SE.P.OT.IED' or target is 'SE.P.OT.SmartField' or target is 'SE.P.OT.IIoT' or target is 'SE.P.OT.SafetyIO')</a:Include></a:GenerationFilters><a:Id>OT-R05</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Program downloads, online edits and parameter changes made on {target.Name} by {source.Name} may not be recorded with who made them, what changed and when. After an incident it cannot be shown whether a change was authorised, accidental or malicious.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Record every logic, configuration and firmware change with user identity, timestamp and a before/after hash or version (CR 2.8). Keep a change history on the device or engineering server. Support non-repudiation for critical changes at SL 3 and above (CR 2.12). Compare running logic with the approved baseline.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SR - Security requirements</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0889 Modify Program; T0843 Program Download; T0872 Indicator Removal on Host</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 2.12; 4-2 CR 2.8; 4-2 CR 3.4</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR2 Use control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Forensics; Compliance; Safety case</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Logic or configuration changes on {target.Name} cannot be proven or reconstructed</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>R</a:Category><a:Description>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot {target.Name} so evidence held in volatile memory is lost.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>((target is 'SE.P.OT.PLC' or target is 'SE.P.OT.SIS' or target is 'SE.P.OT.RTU' or target is 'SE.P.OT.IED' or target is 'SE.P.OT.SmartField' or target is 'SE.P.OT.IIoT' or target is 'SE.P.OT.SafetyIO' or target is 'SE.P.OT.Firewall' or target is 'SE.P.OT.Switch' or target is 'SE.P.OT.Router' or target is 'SE.P.OT.WirelessAP' or target is 'SE.P.OT.RemoteAccess' or target is 'SE.P.OT.DataDiode')) and ((flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') or (source is 'GE.EI'))</a:Include></a:GenerationFilters><a:Id>OT-R06</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Embedded and network devices often keep only a small local event buffer. An attacker could clear it, flood it until older events are overwritten, or reboot {target.Name} so evidence held in volatile memory is lost.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Protect audit records against deletion (CR 3.9) and keep them across restarts. Forward events in near real time to a central collector (CR 6.1, syslog over TLS). Warn when audit capacity is nearly used (CR 2.9). Record clearing of the log as an audit event itself.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0872 Indicator Removal on Host; T0816 Device Restart/Shutdown</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 3.9; 4-2 CR 2.9; 4-2 CR 6.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR3 System integrity</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Forensics; Detection</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Local audit trail on {target.Name} lost, overwritten or cleared</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>R</a:Category><a:Description>Commands, setpoint changes, alarm acknowledgements and shelving done by {source.Name} on {target.Name} may not be recorded with user, old and new value and time, so a disputed or harmful operation cannot be reconstructed.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(source is 'SE.EI.OT.Operator' or source is 'SE.EI.OT.Engineer' or source is 'SE.EI.OT.Admin' or source is 'SE.EI.OT.Vendor' or source is 'SE.EI.OT.Integrator') and (target is 'SE.P.OT.HMI' or target is 'SE.P.OT.SCADA')</a:Include></a:GenerationFilters><a:Id>OT-R07</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Commands, setpoint changes, alarm acknowledgements and shelving done by {source.Name} on {target.Name} may not be recorded with user, old and new value and time, so a disputed or harmful operation cannot be reconstructed.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Keep an operator action journal with user identity, old/new value, source station and synchronised time (CR 2.8, CR 2.11). Protect the journal from modification (CR 3.9). Make it available to incident response and the historian.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SR - Security requirements</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0872 Indicator Removal on Host; T1692.001 Unauthorized Message: Command Message</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 2.8; 4-2 CR 2.11; 4-2 CR 2.12; 4-2 CR 3.9</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR2 Use control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Forensics; Compliance</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Operator actions by {source.Name} on {target.Name} not journaled</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>D</a:Category><a:Description>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between {source.Name} and {target.Name} while the link still looks healthy, so a response to a process upset never arrives.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>((flow.CarriesControl is 'Yes') or (flow.CarriesSafety is 'Yes'))</a:Include></a:GenerationFilters><a:Id>OT-D14</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>An attacker on the path, or on a device in between, could selectively drop or delay commands, trips, alarms or status messages between {source.Name} and {target.Name} while the link still looks healthy, so a response to a process upset never arrives.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Use communication watchdogs, heartbeats and sequence counters so that missing or late messages are detected (CR 3.1, CR 7.1). Define the safe state on loss of communication (CR 3.6). Alarm on communication loss to the operator. Use redundant paths for essential functions and keep safety trips independent of the control network.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T1691.001 Block Operational Technology Message: Command Message; T1691.002 Block Operational Technology Message: Reporting Message; T1695.002 Block Communications: Ethernet; T1695.001 Block Communications: Serial COM; T0827 Loss of Control</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 7.1; 4-2 CR 3.6; 4-2 CR 3.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR7 Resource availability</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Loss of control; Safety; Damage to property</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Command, trip or alarm messages between {source.Name} and {target.Name} blocked</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>I</a:Category><a:Description>{target.Name} answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>((target is 'SE.P.OT.PLC' or target is 'SE.P.OT.SIS' or target is 'SE.P.OT.RTU' or target is 'SE.P.OT.IED' or target is 'SE.P.OT.SmartField' or target is 'SE.P.OT.IIoT' or target is 'SE.P.OT.SafetyIO') and (flow.ProtocolSecurity is 'Unknown' or flow.ProtocolSecurity is 'None')) and ((flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') or (source is 'GE.EI'))</a:Include></a:GenerationFilters><a:Id>OT-I15</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>{target.Name} answers read requests over an unauthenticated protocol, so any host that can reach it could poll tags, I/O image and operating state to learn how the process works before an attack.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Require authentication and authorisation for read services as well as writes where the protocol allows (CR 2.1). Allow-list client addresses. Expose only required tags. Detect unexpected polling clients at the conduit or with network monitoring (CR 6.2).</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0801 Monitor Process State; T0877 I/O Image; T0861 Point &amp; Tag Identification; T0802 Automated Collection</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 2.1; 4-2 CR 4.1; 4-2 CR 6.2</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR2 Use control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Attack enablement; Confidentiality / IP</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Process state and I/O image read from {target.Name} by an unauthorised client</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>E</a:Category><a:Description>{target.Name} has network access to controllers. An attacker who gets code onto it (drive-by download, script, phishing, lateral transfer from another host) could use built-in tools, scripts or API hooking to scan, move laterally and send commands as a trusted host.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>((target is 'SE.P.OT.EWSHost' or target is 'SE.P.OT.EngTool' or target is 'SE.P.OT.SCADA' or target is 'SE.P.OT.Server' or target is 'SE.P.OT.IPC' or target is 'SE.P.OT.HMI')) and ((flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') or (source is 'GE.EI'))</a:Include></a:GenerationFilters><a:Id>OT-E22</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>{target.Name} has network access to controllers. An attacker who gets code onto it (drive-by download, script, phishing, lateral transfer from another host) could use built-in tools, scripts or API hooking to scan, move laterally and send commands as a trusted host.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Use application allow-listing and block script interpreters that are not needed (HDR 3.2, SAR 2.4). Do not allow web browsing or e-mail on OT hosts (CR 5.3 person-to-person communication). Restrict outbound and lateral connections from the host. Monitor for new executables and tools.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SG - Security guidelines</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0867 Lateral Tool Transfer; T0817 Drive-by Compromise; T0874 Hooking; T1701.001 Command and Scripting Interpreter: PowerShell; T0852 Screen Capture; T0840 Network Connection Enumeration</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 HDR 3.2; 4-2 SAR 2.4; 4-2 CR 7.7; 4-2 CR 5.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR3 System integrity</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Full compromise; Loss of control</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Attacker tools staged on {target.Name} to reach the control network</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>T</a:Category><a:Description>On publish/subscribe channels (MQTT, cloud messaging) any client the broker accepts may publish to or subscribe to topics. A rogue client could inject false values or commands for {target.Name}, or read all telemetry.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(flow is 'SE.DF.OT.MQTT' or (flow.Medium is 'Cellular' or flow.Medium is 'Internet or WAN'))</a:Include></a:GenerationFilters><a:Id>OT-T29</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>On publish/subscribe channels (MQTT, cloud messaging) any client the broker accepts may publish to or subscribe to topics. A rogue client could inject false values or commands for {target.Name}, or read all telemetry.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Require client authentication (certificates) on the broker and per-topic access control lists (CR 1.2, CR 2.1). Use TLS. Sign or validate payloads that carry commands. Disable wildcard subscriptions for untrusted clients.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SD - Secure by design</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0869.002 Standard Application Layer Protocol: Publish/Subscribe Protocols; T1692.001 Unauthorized Message: Command Message; T1692.002 Unauthorized Message: Reporting Message</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 1.2; 4-2 CR 2.1; 4-2 CR 3.1</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR1 Identification and authentication control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Manipulation of control; Manipulation of view</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Rogue publisher or subscriber on the {source.Name} to {target.Name} messaging channel</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>T</a:Category><a:Description>A compromised developer account, source repository, build server or dependency could insert a backdoor into {target.Name} before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>((target is 'SE.P.OT.PLC' or target is 'SE.P.OT.SIS' or target is 'SE.P.OT.RTU' or target is 'SE.P.OT.IED' or target is 'SE.P.OT.SmartField' or target is 'SE.P.OT.IIoT' or target is 'SE.P.OT.SafetyIO' or target is 'SE.P.OT.IPC' or target is 'SE.P.OT.Server' or target is 'SE.P.OT.EWSHost' or target is 'SE.P.OT.Firewall' or target is 'SE.P.OT.Switch' or target is 'SE.P.OT.Router' or target is 'SE.P.OT.WirelessAP' or target is 'SE.P.OT.RemoteAccess' or target is 'SE.P.OT.DataDiode' or target is 'SE.P.OT.HMI' or target is 'SE.P.OT.SCADA' or target is 'SE.P.OT.EngTool' or target is 'SE.P.OT.HistorianApp' or target is 'SE.P.OT.OPCServer' or target is 'SE.P.OT.WebServer' or target is 'SE.P.OT.EdgeApp' or target is 'SE.P.OT.UpdateService' or target is 'SE.P.OT.AuthService' or target is 'SE.P.OT.SecurityMonitor' or target is 'SE.P.OT.BackupService' or target is 'SE.P.OT.AssetMgmt')) and ((flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') or (source is 'GE.EI'))</a:Include></a:GenerationFilters><a:Id>OT-T28</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>A compromised developer account, source repository, build server or dependency could insert a backdoor into {target.Name} before it is signed and released, so every shipped unit carries it (e.g. SolarWinds-type attacks).</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Protect the development environment and build pipeline (4-1 SM-7, SM-8): access control and MFA for repositories, protected branches, reviewed changes, reproducible builds and an isolated build server. Scan dependencies and keep an SBOM. Sign release artefacts only from the controlled pipeline.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SM - Security management and supply chain</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0862 Supply Chain Compromise</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 3.4; 4-1 SM-7; 4-1 SM-8; 4-1 SI</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR3 System integrity</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Fleet-wide compromise</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Malicious code inserted into {target.Name} during development or build</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>S</a:Category><a:Description>If the supplier's firmware or software signing key is stolen, or the signing service can be used by an unauthorised person, malicious images would pass every signature check on the devices that {target.Name} serves.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(((target is 'SE.P.OT.UpdateService' or target is 'SE.DS.OT.Firmware') or (source is 'SE.P.OT.UpdateService' or source is 'SE.DS.OT.Firmware')) or (target is 'SE.P.OT.AssetMgmt'))</a:Include></a:GenerationFilters><a:Id>OT-S12</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>If the supplier's firmware or software signing key is stolen, or the signing service can be used by an unauthorised person, malicious images would pass every signature check on the devices that {target.Name} serves.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>High</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Keep signing keys in an HSM with dual control and logging (4-1 SM-8). Use separate keys for test and production. Plan key revocation and rotation, and let devices accept a new trust anchor securely (CR 1.9, EDR 3.10). Monitor signing activity.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SM - Security management and supply chain</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0862 Supply Chain Compromise; T1693.001 Modify Firmware: System Firmware</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 1.9; 4-2 CR 3.4; 4-2 EDR 3.10; 4-1 SM-8</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR1 Identification and authentication control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 2</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Fleet-wide compromise</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Code-signing key for software delivered via {target.Name} stolen or misused</a:ShortTitle></a:ThreatType><a:ThreatType><a:IsExtension>false</a:IsExtension><a:Category>S</a:Category><a:Description>Accounts of former staff, contractors, commissioning engineers or test users may remain active on {target.Name} and can be used by an attacker who obtains their credentials.</a:Description><a:GenerationFilters><a:Exclude>flow.GenerateThreats is 'No'</a:Exclude><a:Include>(((target is 'SE.P.OT.IPC' or target is 'SE.P.OT.Server' or target is 'SE.P.OT.EWSHost' or target is 'SE.P.OT.HMI' or target is 'SE.P.OT.SCADA' or target is 'SE.P.OT.EngTool' or target is 'SE.P.OT.HistorianApp' or target is 'SE.P.OT.OPCServer' or target is 'SE.P.OT.WebServer' or target is 'SE.P.OT.EdgeApp' or target is 'SE.P.OT.UpdateService' or target is 'SE.P.OT.AuthService' or target is 'SE.P.OT.SecurityMonitor' or target is 'SE.P.OT.BackupService' or target is 'SE.P.OT.AssetMgmt') and (target is 'GE.P' and (target.UserAccounts is 'Unknown' or target.UserAccounts is 'Yes')) or (target is 'SE.P.OT.AuthService'))) and ((flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') or (source is 'GE.EI'))</a:Include></a:GenerationFilters><a:Id>OT-S13</a:Id><a:PropertiesMetaData><ThreatMetaDatum><Name>UserThreatShortDescription</Name><Label>Short Description</Label><HideFromUI>true</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</b:string></Values><Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id></ThreatMetaDatum><ThreatMetaDatum><Name>UserThreatDescription</Name><Label>Description</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Accounts of former staff, contractors, commissioning engineers or test users may remain active on {target.Name} and can be used by an attacker who obtains their credentials.</b:string></Values><Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id></ThreatMetaDatum><ThreatMetaDatum><Name>Priority</Name><Label>Priority</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Medium</b:string></Values><Id>849869b2-a4f9-5106-8367-c47a51895cca</Id></ThreatMetaDatum><ThreatMetaDatum><Name>PossibleMitigations</Name><Label>Possible Mitigation(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Support account management functions: create, modify, disable and remove accounts, with expiry dates (CR 1.3, CR 1.4). Report inactive accounts. Integrate with central identity management so leavers are removed everywhere. Remove test and commissioning accounts before handover.</b:string></Values><Id>PossibleMitigations</Id></ThreatMetaDatum><ThreatMetaDatum><Name>SDLPhase</Name><Label>IEC 62443-4-1 Practice</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SG - Security guidelines</b:string></Values><Id>SDLPhase</Id></ThreatMetaDatum><ThreatMetaDatum><Name>ATTACKICS</Name><Label>MITRE ATTACK for ICS v20</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>T0859 Valid Accounts; T1694.001 Insecure Credentials: Default Credentials</b:string></Values><Id>ATTACKICS</Id></ThreatMetaDatum><ThreatMetaDatum><Name>IEC62443Req</Name><Label>IEC 62443 Requirement(s)</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>4-2 CR 1.4; 4-2 CR 1.3; 4-2 CR 1.5</b:string></Values><Id>IEC62443Req</Id></ThreatMetaDatum><ThreatMetaDatum><Name>FoundationalReq</Name><Label>IEC 62443 Foundational Requirement</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>FR1 Identification and authentication control</b:string></Values><Id>FoundationalReq</Id></ThreatMetaDatum><ThreatMetaDatum><Name>MinSL</Name><Label>Relevant from SL</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>SL 1</b:string></Values><Id>MinSL</Id></ThreatMetaDatum><ThreatMetaDatum><Name>OTImpact</Name><Label>OT Consequence</Label><HideFromUI>false</HideFromUI><Values xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><b:string>Unauthorized access</b:string></Values><Id>OTImpact</Id></ThreatMetaDatum></a:PropertiesMetaData><a:RelatedCategory i:nil="true"/><a:ShortTitle>Dormant, orphaned or unrevoked accounts on {target.Name}</a:ShortTitle></a:ThreatType></a:ThreatTypes></KnowledgeBase><Profile><PromptedKb xmlns=""/></Profile></ThreatModel>