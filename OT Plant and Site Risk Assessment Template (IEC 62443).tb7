  <ThreatCategories>
    <ThreatCategory>
      <Name>Spoofing</Name>
      <Id>S</Id>
      <ShortDescription>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Tampering</Name>
      <Id>T</Id>
      <ShortDescription>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Repudiation</Name>
      <Id>R</Id>
      <ShortDescription>Repudiation: actions on the control system cannot be traced to a user or device because audit records are missing, shared accounts are used or logs are altered.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Information Disclosure</Name>
      <Id>I</Id>
      <ShortDescription>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Denial Of Service</Name>
      <Id>D</Id>
      <ShortDescription>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Elevation Of Privilege</Name>
      <Id>E</Id>
      <ShortDescription>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
    <ThreatCategory>
      <Name>Abuse</Name>
      <Id>A</Id>
      <ShortDescription>Abuse is when a legitimate user violates the terms of use for the system without violating a system security policy.</ShortDescription>
      <LongDescription />
    </ThreatCategory>
  </ThreatCategories>
  <ThreatTypes>
    <ThreatType>
      <GenerationFilters>
        <Include>(flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') and (flow.ThroughConduitDevice is 'Unknown' or flow.ThroughConduitDevice is 'No')</Include>
        <Exclude>(((source is 'SE.EI.OT.Operator' or source is 'SE.EI.OT.PhysicalProcess') or (flow.Medium is 'Removable media or file transfer')) or flow.GenerateThreats is 'No')</Exclude>
      </GenerationFilters>
      <Id>PL-E01</Id>
      <ShortTitle>{source.Name} to {target.Name} crosses a zone boundary without a conduit device</ShortTitle>
      <Category>E</Category>
      <Description>The flow from {source.Name} to {target.Name} crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>The flow from {source.Name} to {target.Name} crosses a zone boundary but is not filtered by a firewall or conduit device, so the zones are not really separated and an attacker in one zone can reach the other freely.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Route every inter-zone flow through a conduit device (firewall, data diode, DPI gateway) with deny-by-default rules that allow only this documented flow. Record the conduit in the zone and conduit drawing.</Value>
          </Values>
          <Description>Typical asset-owner countermeasures for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T0886 Remote Services; T0866 Exploitation of Remote Services</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>IEC62443Req</Name>
          <Label>IEC 62443 and IEC 61511 Reference(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>3-3 SR 5.1; 3-3 SR 5.2; 3-2 ZCR 3; 2-1 NET 1</Value>
          </Values>
          <Description>IEC 62443-3-3 SR, 2-1 programme element, 2-4 SP capability, 3-2 ZCR and IEC 61511 references.</Description>
          <Id>IEC62443Req</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>FoundationalReq</Name>
          <Label>IEC 62443 Foundational Requirement</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>FR5 Restricted data flow</Value>
          </Values>
          <Description>IEC 62443 foundational requirement (FR1-FR7).</Description>
          <Id>FoundationalReq</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>MinSL</Name>
          <Label>Relevant from SL</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SL 1</Value>
          </Values>
          <Description>Lowest zone SL-T at which countermeasures for this threat are normally required.</Description>
          <Id>MinSL</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>OTImpact</Name>
          <Label>OT Consequence</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Loss of segmentation; Attack spread</Value>
          </Values>
          <Description>Potential consequence for the plant.</Description>
          <Id>OTImpact</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
      </PropertiesMetaData>
    </ThreatType>
    <ThreatType>
      <GenerationFilters>
        <Include>(flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') and (flow.ProtocolSecurity is 'Unknown' or flow.ProtocolSecurity is 'None') and (flow.CarriesControl is 'Unknown' or flow.CarriesControl is 'Yes')</Include>
        <Exclude>(((source is 'SE.EI.OT.Operator' or source is 'SE.EI.OT.PhysicalProcess') or (flow.Medium is 'Removable media or file transfer')) or flow.GenerateThreats is 'No')</Exclude>
      </GenerationFilters>
      <Id>PL-T01</Id>
      <ShortTitle>Unauthenticated control traffic from {source.Name} to {target.Name} crosses zones</ShortTitle>
      <Category>T</Category>
      <Description>Commands or setpoints sent to {target.Name} use a protocol without authentication across a zone boundary. Anyone who gets a foothold on the path or in the source zone can send valid-looking commands.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Commands or setpoints sent to {target.Name} use a protocol without authentication across a zone boundary. Anyone who gets a foothold on the path or in the source zone can send valid-looking commands.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Allow only the specific function codes or services needed at the conduit (protocol-aware firewall). Restrict which hosts may send writes. Use secure protocol variants where the installed equipment supports them. Monitor for writes from unexpected hosts.</Value>
          </Values>
          <Description>Typical asset-owner countermeasures for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T1692.001 Unauthorized Message: Command Message; T0831 Manipulation of Control</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>IEC62443Req</Name>
          <Label>IEC 62443 and IEC 61511 Reference(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>3-3 SR 3.1; 3-3 SR 5.2; 2-1 NET 1</Value>
          </Values>
          <Description>IEC 62443-3-3 SR, 2-1 programme element, 2-4 SP capability, 3-2 ZCR and IEC 61511 references.</Description>
          <Id>IEC62443Req</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>FoundationalReq</Name>
          <Label>IEC 62443 Foundational Requirement</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>FR3 System integrity</Value>
          </Values>
          <Description>IEC 62443 foundational requirement (FR1-FR7).</Description>
          <Id>FoundationalReq</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>MinSL</Name>
          <Label>Relevant from SL</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>SL 2</Value>
          </Values>
          <Description>Lowest zone SL-T at which countermeasures for this threat are normally required.</Description>
          <Id>MinSL</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>OTImpact</Name>
          <Label>OT Consequence</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Manipulation of control; Safety; Production loss</Value>
          </Values>
          <Description>Potential consequence for the plant.</Description>
          <Id>OTImpact</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
      </PropertiesMetaData>
    </ThreatType>
    <ThreatType>
      <GenerationFilters>
        <Include>(flow crosses 'GE.TB.L' or flow crosses 'GE.TB.B') and (flow.ProtocolSecurity is 'Unknown' or flow.ProtocolSecurity is 'None' or flow.ProtocolSecurity is 'Integrity only')</Include>
        <Exclude>((flow.providesConfidentiality is 'Yes' or (source is 'SE.EI.OT.Operator' or source is 'SE.EI.OT.PhysicalProcess') or (flow.Medium is 'Removable media or file transfer')) or flow.GenerateThreats is 'No')</Exclude>
      </GenerationFilters>
      <Id>PL-I01</Id>
      <ShortTitle>Plant data between {source.Name} and {target.Name} readable in transit</ShortTitle>
      <Category>I</Category>
      <Description>Traffic between {source.Name} and {target.Name} is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Information disclosure: process data, engineering projects, credentials, keys or IP are read by an unauthorised party.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Traffic between {source.Name} and {target.Name} is not encrypted where it leaves the zone. Process data, tag names or credentials can be captured and used to plan an attack.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Medium</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Encrypt flows leaving the zone where confidentiality matters (TLS, IPsec tunnel between sites). Never send passwords in cleartext. Classify plant data to decide where encryption is needed.</Value>
          </Values>
          <Description>Typical asset-owner countermeasures for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>T0842 Network Sniffing; T0882 Theft of Operational Information</Value>
          </Values>
          <Description>Related MITRE ATT&amp;CK for ICS technique(s), v20 IDs.</Description>
          <Id>ATTACKICS</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>IEC62443Req</Name>
          <Label>IEC 62443 and IEC 61511 Reference(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>3-3 SR 4.1; 2-1 DATA 1</Value>
          </Values>
          <Description>IEC 62443-3-3 SR, 2-1 programme element, 2-4 SP capability, 3-2 ZCR and IEC 61511 references.</Description>
          <Id>IEC62443Req</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>FoundationalReq</Name>
