      <Id>PL-S01</Id>
      <ShortTitle>Rogue device on the wireless network used by {target.Name}</ShortTitle>
      <Category>S</Category>
      <Description>Plant wireless networks can be reached from outside the fence. A rogue access point or a device with a stolen key can join the network used by {target.Name}.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
