      <Id>PL-T06</Id>
      <ShortTitle>Unauthorised or unmanaged change to logic or configuration of {target.Name}</ShortTitle>
      <Category>T</Category>
      <Description>Changes to logic, setpoints or configuration of {target.Name} are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Changes to logic, setpoints or configuration of {target.Name} are not controlled by management of change. A malicious or careless change would not be noticed until the process misbehaves.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
