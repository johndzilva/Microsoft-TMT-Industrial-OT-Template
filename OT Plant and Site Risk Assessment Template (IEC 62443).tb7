      <Id>PL-E06</Id>
      <ShortTitle>Known vulnerabilities on {target.Name} not patched</ShortTitle>
      <Category>E</Category>
      <Description>Security patches for {target.Name} are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Security patches for {target.Name} are not installed or their status is unknown, so publicly known vulnerabilities can be exploited.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Keep a patch status register for every asset (COMP 3). Qualify and install vendor-approved patches in planned outages. Where patching must wait, document compensating controls such as stricter filtering at the conduit.</Value>
          </Values>
          <Description>Typical asset-owner countermeasures for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>ATTACKICS</Name>
          <Label>MITRE ATTACK for ICS v20</Label>
