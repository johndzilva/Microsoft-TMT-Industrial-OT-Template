      <Id>PL-E09</Id>
      <ShortTitle>Security capability of {target.Name} is below the zone target</ShortTitle>
      <Category>E</Category>
      <Description>The capability security level (SL-C) of {target.Name} is lower than the target security level (SL-T) of its zone, or has not been checked. The zone cannot reach its target without extra measures.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
