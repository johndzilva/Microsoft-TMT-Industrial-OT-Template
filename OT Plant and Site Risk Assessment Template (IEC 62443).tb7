      <Id>PL-T10</Id>
      <ShortTitle>Physical access to {target.Name} at an unattended or open location</ShortTitle>
      <Category>T</Category>
      <Description>Someone with physical access to {target.Name} (remote station, field cabinet, open plant area) can connect a laptop, insert media, reset the device or tamper with wiring.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
