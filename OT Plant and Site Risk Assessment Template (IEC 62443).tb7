      <Id>PL-S04</Id>
      <ShortTitle>Leavers' and contractors' accounts still active on {target.Name}</ShortTitle>
      <Category>S</Category>
      <Description>Accounts of staff who left, former contractors or commissioning engineers often stay active on {target.Name} for years and can be misused.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
