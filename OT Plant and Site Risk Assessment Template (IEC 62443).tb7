      <Id>PL-E13</Id>
      <ShortTitle>Compromise of cloud or vendor service {source.Name} affects {target.Name}</ShortTitle>
      <Category>E</Category>
      <Description>The plant depends on {source.Name}. If that service is compromised, it may push commands or configuration into the plant or leak plant data.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Elevation of privilege: an attacker gains capabilities beyond those authorised, including crossing zones and conduits or bypassing safety functions.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>The plant depends on {source.Name}. If that service is compromised, it may push commands or configuration into the plant or leak plant data.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Medium</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Keep cloud connections outbound-only and read-only where possible. Require local approval for any write from the cloud. Include the provider in supplier risk assessment and contracts.</Value>
          </Values>
          <Description>Typical asset-owner countermeasures for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
