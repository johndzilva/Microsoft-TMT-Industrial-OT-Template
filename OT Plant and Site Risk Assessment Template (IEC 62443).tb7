      <ShortTitle>Ransomware spreads to {target.Name} and stops operations</ShortTitle>
      <Category>D</Category>
      <Description>Ransomware entering the plant can spread across Windows hosts through shared accounts, file shares and remote services, encrypting {target.Name} and forcing a shutdown.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Denial of service: loss of availability, loss of view or loss of control of the process or of a security function.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Ransomware entering the plant can spread across Windows hosts through shared accounts, file shares and remote services, encrypting {target.Name} and forcing a shutdown.</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Limit lateral movement: host firewalls, no shared admin accounts, separate OT domain. Keep offline backups. Prepare and exercise a plan to run the process without the affected hosts.</Value>
          </Values>
          <Description>Typical asset-owner countermeasures for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
