      <Id>PL-R01</Id>
      <ShortTitle>Attacks on {target.Name} would not be detected</ShortTitle>
      <Category>R</Category>
      <Description>Security events from {target.Name} are not collected or reviewed, and its network traffic is not monitored. An intrusion could continue for months before anyone notices.</Description>
      <PropertiesMetaData>
