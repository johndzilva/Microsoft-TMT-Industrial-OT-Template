      <Id>PL-S03</Id>
      <ShortTitle>Default, shared or generic accounts in use on {target.Name}</ShortTitle>
      <Category>S</Category>
      <Description>Logins on {target.Name} use default, shared or generic accounts. Passwords are widely known, rarely changed and cannot be tied to a person.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
