        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Carry out the SIS security risk assessment required by IEC 61511-1 8.2.4. Keep the SIS in its own zone. Use the key switch in Run, and control bypasses and maintenance overrides with procedures and alarms.</Value>
          </Values>
          <Description>Typical asset-owner countermeasures for this threat.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
