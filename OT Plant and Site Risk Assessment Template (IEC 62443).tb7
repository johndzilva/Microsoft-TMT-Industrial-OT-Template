      <Id>PL-S02</Id>
      <ShortTitle>Stolen or reused credentials used for remote access by {source.Name}</ShortTitle>
      <Category>S</Category>
      <Description>Remote access accounts are a favourite target. Phished, reused or leaked credentials let an attacker log in as {source.Name} from anywhere.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Spoofing: an attacker or rogue device pretends to be a legitimate user, controller, field device or server (e.g. rogue master, masquerading, stolen credentials).</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
