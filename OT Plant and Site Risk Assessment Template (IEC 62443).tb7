      <Id>PL-E05</Id>
      <ShortTitle>Always-on or unsupervised access by {source.Name}</ShortTitle>
      <Category>E</Category>
      <Description>{source.Name} can connect whenever it wants, without approval or supervision. A compromise of the vendor or integrator becomes a compromise of the plant.</Description>
      <PropertiesMetaData>
