      <Id>PL-T07</Id>
      <ShortTitle>Safety function {target.Name} disabled or altered by a cyber attack</ShortTitle>
      <Category>T</Category>
      <Description>A cyber attack on the safety system {target.Name} could disable trips or change trip points, so a hazardous event is no longer prevented (TRITON).</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>A cyber attack on the safety system {target.Name} could disable trips or change trip points, so a hazardous event is no longer prevented (TRITON).</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
