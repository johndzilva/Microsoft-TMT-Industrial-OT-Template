      <Id>PL-T09</Id>
      <ShortTitle>Malware brought to {target.Name} on USB media or a visiting laptop</ShortTitle>
      <Category>T</Category>
      <Description>USB drives, contractor laptops and other transient devices connected to {target.Name} are a common way malware reaches air-gapped or isolated plant networks (Stuxnet).</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value>Tampering: unauthorised modification of logic, firmware, setpoints, process values, configuration or messages in transit.</Value>
          </Values>
          <Id>8b1091e7-d25d-5920-b4cb-744fda3aa003</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>USB drives, contractor laptops and other transient devices connected to {target.Name} are a common way malware reaches air-gapped or isolated plant networks (Stuxnet).</Value>
          </Values>
          <Id>a8bfac8b-0ece-5a66-b0ff-fe6f9547b7b1</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Priority</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>849869b2-a4f9-5106-8367-c47a51895cca</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Recommended Countermeasure(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Control portable media and transient devices (COMP 1): scan at a kiosk before use, use company-owned media only, block unknown USB devices, and keep a register of transient devices and their owners.</Value>
          </Values>
